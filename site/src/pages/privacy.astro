---
import { href } from "../lib/base.ts";
import Base from "../layouts/Base.astro";
import { GTM_ID } from "../lib/analytics.ts";
import { LINKS, SITE_NAME } from "../lib/site.ts";

const updated = "11 November 2026";
---

<Base
  title="Privacy policy"
  description="What the MBMap registry website collects, the cookies it sets only with your consent, and how to change your choice."
>
  <div class="about">
    <section class="card pad prose">
      <h1>Privacy policy</h1>
      <p class="lead">Last updated {updated}.</p>

      <h2>Who is responsible</h2>
      <p>
        {SITE_NAME} Registry is run by <a href="https://nobrega.me">Afonso Nóbrega</a>. To ask anything about your data,
        open an issue on <a href={LINKS.issues}>GitHub</a>.
      </p>

      <h2>What the site collects</h2>
      <p>
        The site is static: there are no accounts, forms or comments, and the maps and search index are plain files. The
        host (GitHub Pages) keeps ordinary server logs, such as IP address and requested page, under
        <a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement">GitHub's privacy statement</a>.
      </p>

      <h2>Analytics and cookies</h2>
      {GTM_ID ? (
        <>
          <p>
            With your consent, the site uses Google Analytics 4, loaded through Google Tag Manager (Google Ireland Limited), to count visits and see which pages
            and maps are used. It sets the cookies <code>_ga</code> and <code>_ga_*</code> (up to two years) and sends the page
            viewed, the referrer, approximate location from a truncated IP address, and browser and device type to Google.
            Advertising features, ad personalisation and Google signals are switched off.
          </p>
          <p>
            Nothing from Google is loaded, and no analytics cookie is set, until you press <strong>Accept</strong> on the
            cookie banner. <strong>Reject</strong> keeps the site fully working without them. Your choice is stored in your
            browser (<code>localStorage</code>, key <code>consent</code>) along with the theme you pick.
          </p>
          <p>
            You can change your mind at any time with <button class="linkbtn" type="button" data-consent-open>Cookie settings</button>,
            here or in the footer. Rejecting deletes the analytics cookies on this site.
          </p>
          <p>
            The legal basis is your consent (GDPR art. 6(1)(a) and the ePrivacy rules). Google may process data outside the EU
            under its standard contractual clauses; see <a href="https://policies.google.com/technologies/partner-sites">how Google uses data</a>.
          </p>
        </>
      ) : (
        <p>This version of the site has no analytics and sets no cookies. Only your theme choice is kept in your browser.</p>
      )}

      <h2>Your rights</h2>
      <p>
        You can ask for access to, correction or deletion of data about you, object to its processing or withdraw consent,
        and complain to your data protection authority (in Portugal, the CNPD). Analytics data is not tied to a name or email, so
        in practice withdrawing consent and clearing your cookies is the way to stop it.
      </p>

      <h2>Changes</h2>
      <p>Changes to this policy are published on this page with a new date. See also the <a href={href("/terms")}>terms of use</a>.</p>
    </section>
  </div>
</Base>
