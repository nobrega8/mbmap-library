---
import { href } from "../../../lib/base.ts";
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import Icon from "../../../components/Icon.astro";
import StatusBadge from "../../../components/StatusBadge.astro";
import VendorTile from "../../../components/VendorTile.astro";
import { type Device, otherModels as others, rawUrl, registry } from "../../../lib/registry.ts";
import { REGISTER_COLUMNS, REGISTER_PAGE, registerRow } from "../../../lib/register-row.ts";
import {
  AREAS,
  AREA_NAME,
  AREA_TAG,
  PARITY_NAME,
  PROTOCOL_NAME,
  STATUS_INFO,
  orderTag,
  plural,
} from "../../../lib/mbmap.ts";
import { LINKS, SITE_NAME, deviceLinks } from "../../../lib/site.ts";

export const getStaticPaths = (() =>
  registry().devices.map((d) => ({
    params: { vendor: d.vendorSlug, model: d.modelSlug },
    props: { device: d },
  }))) satisfies GetStaticPaths;

const { device: d } = Astro.props as { device: Device };
const info = d.info;
const name = `${info.vendor} ${info.model}`;
const links = deviceLinks(d);
const fileName = d.path.split("/").pop()!;
const fileUrl = href(`/${d.path}`);
const said = (k: string) => info.stated.includes(k);
const otherModels = others(d);
const areas = AREAS.filter((a) => d.areaCounts[a]);
const hasTcp = info.protocol.includes("tcp");
const hasRtu = info.protocol.includes("rtu");
const firstRows = info.registers.slice(0, REGISTER_PAGE).map((r) => registerRow(r)).join("");
const pages = Math.ceil(info.registers.length / REGISTER_PAGE);
const kb = (n: number) => (n < 1024 * 1024 ? `${Math.round(n / 1024)} KB` : `${(n / 1024 / 1024).toFixed(1)} MB`);

const areaSummary = areas.map((a) => `${d.areaCounts[a]} ${AREA_NAME[a].toLowerCase()}s`).join(", ");
const description =
  `Explore the ${name} Modbus register map: ${plural(d.registerCount, "register")}` +
  (areaSummary ? ` (${areaSummary})` : "") +
  `, with addresses, data types, scaling and communication settings. Download the MBMap JSON file.`;

const pageUrl = new URL(d.url, Astro.site).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: `${name} Modbus register map`,
    description: info.description ? `${info.description}. ${description}` : description,
    url: pageUrl,
    identifier: d.path,
    keywords: ["Modbus", "register map", info.vendor, ...info.models, "mbmap"],
    license: "https://creativecommons.org/publicdomain/zero/1.0/",
    isAccessibleForFree: true,
    ...(info.revision ? { version: String(info.revision) } : {}),
    ...(info.revised ? { dateModified: info.revised } : {}),
    ...(d.added ? { datePublished: d.added } : {}),
    about: { "@type": "Product", name, brand: { "@type": "Brand", name: info.vendor } },
    includedInDataCatalog: { "@type": "DataCatalog", name: `${SITE_NAME} Registry`, url: Astro.site?.href },
    distribution: [
      {
        "@type": "DataDownload",
        encodingFormat: "application/json",
        contentUrl: new URL(fileUrl, Astro.site).href,
        contentSize: `${d.size} B`,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Devices", item: new URL(href("/devices"), Astro.site).href },
      { "@type": "ListItem", position: 2, name: info.vendor, item: new URL(href(`/manufacturers/${d.vendorSlug}`), Astro.site).href },
      { "@type": "ListItem", position: 3, name: info.model, item: pageUrl },
    ],
  },
];

const statusNote = d.status ? STATUS_INFO[d.status].long : "This map does not say whether it was tested or where it comes from.";
const groups = [...d.groups].sort((a, b) => a.localeCompare(b, "en", { numeric: true }));
const accessCounts = { R: 0, W: 0, RW: 0 };
for (const r of info.registers) accessCounts[r.access]++;
---

<Base title={`${name} Modbus Register Map`} description={description} nav="devices" jsonLd={jsonLd} ogType="article">
  <ol class="crumbs">
    <li><a href={href("/devices")}>Devices</a></li>
    <li><a href={href(`/manufacturers/${d.vendorSlug}`)}>{info.vendor}</a></li>
    <li aria-current="page">{info.model}</li>
  </ol>

  <article class="stack">
    <header class="card pad dev-head">
      <div class="dev-title">
        <VendorTile name={info.vendor} slug={d.vendorSlug} large />
        <div class="dev-name">
          <h1>
            <a class="vendor-link" href={href(`/manufacturers/${d.vendorSlug}`)}>{info.vendor}</a>
            {info.model}
            <span class="h1-sub">Modbus register map</span>
          </h1>
          {otherModels.length > 0 && <p class="faint covers">Also covers {otherModels.join(", ")}</p>}
        </div>
      </div>
      {info.description && <p class="dev-desc">{info.description}</p>}
      <ul class="chips" aria-label="Summary">
        <li><StatusBadge status={d.status} /></li>
        <li><span class="mono">{d.registerCount.toLocaleString("en-US")}</span> registers</li>
        {said("protocol") && <li>{PROTOCOL_NAME[info.protocol]}</li>}
        {info.revision && <li>Revision <span class="mono">{info.revision}</span>{info.revised && <span class="faint"> · {info.revised}</span>}</li>}
      </ul>
      <div class={`note ${d.status ?? "unofficial"}`}>
        <Icon name={d.status === "verified" ? "verified" : "warning"} size={15} />
        <p>
          <strong>{d.status ? STATUS_INFO[d.status].label : "No status"}:</strong>
          {statusNote}
          {d.status !== "verified" && " Check the map against the manufacturer's documentation before you write to a live device."}
          {d.status !== "verified" && <> Tested it? <a href={links.testReport}>Report a test</a>.</>}
        </p>
      </div>
      <div class="actions">
        <a class="btn primary big" href={fileUrl} download={fileName}>
          <Icon name="download" /> Download .mbmap.json
        </a>
        <a class="btn big" href="#raw" data-tab-link="raw"><Icon name="raw" /> Raw JSON</a>
        <a class="btn big" href={links.source}><Icon name="github" /> View on GitHub</a>
        <a class="btn big" href={links.edit} title="Edit the file on GitHub and open a pull request"><Icon name="edit" /> Suggest a correction</a>
        <a class="btn big" href={links.problem}><Icon name="issue" /> Report a problem</a>
      </div>
    </header>

    <div class="dev-grid">
      <section class="card pad" aria-labelledby="conn-title">
        <h2 id="conn-title" class="key">Communication</h2>
        <dl class="facts">
          <dt>Protocol</dt>
          <dd>{PROTOCOL_NAME[info.protocol]}{!said("protocol") && <span class="def">default</span>}</dd>
          <dt>Unit ID</dt>
          <dd class="mono">{info.unitId}{!said("unit_id") && <span class="def">default</span>}</dd>
          {hasTcp && <><dt>TCP port</dt><dd class="mono">{info.port}{!said("port") && <span class="def">default</span>}</dd></>}
          {
            hasRtu && (
              <>
                <dt>Serial</dt>
                <dd>
                  <span class="mono">{info.baudrate} {info.databits}{info.parity}{info.stopbits}</span>
                  <span class="faint"> · {info.baudrate} baud, {info.databits} data bits, {PARITY_NAME[info.parity]?.toLowerCase()} parity, {info.stopbits} stop bit{info.stopbits > 1 ? "s" : ""}</span>
                  {!["baudrate", "parity", "databits", "stopbits"].some(said) && <span class="def">defaults</span>}
                </dd>
              </>
            )
          }
          <dt>Byte / word order</dt>
          <dd>
            <span class="mono">{orderTag(info.byteOrder, info.wordOrder)}</span>
            <span class="faint"> · bytes {info.byteOrder}-endian, words {info.wordOrder === "big" ? "high first" : "low first (word swap)"}</span>
            {!said("byte_order") && !said("word_order") && <span class="def">default</span>}
          </dd>
          <dt>Addresses</dt>
          <dd>{info.addressBase}-based{info.addressBase === 1 && <span class="faint"> · wire address = address − 1</span>}{!said("address_base") && <span class="def">default</span>}</dd>
          {said("max_read_registers") && <><dt>Max read</dt><dd><span class="mono">{info.maxReadRegisters}</span> registers per request</dd></>}
          {said("max_read_bits") && <><dt>Max read bits</dt><dd><span class="mono">{info.maxReadBits}</span> bits per request</dd></>}
        </dl>
        <p class="faint small">Connection values are defaults: the device may be configured differently.</p>
      </section>

      <section class="card pad" aria-labelledby="map-title">
        <h2 id="map-title" class="key">Map</h2>
        <dl class="facts">
          <dt>Registers</dt>
          <dd>
            {areas.map((a, i) => <>{i > 0 && ", "}<span class="mono">{d.areaCounts[a]}</span> {AREA_NAME[a].toLowerCase()}{d.areaCounts[a]! > 1 && "s"}</>)}
            {info.skipped > 0 && <span class="faint"> · {info.skipped} not shown (unreadable)</span>}
          </dd>
          {groups.length > 0 && <><dt>Groups</dt><dd>{groups.length}</dd></>}
          {info.enumCount > 0 && <><dt>Translation tables</dt><dd>{info.enumCount}</dd></>}
          {info.revision && <><dt>Revision</dt><dd><span class="mono">{info.revision}</span>{info.revised && <span class="faint"> · {info.revised}</span>}</dd></>}
          {(info.firmware || info.firmwareMin || info.firmwareMax) && (
            <><dt>Firmware</dt><dd>
              {info.firmwareMin && `from ${info.firmwareMin} `}{info.firmwareMax && `up to ${info.firmwareMax} `}
              {info.firmware && <span class={info.firmwareMin || info.firmwareMax ? "faint" : ""}>{info.firmware}</span>}
            </dd></>
          )}
          {d.added && <><dt>Added</dt><dd>{d.added}</dd></>}
          <dt>File</dt>
          <dd><a href={links.source} class="mono">{d.path}</a> <span class="faint">· {kb(d.size)}</span> · <a href={links.history}>history</a></dd>
          <dt>SHA-256</dt>
          <dd class="mono sha" title={d.sha256}>{d.sha256}</dd>
          {info.vendorWebsite && <><dt>Manufacturer</dt><dd><a href={/^https?:/.test(info.vendorWebsite) ? info.vendorWebsite : `https://${info.vendorWebsite}`} rel="nofollow">{info.vendorWebsite.replace(/^https?:\/\//, "")}</a></dd></>}
        </dl>
      </section>

      {
        (info.sources.length > 0 || info.source || info.notes.length > 0) && (
          <section class="card pad span" aria-labelledby="src-title">
            <h2 id="src-title" class="key">Sources and notes</h2>
            {info.sources.length > 0 && (
              <ul class="sources">
                {info.sources.map((s) => (
                  <li>
                    {s.url ? <a href={s.url} rel="nofollow">{s.title}</a> : <span>{s.title}</span>}
                    {(s.version || s.date) && <span class="faint"> · {[s.version && `version ${s.version}`, s.date].filter(Boolean).join(", ")}</span>}
                    {s.note && <div class="faint">{s.note}</div>}
                  </li>
                ))}
              </ul>
            )}
            {info.source && <p class="muted"><span class="faint">Source:</span> {info.source}</p>}
            {info.notes.length > 0 && <ul class="notes">{info.notes.map((n) => <li>{n}</li>)}</ul>}
          </section>
        )
      }
    </div>

    <section class="card pad tabs-card" aria-label="Registers and raw file">
      <div class="segmented" role="tablist" aria-label="View">
        <button type="button" role="tab" id="tab-registers" aria-selected="true" aria-controls="registers" class="on">
          Registers <span class="faint">({d.registerCount.toLocaleString("en-US")})</span>
        </button>
        <button type="button" role="tab" id="tab-raw" aria-selected="false" aria-controls="raw" tabindex="-1">Raw JSON</button>
      </div>

      <div id="registers" role="tabpanel" aria-labelledby="tab-registers">
        <form class="toolbar reg-tools" onsubmit="return false" role="search">
          <label class="search-field grow">
            <span class="sr-only">Search registers</span>
            <Icon name="search" />
            <input class="input" type="search" id="reg-q" data-page-search placeholder="Search name, address, group or description" autocomplete="off" spellcheck="false" />
            <kbd>/</kbd>
          </label>
          {areas.length > 1 && (
            <label><span class="sr-only">Area</span>
              <select class="input" id="reg-area">
                <option value="">All areas</option>
                {areas.map((a) => <option value={a}>{AREA_TAG[a]} · {AREA_NAME[a]}s ({d.areaCounts[a]})</option>)}
              </select>
            </label>
          )}
          <label><span class="sr-only">Access</span>
            <select class="input" id="reg-access">
              <option value="">Any access</option>
              {accessCounts.R > 0 && <option value="R">Read only ({accessCounts.R})</option>}
              {accessCounts.RW + accessCounts.W > 0 && <option value="w">Writable ({accessCounts.RW + accessCounts.W})</option>}
            </select>
          </label>
          {groups.length > 1 && (
            <label><span class="sr-only">Group</span>
              <select class="input" id="reg-group">
                <option value="">All groups</option>
                {groups.map((g) => <option value={g}>{g}</option>)}
              </select>
            </label>
          )}
          <label><span class="sr-only">Order</span>
            <select class="input" id="reg-sort">
              <option value="">Map order</option>
              <option value="address">By address</option>
              <option value="name">By name</option>
            </select>
          </label>
          <span class="count" id="reg-count" aria-live="polite">{plural(d.registerCount, "register")}</span>
        </form>

        <div class="table-wrap reg-wrap">
          <table class="table regs" id="reg-table" data-map={fileUrl} data-base={info.addressBase}>
            <thead>
              <tr>{REGISTER_COLUMNS.map((c) => <th scope="col" class={`c-${c.toLowerCase()}`}>{c}</th>)}</tr>
            </thead>
            <tbody id="reg-body" set:html={firstRows} />
          </table>
        </div>
        <div class="empty" id="reg-empty" hidden>
          <strong>No registers match</strong>
          Try part of the name, an address (decimal or 0x hex) or clear the filters.
        </div>
        <nav class="pager" id="reg-pager" aria-label="Register pages" hidden={pages < 2}>
          <span id="reg-page">Page 1 of {pages}</span>
          <span class="btns">
            <button class="btn" type="button" id="reg-prev" disabled><Icon name="back" size={14} /> Previous</button>
            <button class="btn" type="button" id="reg-next">Next <Icon name="next" size={14} /></button>
          </span>
        </nav>
        <noscript><p class="faint">The first {REGISTER_PAGE} registers are shown. The full list is in the <a href={fileUrl}>map file</a>.</p></noscript>
      </div>

      <div id="raw" role="tabpanel" aria-labelledby="tab-raw" hidden>
        <div class="toolbar">
          <span class="faint mono">{fileName} · {kb(d.size)}</span>
          <span class="actions" style="margin-left:auto">
            <button class="btn" type="button" id="raw-copy"><Icon name="copy" /> Copy</button>
            <a class="btn" href={fileUrl} download={fileName}><Icon name="download" /> Download</a>
            <a class="btn" href={rawUrl(d.path)}><Icon name="external" /> Raw on GitHub</a>
          </span>
        </div>
        <pre class="json" id="raw-pre" tabindex="0" aria-label={`Contents of ${fileName}`}><code id="raw-code"><span class="bone" style="width:40%"></span><span class="bone" style="width:72%"></span><span class="bone" style="width:64%"></span><span class="bone" style="width:80%"></span><span class="bone" style="width:56%"></span></code></pre>
      </div>
    </section>

    <section class="card pad help" aria-labelledby="help-title">
      <h2 id="help-title" class="key">Help improve this map</h2>
      <ul class="help-list">
        <li><a href={links.testReport}><Icon name="verified" /> I tested it on a device</a><span class="faint">Report whether it worked, even if you did not write the map.</span></li>
        <li><a href={links.edit}><Icon name="edit" /> Suggest a correction</a><span class="faint">Edit the file on GitHub; it opens a pull request.</span></li>
        <li><a href={links.problem}><Icon name="issue" /> Report a problem</a><span class="faint">A wrong address, type, scale or byte order.</span></li>
        <li><a href={LINKS.spec}><Icon name="library" /> Read the format</a><span class="faint">What each key of the file means (SPEC.md).</span></li>
      </ul>
    </section>
  </article>
</Base>

<script>
  import "../../../scripts/device.ts";
</script>

<style>
  .dev-title {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .dev-name {
    min-width: 0;
  }

  h1 {
    font-size: 26px;
    letter-spacing: -0.02em;
  }

  .vendor-link {
    color: var(--text-2);
    font-weight: 500;
    text-decoration: none;
  }

  .vendor-link:hover {
    color: var(--text);
  }

  .h1-sub {
    display: block;
    margin-top: 2px;
    color: var(--text-3);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0;
  }

  .covers {
    margin: 4px 0 0;
    font-size: 13px;
  }

  .dev-desc {
    margin: 14px 0 0;
    max-width: 80ch;
    color: var(--text-2);
    font-size: 15px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 14px 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 26px;
    padding: 0 10px;
    border-radius: 7px;
    background: var(--field);
    font-size: 13px;
  }

  .dev-head .note {
    margin-bottom: 16px;
  }

  .dev-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .dev-grid .span {
    grid-column: 1 / -1;
  }

  .dev-grid h2 {
    margin-bottom: 6px;
  }

  .small {
    margin: 10px 0 0;
    font-size: 12px;
  }

  .sha {
    font-size: 11.5px;
    color: var(--text-2);
  }

  .sources,
  .notes {
    margin: 6px 0 0;
    padding-left: 18px;
    font-size: 13px;
  }

  .sources li + li,
  .notes li + li {
    margin-top: 4px;
  }

  .notes {
    color: var(--text-2);
  }

  .span p {
    margin: 8px 0 0;
    font-size: 13px;
  }

  .tabs-card > .segmented {
    margin-bottom: 14px;
  }

  .reg-tools {
    margin-bottom: 8px;
  }

  .help-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px 20px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
  }

  .help-list li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .help-list a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-weight: 500;
    text-decoration: none;
  }

  .help-list a:hover {
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .dev-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    h1 {
      font-size: 21px;
    }
    .dev-title :global(.vtile) {
      display: none;
    }
    .dev-head .actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
