---
import { href } from "../lib/base.ts";
import Base from "../layouts/Base.astro";
import { LINKS } from "../lib/site.ts";
---

<Base title="Page not found" description="This page does not exist in the MBMap registry.">
  <section class="card pad empty nf">
    <strong>Page not found</strong>
    <p>The device or page you are looking for is not in the registry, or it has moved.</p>
    <div class="actions">
      <button class="btn primary" type="button" data-cmd-open>Search maps</button>
      <a class="btn" href={href("/devices")}>All devices</a>
      <a class="btn" href={LINKS.mapRequest}>Request a device</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding: 64px 24px;
  }
  .nf .actions {
    justify-content: center;
  }
  .nf p {
    margin: 0 0 18px;
  }
</style>
