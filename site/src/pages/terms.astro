---
import { href } from "../lib/base.ts";
import Base from "../layouts/Base.astro";
import { LINKS, SITE_NAME } from "../lib/site.ts";

const updated = "11 November 2026";
---

<Base
  title="Terms of use"
  description="The terms for using the MBMap registry website and the Modbus device maps it publishes: public domain, provided as is."
>
  <div class="about">
    <section class="card pad prose">
      <h1>Terms of use</h1>
      <p class="lead">Last updated {updated}.</p>

      <h2>The registry</h2>
      <p>
        {SITE_NAME} Registry is a free, community-maintained catalogue of Modbus device maps. By using the website you agree
        to these terms.
      </p>

      <h2>Licence</h2>
      <p>
        The maps, specification and tools are in the public domain under <a href={LINKS.license}>CC0 1.0</a>. You may use, copy
        and change them for any purpose, with no need to ask or credit. Manufacturer names, logos and product names belong to
        their owners and appear only to identify the devices.
      </p>

      <h2>No warranty</h2>
      <p>
        Maps are written from public documentation by volunteers and may contain mistakes. Check every map against the device
        manual before relying on it, and test writes on a safe setup first: a wrong address, scale or write can damage
        equipment, interrupt a process or cause injury. The site and the maps are provided <strong>“as is”</strong>, without
        warranty of any kind, and the maintainers are not liable for any loss from their use.
      </p>

      <h2>Contributions</h2>
      <p>
        Contributions are made on <a href={LINKS.repo}>GitHub</a> and are released under CC0 1.0. Only submit work you have the
        right to publish, and do not copy manufacturer documents wholesale; see <a href={href("/contribute")}>Contribute</a>.
      </p>

      <h2>Acceptable use</h2>
      <p>Do not overload the site or attempt to disrupt it. Automated reading is fine at a reasonable rate; the repository itself is the better source for bulk copies.</p>

      <h2>Privacy and changes</h2>
      <p>
        How data and cookies are handled is described in the <a href={href("/privacy")}>privacy policy</a>. These terms can
        change; the current version is always on this page. Questions: <a href={LINKS.issues}>GitHub issues</a>.
      </p>
    </section>
  </div>
</Base>
