---
import type { GetStaticPaths } from "astro";
import View from "../../../views/manufacturers/manufacturer.astro";
import { registry } from "../../../lib/registry.ts";

export const getStaticPaths = (() =>
  registry().manufacturers.map((m) => ({ params: { vendor: m.slug }, props: { maker: m } }))) satisfies GetStaticPaths;
---

<View {...Astro.props} />
