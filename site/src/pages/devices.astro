---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import StatusBar from "../components/StatusBar.astro";
import { deviceEntry, registry } from "../lib/registry.ts";
import { CATALOGUE_PAGE, deviceHead, deviceRow } from "../lib/device-row.ts";
import { vendorIcons } from "../lib/vendor-icons.ts";
import { STATUSES, STATUS_INFO, plural } from "../lib/mbmap.ts";
import { LINKS } from "../lib/site.ts";
import { href } from "../lib/base.ts";

const { devices, manufacturers, statusCounts, registerCount } = registry();
const icons = await vendorIcons();
const hasDates = devices.some((d) => d.added);
const firstPage = devices.slice(0, CATALOGUE_PAGE).map((d) => deviceRow(deviceEntry(d, icons))).join("");
const pages = Math.ceil(devices.length / CATALOGUE_PAGE);
const description = `Browse and search ${plural(devices.length, "Modbus device map")} from ${plural(manufacturers.length, "manufacturer")}, ${registerCount.toLocaleString("en-US")} registers in all. Filter by manufacturer and verification status.`;
---

<Base title="Modbus Device Catalogue" description={description} nav="devices">
  <header class="page-head">
    <div>
      <h1>Devices</h1>
      <p class="lead">
        {plural(devices.length, "map")} from {plural(manufacturers.length, "manufacturer")},
        {plural(registerCount, "register")} in all.
      </p>
    </div>
    <div class="head-status"><StatusBar counts={statusCounts} /></div>
  </header>

  <section class="card pad catalogue" id="catalogue" aria-labelledby="cat-title">
    <h2 id="cat-title" class="sr-only">Device catalogue</h2>
    <form class="toolbar" id="cat-form" role="search" action={href("/devices")} method="get" onsubmit="return false">
      <label class="search-field grow">
        <span class="sr-only">Search devices</span>
        <Icon name="search" size={16} />
        <input
          class="input big"
          type="search"
          name="q"
          id="cat-q"
          data-page-search
          placeholder="Search manufacturer, model or register name"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd>/</kbd>
      </label>
      <label>
        <span class="sr-only">Manufacturer</span>
        <select class="input" name="vendor" id="cat-vendor">
          <option value="">All manufacturers</option>
          {manufacturers.map((m) => <option value={m.slug}>{m.name} ({m.devices.length})</option>)}
        </select>
      </label>
      <div class="segmented" role="group" aria-label="Status" id="cat-status" data-pill>
        <button type="button" class="on" data-status="" aria-pressed="true">All</button>
        {
          STATUSES.map((s) => (
            <button type="button" data-status={s} aria-pressed="false" title={STATUS_INFO[s].short}>
              {STATUS_INFO[s].label}
            </button>
          ))
        }
      </div>
      <label>
        <span class="sr-only">Sort</span>
        <select class="input" name="sort" id="cat-sort">
          <option value="">Best match / A–Z</option>
          <option value="name">Name A–Z</option>
          {hasDates && <option value="added">Recently added</option>}
          <option value="registers">Most registers</option>
        </select>
      </label>
    </form>

    <div class="cat-meta">
      <span id="cat-count" class="faint" aria-live="polite">{plural(devices.length, "map")}</span>
    </div>

    <div class="table-wrap">
      <table class="table devices" id="cat-table">
        <thead set:html={deviceHead()} />
        <tbody id="cat-body" set:html={firstPage} />
      </table>
    </div>
    <div class="empty" id="cat-empty" hidden>
      <strong>No maps match your search</strong>
      <span>Try a model number or a manufacturer, or clear the filters.</span>
      <div class="actions" style="justify-content:center;margin-top:14px">
        <button class="btn" type="button" id="cat-clear">Clear filters</button>
        <a class="btn" href={LINKS.mapRequest}>Request this device</a>
        <a class="btn primary" href={href("/contribute#add")}>Add a map</a>
      </div>
    </div>
    <nav class="pager" id="cat-pager" aria-label="Pages" hidden={pages < 2}>
      <span id="cat-page">Page 1 of {pages}</span>
      <span class="btns">
        <button class="btn" type="button" id="cat-prev" disabled><Icon name="back" size={14} /> Previous</button>
        <button class="btn" type="button" id="cat-next">Next <Icon name="next" size={14} /></button>
      </span>
    </nav>
    <noscript>
      <p class="faint">
        The first {CATALOGUE_PAGE} maps are shown. Search and the other pages need JavaScript; every map is also listed on
        the <a href={href("/manufacturers")}>manufacturer pages</a>.
      </p>
    </noscript>
  </section>
</Base>

<script>
  import "../scripts/catalogue.ts";
</script>

<style>
  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 32px;
    margin: 4px 0 16px;
  }

  .head-status {
    flex: 0 1 380px;
  }

  .head-status :global(.legend) {
    margin-top: 8px;
  }

  .cat-meta {
    margin: 12px 2px 2px;
    font-size: 13px;
  }
</style>
