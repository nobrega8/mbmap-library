---
// How a set of maps divides by status: a thin bar and a legend with counts.
import { type Status, STATUSES } from "../lib/mbmap.ts";
import { DEFAULT_LOCALE, type Locale } from "../i18n/locales.ts";
import { statusLabel, statusShort } from "../i18n/labels.ts";
import Icon from "./Icon.astro";

interface Props {
  counts: Record<Status, number>;
  legend?: boolean;
}

const { counts, legend = true } = Astro.props;
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const total = STATUSES.reduce((n, s) => n + counts[s], 0);
---

<div class="status-bar" role="img" aria-label={STATUSES.map((s) => `${counts[s]} ${statusLabel(locale, s).toLowerCase()}`).join(", ")}>
  {STATUSES.filter((s) => counts[s]).map((s) => <span class={s} style={`flex: ${counts[s] / total}`} />)}
</div>
{
  legend && (
    <ul class="legend">
      {STATUSES.map((s) => (
        <li title={statusShort(locale, s)}>
          <span class={`dot ${s}`}>
            <Icon name={s} size={14} />
          </span>
          {statusLabel(locale, s)} <b>{counts[s]}</b>
        </li>
      ))}
    </ul>
  )
}
