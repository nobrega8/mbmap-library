---
// A manufacturer's icon, or the first letter of its name, as in Modbench.
import { vendorTile } from "../lib/device-row.ts";
import { vendorIconUrl } from "../lib/vendor-icons.ts";

interface Props {
  name: string;
  slug: string;
  large?: boolean;
}

const { name, slug, large = false } = Astro.props;
const icon = await vendorIconUrl(slug);
---

<Fragment set:html={vendorTile(name, icon, large)} />
