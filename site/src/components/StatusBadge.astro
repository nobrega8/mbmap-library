---
// The x_status of a map: Modbench's icon and colour, with its label.
import type { Status } from "../lib/mbmap.ts";
import { DEFAULT_LOCALE, type Locale } from "../i18n/locales.ts";
import { translate } from "../i18n/index.ts";
import { statusLabel, statusShort } from "../i18n/labels.ts";
import Icon from "./Icon.astro";

interface Props {
  status: Status | null;
  label?: boolean;
  size?: number;
}

const { status, label = true, size = 15 } = Astro.props;
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const info = status ? { short: statusShort(locale, status), label: statusLabel(locale, status) } : null;
---

{
  status && info ? (
    <span class={`status ${status}`} title={info.short}>
      <Icon name={status} size={size} />
      {label ? <span>{info.label}</span> : <span class="sr-only">{info.label}</span>}
    </span>
  ) : (
    <span class="status faint" title={translate(locale, "status.noneTitle")}>{translate(locale, "status.none")}</span>
  )
}
