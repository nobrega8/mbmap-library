---
import { DEFAULT_LOCALE, PROSE_LOCALES, type Locale } from "../i18n/locales.ts";
import { href } from "../lib/base.ts";
import Base from "../layouts/Base.astro";
import { LINKS, SITE_NAME } from "../lib/site.ts";

const updated = "11 November 2026";

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const zh = locale === "zh";
const pt = locale === "pt";
const hi = locale === "hi";
const es = locale === "es";
const fr = locale === "fr";
const bn = locale === "bn";
const ru = locale === "ru";
const de = locale === "de";
const tr = locale === "tr";
const th = locale === "th";
const hu = locale === "hu";
---

<Base
