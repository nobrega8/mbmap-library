---
import Base from "../../layouts/Base.astro";
import { pageHref } from "../../lib/base.ts";
import { DEFAULT_LOCALE, type Locale } from "../../i18n/locales.ts";
import { useT } from "../../i18n/index.ts";
import { GUIDES, guideShort } from "../../lib/guides.ts";
import { guideSummary, renderGuide } from "../../lib/markdown.ts";

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useT(locale);
const items = await Promise.all(
  GUIDES.map(async (g) => ({ ...g, title: (await renderGuide(g.slug, locale))?.title ?? guideShort(g.slug, locale), summary: guideSummary(g.slug, locale) })),
);
---

<Base title={t("guides.title")} description={t("guides.description")} nav="guides">
  <header class="page-head">
    <p class="key">{t("nav.guides")}</p>
    <h1>{t("guides.h1")}</h1>
    <p class="lead muted">{t("guides.lead")}</p>
  </header>
  <ul class="guide-list">
    {items.map((g) => (
      <li class="card pad">
        <a href={pageHref(`/guides/${g.slug}`, locale)}><h2>{g.title}</h2></a>
        <p class="muted">{g.summary}</p>
      </li>
    ))}
  </ul>
</Base>

<style>
  .page-head {
    margin: 4px 0 18px;
  }
  .lead {
    max-width: 70ch;
    margin: 8px 0 0;
  }
  .guide-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .guide-list h2 {
    margin: 0 0 6px;
    font-size: 17px;
  }
  .guide-list a {
    text-decoration: none;
  }
  .guide-list a:hover h2 {
    text-decoration: underline;
  }
  .guide-list p {
    margin: 0;
    font-size: 14px;
  }
</style>
