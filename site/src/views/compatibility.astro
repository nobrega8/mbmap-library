---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { renderLibraryMarkdown } from "../lib/markdown.ts";
import { LINKS } from "../lib/site.ts";
import { DEFAULT_LOCALE, type Locale } from "../i18n/locales.ts";

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const zh = locale === "zh";
const pt = locale === "pt";
const hi = locale === "hi";
const es = locale === "es";
const doc = await renderLibraryMarkdown("COMPATIBILITY.md", locale);
const html = doc?.html;
---

<Base
  untranslated={!doc?.translated}
  title={zh ? "兼容的工具" : es ? "Herramientas compatibles" : hi ? "संगत टूल" : pt ? "Ferramentas compatíveis" : "Compatible Tools"}
  description={zh ? "读取 .mbmap 设备映射表的 Modbus 工具（包括 Modbench），以及它们各自支持 MBMap 格式的哪些部分。" : es ? "Herramientas Modbus que leen mapas de dispositivos .mbmap, incluido Modbench, y qué partes del formato MBMap admite cada una." : hi ? "Modbus टूल जो .mbmap डिवाइस मैप पढ़ते हैं, Modbench सहित, और हर एक MBMap फ़ॉर्मैट के कौन-से हिस्से समर्थित करता है।" : pt ? "Ferramentas Modbus que leem mapas de dispositivos .mbmap, incluindo o Modbench, e que partes do formato MBMap cada uma suporta." : "Modbus tools that read .mbmap device maps, including Modbench, and which parts of the MBMap format each one supports."}
  nav="compatibility"
>
  <header class="page-head">
    <h1>{zh ? "兼容性" : es ? "Compatibilidad" : hi ? "संगतता" : pt ? "Compatibilidade" : "Compatibility"}</h1>
  </header>

  <section class="card pad">
    {
      html ? (
        <div class="prose wide" set:html={html} />
      ) : (
        <div class="empty">
          <strong>{zh ? "无法读取兼容性列表" : es ? "No se pudo leer la lista de compatibilidad" : hi ? "संगतता सूची पढ़ी नहीं जा सकी" : pt ? "Não foi possível ler a lista de compatibilidade" : "The compatibility list could not be read"}</strong>
          {zh ? <>请在 GitHub 上查看 <a href={LINKS.compatibility}>COMPATIBILITY.md</a>。</> : es ? <>Consulta <a href={LINKS.compatibility}>COMPATIBILITY.md</a> en GitHub.</> : hi ? <>GitHub पर <a href={LINKS.compatibility}>COMPATIBILITY.md</a> देखें।</> : pt ? <>Veja o <a href={LINKS.compatibility}>COMPATIBILITY.md</a> no GitHub.</> : <>See <a href={LINKS.compatibility}>COMPATIBILITY.md</a> on GitHub.</>}
        </div>
      )
    }
    <p class="faint src">
      <Icon name="github" size={13} />
      {zh ? <>来自库中的 <a href={LINKS.compatibility}>COMPATIBILITY.md</a>。要添加工具，请提交修改该文件的拉取请求。</> : es ? <>De <a href={LINKS.compatibility}>COMPATIBILITY.md</a> de la biblioteca. Para añadir una herramienta, abre una pull request que modifique ese archivo.</> : hi ? <>लाइब्रेरी के <a href={LINKS.compatibility}>COMPATIBILITY.md</a> से। कोई टूल जोड़ने के लिए उस फ़ाइल को बदलने वाला pull request खोलें।</> : pt ? <>Do <a href={LINKS.compatibility}>COMPATIBILITY.md</a> da biblioteca. Para acrescentar uma ferramenta, abra um pull request que altere esse ficheiro.</> : <>From <a href={LINKS.compatibility}>COMPATIBILITY.md</a> in the library. To add a tool, open a pull request that changes that file.</>}
    </p>
  </section>
</Base>

<style>
  .page-head {
    margin: 4px 0 16px;
  }

  .prose.wide {
    max-width: none;
  }

  .prose :global(.table-wrap) {
    margin: 0 0 18px;
  }

  .prose :global(.table.md) {
    font-size: 13px;
    line-height: 1.5;
  }

  .prose :global(.table.md td) {
    vertical-align: top;
    min-width: 120px;
  }

  .prose :global(.table.md td:first-child) {
    font-weight: 500;
    white-space: nowrap;
  }

  .prose :global(.table.md img) {
    display: inline-block;
    vertical-align: -4px;
    margin-right: 4px;
    border-radius: 4px;
  }

  .src {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 18px 0 0;
    font-size: 13px;
  }
</style>
