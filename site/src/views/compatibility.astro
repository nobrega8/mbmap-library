---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { renderLibraryMarkdown } from "../lib/markdown.ts";
import { LINKS } from "../lib/site.ts";
import { DEFAULT_LOCALE, type Locale } from "../i18n/locales.ts";

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const zh = locale === "zh";
const pt = locale === "pt";
const hi = locale === "hi";
const es = locale === "es";
const fr = locale === "fr";
const bn = locale === "bn";
const ru = locale === "ru";
const de = locale === "de";
const tr = locale === "tr";
const th = locale === "th";
const hu = locale === "hu";
const doc = await renderLibraryMarkdown("COMPATIBILITY.md", locale);
const html = doc?.html;
---

<Base
  untranslated={!doc?.translated}
  title={zh ? "兼容的工具" : hu ? "Kompatibilis eszközök" : th ? "เครื่องมือที่เข้ากันได้" : tr ? "Uyumlu araçlar" : de ? "Kompatible Werkzeuge" : ru ? "Совместимые инструменты" : bn ? "সামঞ্জস্যপূর্ণ টুল" : fr ? "Outils compatibles" : es ? "Herramientas compatibles" : hi ? "संगत टूल" : pt ? "Ferramentas compatíveis" : "Compatible Tools"}
  description={zh ? "读取 .mbmap 设备映射表的 Modbus 工具（包括 Modbench），以及它们各自支持 MBMap 格式的哪些部分。" : hu ? "A .mbmap eszköztérképeket olvasó Modbus-eszközök, köztük a Modbench, és hogy az MBMap formátum mely részeit támogatja mindegyik." : th ? "เครื่องมือ Modbus ที่อ่านแมปอุปกรณ์ .mbmap รวมถึง Modbench และส่วนของรูปแบบ MBMap ที่แต่ละตัวรองรับ" : tr ? "Modbench dahil .mbmap cihaz haritalarını okuyan Modbus araçları ve her birinin MBMap biçiminin hangi kısımlarını desteklediği." : de ? "Modbus-Werkzeuge, die .mbmap-Gerätemaps lesen, darunter Modbench, und welche Teile des MBMap-Formats jedes davon unterstützt." : ru ? "Инструменты Modbus, которые читают карты устройств .mbmap, включая Modbench, и какие части формата MBMap поддерживает каждый из них." : bn ? "যেসব Modbus টুল .mbmap ডিভাইস ম্যাপ পড়ে, Modbench-সহ, এবং MBMap ফরম্যাটের কোন অংশ প্রতিটি সমর্থন করে।" : fr ? "Les outils Modbus qui lisent les cartes de périphériques .mbmap, dont Modbench, et les parties du format MBMap que chacun prend en charge." : es ? "Herramientas Modbus que leen mapas de dispositivos .mbmap, incluido Modbench, y qué partes del formato MBMap admite cada una." : hi ? "Modbus टूल जो .mbmap डिवाइस मैप पढ़ते हैं, Modbench सहित, और हर एक MBMap फ़ॉर्मैट के कौन-से हिस्से समर्थित करता है।" : pt ? "Ferramentas Modbus que leem mapas de dispositivos .mbmap, incluindo o Modbench, e que partes do formato MBMap cada uma suporta." : "Modbus tools that read .mbmap device maps, including Modbench, and which parts of the MBMap format each one supports."}
  nav="compatibility"
>
  <header class="page-head">
    <h1>{zh ? "兼容性" : hu ? "Kompatibilitás" : th ? "ความเข้ากันได้" : tr ? "Uyumluluk" : de ? "Kompatibilität" : ru ? "Совместимость" : bn ? "সামঞ্জস্য" : fr ? "Compatibilité" : es ? "Compatibilidad" : hi ? "संगतता" : pt ? "Compatibilidade" : "Compatibility"}</h1>
  </header>

  <section class="card pad">
    {
      html ? (
        <div class="prose wide" set:html={html} />
      ) : (
        <div class="empty">
          <strong>{zh ? "无法读取兼容性列表" : hu ? "A kompatibilitási lista nem olvasható be" : th ? "อ่านรายการความเข้ากันได้ไม่ได้" : tr ? "Uyumluluk listesi okunamadı" : de ? "Die Kompatibilitätsliste konnte nicht gelesen werden" : ru ? "Не удалось прочитать список совместимости" : bn ? "সামঞ্জস্য তালিকা পড়া যায়নি" : fr ? "La liste de compatibilité n’a pas pu être lue" : es ? "No se pudo leer la lista de compatibilidad" : hi ? "संगतता सूची पढ़ी नहीं जा सकी" : pt ? "Não foi possível ler a lista de compatibilidade" : "The compatibility list could not be read"}</strong>
          {zh ? <>请在 GitHub 上查看 <a href={LINKS.compatibility}>COMPATIBILITY.md</a>。</> : hu ? <>Lásd a <a href={LINKS.compatibility}>COMPATIBILITY.md</a> fájlt a GitHubon.</> : th ? <>ดู <a href={LINKS.compatibility}>COMPATIBILITY.md</a> บน GitHub</> : tr ? <>GitHub'da <a href={LINKS.compatibility}>COMPATIBILITY.md</a> dosyasına bakın.</> : de ? <>Siehe <a href={LINKS.compatibility}>COMPATIBILITY.md</a> auf GitHub.</> : ru ? <>См. <a href={LINKS.compatibility}>COMPATIBILITY.md</a> на GitHub.</> : bn ? <>GitHub-এ <a href={LINKS.compatibility}>COMPATIBILITY.md</a> দেখুন।</> : fr ? <>Voir <a href={LINKS.compatibility}>COMPATIBILITY.md</a> sur GitHub.</> : es ? <>Consulta <a href={LINKS.compatibility}>COMPATIBILITY.md</a> en GitHub.</> : hi ? <>GitHub पर <a href={LINKS.compatibility}>COMPATIBILITY.md</a> देखें।</> : pt ? <>Veja o <a href={LINKS.compatibility}>COMPATIBILITY.md</a> no GitHub.</> : <>See <a href={LINKS.compatibility}>COMPATIBILITY.md</a> on GitHub.</>}
        </div>
      )
    }
    <p class="faint src">
      <Icon name="github" size={13} />
      {zh ? <>来自库中的 <a href={LINKS.compatibility}>COMPATIBILITY.md</a>。要添加工具，请提交修改该文件的拉取请求。</> : hu ? <>A könyvtár <a href={LINKS.compatibility}>COMPATIBILITY.md</a> fájljából. Eszköz hozzáadásához nyisson egy pull requestet, amely módosítja ezt a fájlt.</> : th ? <>จาก <a href={LINKS.compatibility}>COMPATIBILITY.md</a> ของไลบรารี หากต้องการเพิ่มเครื่องมือ ให้เปิด pull request ที่แก้ไขไฟล์นั้น</> : tr ? <>Kitaplığın <a href={LINKS.compatibility}>COMPATIBILITY.md</a> dosyasından. Bir araç eklemek için bu dosyayı değiştiren bir pull request açın.</> : de ? <>Aus der <a href={LINKS.compatibility}>COMPATIBILITY.md</a> der Bibliothek. Um ein Werkzeug hinzuzufügen, eröffnen Sie einen Pull Request, der diese Datei ändert.</> : ru ? <>Из <a href={LINKS.compatibility}>COMPATIBILITY.md</a> библиотеки. Чтобы добавить инструмент, откройте pull request, изменяющий этот файл.</> : bn ? <>লাইব্রেরির <a href={LINKS.compatibility}>COMPATIBILITY.md</a> থেকে নেওয়া। একটি টুল যোগ করতে ওই ফাইল সম্পাদনা করে একটি pull request খুলুন।</> : fr ? <>Tiré de <a href={LINKS.compatibility}>COMPATIBILITY.md</a> dans la bibliothèque. Pour ajouter un outil, ouvrez une pull request qui modifie ce fichier.</> : es ? <>De <a href={LINKS.compatibility}>COMPATIBILITY.md</a> de la biblioteca. Para añadir una herramienta, abre una pull request que modifique ese archivo.</> : hi ? <>लाइब्रेरी के <a href={LINKS.compatibility}>COMPATIBILITY.md</a> से। कोई टूल जोड़ने के लिए उस फ़ाइल को बदलने वाला pull request खोलें।</> : pt ? <>Do <a href={LINKS.compatibility}>COMPATIBILITY.md</a> da biblioteca. Para acrescentar uma ferramenta, abra um pull request que altere esse ficheiro.</> : <>From <a href={LINKS.compatibility}>COMPATIBILITY.md</a> in the library. To add a tool, open a pull request that changes that file.</>}
    </p>
  </section>
</Base>

<style>
  .page-head {
    margin: 4px 0 16px;
  }

  .prose.wide {
    max-width: none;
  }

  .prose :global(.table-wrap) {
    margin: 0 0 18px;
  }

  .prose :global(.table.md) {
    font-size: 13px;
    line-height: 1.5;
  }

  .prose :global(.table.md td) {
    vertical-align: top;
    min-width: 120px;
  }

  .prose :global(.table.md td:first-child) {
    font-weight: 500;
    white-space: nowrap;
  }

  .prose :global(.table.md img) {
    display: inline-block;
    vertical-align: -4px;
    margin-right: 4px;
    border-radius: 4px;
  }

  .src {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 18px 0 0;
    font-size: 13px;
  }
</style>
