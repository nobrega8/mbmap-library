---
import Base from "../layouts/Base.astro";
import StatusHistory from "../components/StatusHistory.astro";
import Icon from "../components/Icon.astro";
import VendorTile from "../components/VendorTile.astro";
import { mapFile, registry } from "../lib/registry.ts";
import { highlightJson } from "../lib/json-highlight.ts";
import { AREA_TAG, STATUSES, typeLabel } from "../lib/mbmap.ts";
import { DEFAULT_LOCALE, LOCALE_TAG, type Locale } from "../i18n/locales.ts";
import { count, useT } from "../i18n/index.ts";
import { areaName, statusLabel, statusLong, statusShort } from "../i18n/labels.ts";
import { LINKS, MODBENCH_URL, SITE_NAME } from "../lib/site.ts";
import { href, localizeUrl, pageHref } from "../lib/base.ts";

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = useT(locale);
const TAGLINE = t("site.tagline");
const SUBLINE = t("site.subline");
const { devices, manufacturers, statusCounts, registerCount } = registry();
const fmt = (n: number) => n.toLocaleString(LOCALE_TAG[locale]);

// The map shown in the hero: the most trusted, most recently revised one, so
// the example is a real map (verified on a device when there is one).
const ranked = [...devices].sort(
  (a, b) =>
    STATUSES.indexOf(a.status ?? "unofficial") - STATUSES.indexOf(b.status ?? "unofficial") ||
    (b.info.revised ?? "").localeCompare(a.info.revised ?? "") ||
    b.registerCount - a.registerCount,
);
const featured = ranked.find((d) => d.registerCount >= 8) ?? ranked[0]!;
const withUnits = featured.info.registers.filter((r) => r.unit).slice(0, 7);
const shownRegs = withUnits.length >= 4 ? withUnits : featured.info.registers.slice(0, 7);

// An excerpt of the same file, in the layout SPEC.md asks for: one register per line
const raw = JSON.parse(mapFile(featured).toString("utf8").replace(/^﻿/, ""));
const headKeys = ["mbmap", "vendor", "model", "protocol", "byte_order", "word_order", "address_base"].filter((k) => k in raw);
const line = (v: unknown) => JSON.stringify(v).replace(/,"/g, ', "').replace(/":/g, '": ');
const excerpt =
  "{\n" +
  headKeys.map((k) => `  "${k}": ${JSON.stringify(raw[k])},`).join("\n") +
  `\n  "registers": [\n${(raw.registers as unknown[])
    .slice(0, 3)
    .map((r) => `    ${line(r)}`)
    .join(",\n")},\n    …\n  ]\n}`;

const recent = devices
  .filter((d) => d.added)
  .sort((a, b) => b.added!.localeCompare(a.added!) || a.info.vendor.localeCompare(b.info.vendor))
  .slice(0, 8);
const topMakers = [...manufacturers]
  .sort((a, b) => b.devices.length - a.devices.length || a.name.localeCompare(b.name))
  .slice(0, 16);
const fmtDate = (s: string) =>
  new Date(s).toLocaleDateString(LOCALE_TAG[locale], { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });

const description = t("home.description", { tagline: TAGLINE, maps: count(locale, devices.length, "mapModbus"), makers: count(locale, manufacturers.length, "manufacturer") });
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "DataCatalog",
    name: `${SITE_NAME} Registry`,
    url: new URL(pageHref("/", locale), Astro.site).href,
    description,
    license: "https://creativecommons.org/publicdomain/zero/1.0/",
    sameAs: [LINKS.repo],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: `${SITE_NAME} Registry`,
    url: new URL(pageHref("/", locale), Astro.site).href,
    description,
    inLanguage: LOCALE_TAG[locale],
    publisher: { "@type": "Person", name: "Afonso Nóbrega", url: "https://nobrega.me" },
    potentialAction: {
      "@type": "SearchAction",
      target: `${new URL(pageHref("/devices", locale), Astro.site).href}?q={query}`,
      "query-input": "required name=query",
    },
  },
];
---

<Base title={`${SITE_NAME} — ${TAGLINE}`} fullTitle description={description} nav="home" jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-text">
      <p class="key eyebrow">{t("home.eyebrow")}</p>
      <h1 id="hero-title">{TAGLINE}</h1>
      <p class="lead">{SUBLINE} {t("home.lead")}</p>

      <form class="hero-search" action={pageHref("/devices", locale)} method="get" role="search" id="hero-form">
        <label class="search-field">
          <span class="sr-only">{t("home.searchLabel")}</span>
          <Icon name="search" size={17} />
          <input
            class="input big"
            type="search"
            name="q"
            id="hero-q"
            data-page-search
            placeholder={t("home.searchPlaceholder", { n: fmt(devices.length) })}
            autocomplete="off"
            spellcheck="false"
            role="combobox"
            aria-expanded="false"
            aria-controls="hero-results"
            aria-autocomplete="list"
          />
          <kbd>/</kbd>
        </label>
        <ul class="hero-results cmd-list" id="hero-results" role="listbox" aria-label={t("search.results")} hidden></ul>
      </form>

      <div class="actions hero-actions">
        <a class="btn primary big" href={pageHref("/devices", locale)}>{t("home.browse")} <Icon name="next" size={14} /></a>
        <a class="btn big" href={pageHref("/spec", locale)}>{t("home.readSpec")}</a>
        <a class="btn big ghost" href={LINKS.repo}><Icon name="github" /> GitHub</a>
      </div>
    </div>

    <figure class="card preview">
      <div class="preview-head">
        <VendorTile name={featured.info.vendor} slug={featured.vendorSlug} />
        <div class="preview-title">
          <a href={localizeUrl(featured.url, locale)}><b>{featured.info.vendor} {featured.info.model}</b></a>
          <span class="faint">{count(locale, featured.registerCount, "register")}{featured.info.revision && ` · ${t("home.rev", { n: featured.info.revision })}`}</span>
        </div>
        {
          featured.status && (
            <span class={`status ${featured.status}`} title={statusShort(locale, featured.status)}>
              <Icon name={featured.status} /> {statusLabel(locale, featured.status)}
            </span>
          )
        }
      </div>
      <div class="segmented preview-tabs" role="tablist" aria-label={t("home.exampleView")} data-pill>
        <button type="button" role="tab" class="on" aria-selected="true" aria-controls="pv-table" id="pv-tab-table">{t("home.tabRegisters")}</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="pv-json" id="pv-tab-json" tabindex="-1">.mbmap.json</button>
      </div>
      <div class="preview-body">
        <div id="pv-table" role="tabpanel" aria-labelledby="pv-tab-table" class="table-wrap">
          <table class="table preview-table">
            <thead><tr><th>{t("home.colArea")}</th><th>{t("home.colAddr")}</th><th>{t("home.colName")}</th><th>{t("home.colType")}</th><th>{t("home.colUnit")}</th></tr></thead>
            <tbody>
              {
                shownRegs.map((r, i) => (
                  <tr style={`--i:${i}`}>
                    <td class="area" title={areaName(locale, r.area)}>{AREA_TAG[r.area]}</td>
                    <td class="mono">{r.address}</td>
                    <td><b>{r.name}</b>{r.group && <span class="grp"> {r.group}</span>}</td>
                    <td class="mono">{typeLabel(r)}</td>
                    <td>{r.unit}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <pre class="json preview-json" id="pv-json" role="tabpanel" aria-labelledby="pv-tab-json" hidden><code set:html={highlightJson(excerpt)} /></pre>
      </div>
      <figcaption class="faint">
        {t("home.excerpt")} <a href={localizeUrl(featured.url, locale)}>{t("home.openFull")}</a>
      </figcaption>
    </figure>
  </section>

  <section class="stats-band" aria-label={t("home.numbers")}>
    <dl class="stats big-stats">
      <div class="stat"><dt class="key">{t("home.statDevices")}</dt><dd data-roll={fmt(devices.length)}>{fmt(devices.length)}</dd></div>
      <div class="stat"><dt class="key">{t("home.statManufacturers")}</dt><dd data-roll={fmt(manufacturers.length)}>{fmt(manufacturers.length)}</dd></div>
      <div class="stat"><dt class="key">{t("home.statRegisters")}</dt><dd data-roll={fmt(registerCount)}>{fmt(registerCount)}</dd></div>
      {
        STATUSES.map((s) => (
          <div class="stat" title={statusShort(locale, s)}>
            <dt class="key">
              <span class={`dot ${s}`}><Icon name={s} size={13} /></span>
              {statusLabel(locale, s)}
            </dt>
            <dd data-roll={fmt(statusCounts[s])}>{fmt(statusCounts[s])}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <div class="two">
    {
      recent.length > 0 && (
        <section class="card pad" aria-labelledby="recent-title" data-reveal>
          <div class="section-row">
            <h2 id="recent-title">{t("home.recent")}</h2>
            <a class="btn ghost" href={pageHref("/devices?sort=added", locale)}>{t("home.allByDate")} <Icon name="next" size={14} /></a>
          </div>
          <ul class="recent">
            {recent.map((d) => (
              <li>
                <a href={localizeUrl(d.url, locale)}>
                  <VendorTile name={d.info.vendor} slug={d.vendorSlug} />
                  <span class="r-text">
                    <span class="r-model">{d.info.model}</span>
                    <span class="faint">{d.info.vendor}</span>
                  </span>
                  {d.status && (
                    <span class={`dot ${d.status}`} title={statusLabel(locale, d.status)}>
                      <Icon name={d.status} size={14} />
                    </span>
                  )}
                  <time class="faint" datetime={d.added} title={fmtDate(d.added!)} data-relative>{fmtDate(d.added!)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="card pad fill" aria-labelledby="makers-title" data-reveal>
      <div class="section-row">
        <h2 id="makers-title">{t("home.manufacturers")}</h2>
        <a class="btn ghost" href={pageHref("/manufacturers", locale)}>{t("home.allN", { n: manufacturers.length })} <Icon name="next" size={14} /></a>
      </div>
      <ul class="makers">
        {
          topMakers.map((m) => (
            <li>
              <a href={localizeUrl(m.url, locale)}>
                <VendorTile name={m.name} slug={m.slug} />
                <span class="m-name">{m.name}</span>
                <span class="faint mono">{m.devices.length}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <section class="block" aria-labelledby="how-title" data-reveal>
    <p class="key">{t("home.howKey")}</p>
    <h2 id="how-title" class="big-h2">{t("home.howTitle")}</h2>
    <ol class="steps">
      <li class="card pad">
        <span class="step-n mono">1</span>
        <Icon name="search" size={18} />
        <h3>{t("home.step1")}</h3>
        <p class="muted">{t("home.step1Text")}</p>
      </li>
      <li class="card pad">
        <span class="step-n mono">2</span>
        <Icon name="registers" size={18} />
        <h3>{t("home.step2")}</h3>
        <p class="muted">{t("home.step2Text")}</p>
      </li>
      <li class="card pad">
        <span class="step-n mono">3</span>
        <Icon name="download" size={18} />
        <h3>{t("home.step3")}</h3>
        <p class="muted">{t("home.step3Pre")} <code>.mbmap.json</code> {t("home.step3Post")}</p>
      </li>
    </ol>
  </section>

  <section class="block" aria-labelledby="trust-title" data-reveal>
    <p class="key">{t("home.trustKey")}</p>
    <h2 id="trust-title" class="big-h2">{t("home.trustTitle")}</h2>
    <div class="trust">
      {
        STATUSES.map((s) => (
          <a class="card pad trust-card" href={pageHref(`/devices?status=${s}`, locale)}>
            <span class={`status ${s}`}>
              <Icon name={s} size={18} /> {statusLabel(locale, s)}
            </span>
            <span class="trust-n mono">{fmt(statusCounts[s])}</span>
            <p class="muted">{statusLong(locale, s)}</p>
          </a>
        ))
      }
    </div>
    <StatusHistory />
    <p class="faint small">{t("home.trustNote")}</p>
  </section>

  <section class="card modbench" aria-labelledby="mb-title" data-reveal>
    <div class="mb-text">
      <img src={href("/img/modbench-icon.svg")} width="44" height="44" alt="" />
      <p class="key">{t("home.mbKey")}</p>
      <h2 id="mb-title" class="big-h2">{t("home.mbTitle")}</h2>
      <p class="muted">{t("home.mbText")}</p>
      <div class="actions">
        <a class="btn primary big" href={MODBENCH_URL}>{t("home.mbGet")}</a>
        <a class="btn big" href={pageHref("/compatibility", locale)}>{t("home.mbOthers")}</a>
      </div>
    </div>
    <picture class="mb-shot">
      <source srcset={href("/img/modbench-device-map-dark.webp")} media="(prefers-color-scheme: dark)" />
      <img
        src={href("/img/modbench-device-map.webp")}
        width="1600"
        height="1012"
        alt={t("home.mbAlt")}
        loading="lazy"
        decoding="async"
      />
    </picture>
  </section>

  <section class="cta" aria-labelledby="cta-title" data-reveal>
    <div class="card pad cta-card">
      <div>
        <h2 id="cta-title" class="big-h2">{t("home.ctaTitle")}</h2>
        <p class="muted">{t("home.ctaText")}</p>
      </div>
      <div class="actions">
        <a class="btn primary big" href={pageHref("/contribute", locale)}>{t("home.ctaContribute")}</a>
        <a class="btn big" href={LINKS.mapRequest}>{t("home.ctaRequest")}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import "../scripts/home.ts";
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 560px);
    gap: 40px;
    align-items: center;
    padding: 28px 0 36px;
  }

  .eyebrow {
    margin: 0 0 12px;
  }

  h1 {
    font-size: clamp(32px, 4.4vw, 48px);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.05;
    max-width: 17ch;
    text-wrap: balance;
  }

  .hero .lead {
    margin-top: 14px;
    max-width: 46ch;
    font-size: 16px;
  }

  .hero-search {
    position: relative;
    max-width: 520px;
    margin-top: 24px;
  }

  .hero-search .input.big {
    height: 46px;
    background: var(--card);
    box-shadow: var(--e2);
  }

  .hero-search .input.big:focus {
    box-shadow: var(--e2), var(--ring-focus);
  }

  .hero-results {
    position: absolute;
    z-index: 5;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    border-radius: 12px;
    background: var(--card);
    box-shadow: var(--e3);
    animation: drop 0.16s var(--ease);
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
  }

  .hero-actions {
    margin-top: 18px;
  }

  .preview {
    min-width: 0;
    margin: 0;
    padding: 16px;
    animation: float-in 0.5s var(--ease) both;
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .preview-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .preview-title {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    font-size: 13px;
    line-height: 1.3;
  }

  .preview-title a {
    text-decoration: none;
  }

  .preview-tabs {
    margin-bottom: 8px;
  }

  .preview-body {
    min-height: 272px;
  }

  .preview-table {
    font-size: 12.5px;
  }

  .preview-table th,
  .preview-table td {
    padding: 6px 8px;
    white-space: nowrap;
  }

  .preview-table .grp {
    color: var(--text-3);
    font-size: 11.5px;
  }

  .preview-table tbody tr {
    animation: row-in 0.36s var(--ease) both;
    animation-delay: calc(0.25s + var(--i) * 0.05s);
  }

  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }

  .preview-json {
    max-height: 272px;
    margin: 0;
    font-size: 11.5px;
    animation: row-in 0.24s var(--ease);
  }

  .preview figcaption {
    margin-top: 10px;
    font-size: 12px;
  }

  .stats-band {
    margin-bottom: 16px;
  }

  .big-stats .stat {
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--card);
    box-shadow: var(--e2);
  }

  .big-stats dd {
    font-size: 26px;
  }

  .two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .section-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .section-row .btn {
    gap: 2px;
    margin-right: -10px;
  }

  .recent,
  .makers {
    margin: 0 -8px;
    padding: 0;
    list-style: none;
  }

  .recent a,
  .makers a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 8px;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.14s var(--ease);
  }

  .recent a:hover,
  .makers a:hover {
    background: var(--accent-soft);
  }

  .r-text {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    line-height: 1.3;
  }

  .r-text > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .r-model {
    font-weight: 600;
  }

  .r-text .faint,
  .recent time {
    font-size: 12px;
  }

  .recent time {
    flex: none;
    text-align: right;
    white-space: nowrap;
  }

  .makers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 8px;
    /* The rows share the height the card gets beside "Recently added" */
    grid-auto-rows: 1fr;
    flex: 1;
  }

  .fill {
    display: flex;
    flex-direction: column;
  }

  .m-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 500;
  }

  .block {
    margin-top: 56px;
  }

  .block > .key {
    margin: 0 0 6px;
  }

  .big-h2 {
    max-width: 30ch;
    text-wrap: balance;
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 600;
    letter-spacing: -0.021em;
    line-height: 1.2;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    position: relative;
    transition: box-shadow 0.2s var(--ease);
  }

  .step-n {
    position: absolute;
    top: 18px;
    right: 20px;
    color: var(--text-3);
    font-size: 13px;
  }

  .steps h3 {
    margin: 10px 0 4px;
    font-size: 15px;
  }

  .steps p {
    margin: 0;
    font-size: 13.5px;
  }

  .trust {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 20px;
  }

  .trust-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    transition:
      box-shadow 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .trust-card:hover,
  .steps li:hover {
    box-shadow: var(--e3);
  }

  .trust-card:hover {
    transform: translateY(-2px);
  }

  .trust-card .status {
    font-size: 15px;
  }

  .trust-n {
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .trust-card p {
    margin: 0;
    font-size: 13.5px;
  }

  .small {
    margin: 12px 0 0;
    font-size: 13px;
  }

  .modbench {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px;
    align-items: center;
    margin-top: 56px;
    padding: 32px;
    overflow: hidden;
    /* Modbench's blue (tx) and green (rx), as soft glows in two corners */
    background:
      radial-gradient(60% 90% at 0% 0%, rgb(var(--tx-rgb) / 0.16), transparent 70%),
      radial-gradient(60% 90% at 100% 100%, rgb(var(--rx-rgb) / 0.16), transparent 70%), rgb(var(--surface-rgb));
    border-color: rgb(var(--tx-rgb) / 0.28) rgb(var(--rx-rgb) / 0.28) rgb(var(--rx-rgb) / 0.28) rgb(var(--tx-rgb) / 0.28);
  }

  .mb-text .key {
    margin: 14px 0 6px;
    color: rgb(var(--tx-rgb));
  }

  .mb-text .muted {
    margin: 12px 0 20px;
    font-size: 14.5px;
  }

  .mb-text img {
    border-radius: 10px;
  }

  .mb-shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    box-shadow:
      -14px -10px 40px -18px rgb(var(--tx-rgb) / 0.45),
      14px 10px 40px -18px rgb(var(--rx-rgb) / 0.45),
      var(--e3);
  }

  .cta {
    margin-top: 16px;
  }

  .cta-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding: 28px 32px;
  }

  .cta-card p {
    margin: 6px 0 0;
  }

  @media (max-width: 1000px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .modbench {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 820px) {
    .makers li:nth-child(n + 13) {
      display: none;
    }
    .two,
