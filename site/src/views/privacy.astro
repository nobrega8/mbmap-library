---
import { DEFAULT_LOCALE, PROSE_LOCALES, type Locale } from "../i18n/locales.ts";
import { href } from "../lib/base.ts";
import Base from "../layouts/Base.astro";
import { GTM_ID } from "../lib/analytics.ts";
import { LINKS, SITE_NAME } from "../lib/site.ts";

const updated = "11 November 2026";

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const zh = locale === "zh";
const pt = locale === "pt";
const hi = locale === "hi";
const es = locale === "es";
const fr = locale === "fr";
const bn = locale === "bn";
const ru = locale === "ru";
const de = locale === "de";
const tr = locale === "tr";
const th = locale === "th";
const hu = locale === "hu";
---

<Base
  untranslated={!PROSE_LOCALES.includes(locale)}
  title={zh ? "隐私政策" : hu ? "Adatvédelmi tájékoztató" : th ? "นโยบายความเป็นส่วนตัว" : tr ? "Gizlilik politikası" : de ? "Datenschutzerklärung" : ru ? "Политика конфиденциальности" : bn ? "গোপনীয়তা নীতি" : fr ? "Politique de confidentialité" : es ? "Política de privacidad" : hi ? "गोपनीयता नीति" : pt ? "Política de privacidade" : "Privacy policy"}
  description={zh ? "MBMap 映射库网站收集什么，仅在您同意后才设置的 Cookie，以及如何更改您的选择。" : hu ? "Mit gyűjt az MBMap nyilvántartás weboldala, mely sütiket állítja be kizárólag az Ön hozzájárulásával, és hogyan módosíthatja a választását." : th ? "สิ่งที่เว็บไซต์รีจิสทรี MBMap เก็บรวบรวม คุกกี้ที่ตั้งเฉพาะเมื่อคุณยินยอม และวิธีเปลี่ยนตัวเลือกของคุณ" : tr ? "MBMap kayıt defteri sitesinin neleri topladığı, yalnızca onayınızla hangi çerezleri ayarladığı ve tercihinizi nasıl değiştireceğiniz." : de ? "Was die Website der MBMap-Registry erfasst, welche Cookies sie nur mit Ihrer Einwilligung setzt und wie Sie Ihre Wahl ändern." : ru ? "Что собирает сайт реестра MBMap, какие cookie он устанавливает только с вашего согласия и как изменить свой выбор." : bn ? "MBMap রেজিস্ট্রি সাইট কী সংগ্রহ করে, শুধু আপনার সম্মতিতে কোন কুকি সেট করে এবং আপনার পছন্দ কীভাবে বদলাবেন।" : fr ? "Ce que collecte le site du registre MBMap, les cookies qu’il ne dépose qu’avec votre consentement et comment modifier votre choix." : es ? "Qué recoge el sitio web del registro MBMap, las cookies que solo establece con tu consentimiento y cómo cambiar tu elección." : hi ? "MBMap रजिस्ट्री वेबसाइट क्या एकत्र करती है, केवल आपकी सहमति से सेट होने वाली कुकी, और अपनी पसंद कैसे बदलें।" : pt ? "O que o sítio do registo MBMap recolhe, os cookies que só define com o seu consentimento e como alterar a sua escolha." : "What the MBMap registry website collects, the cookies it sets only with your consent, and how to change your choice."}
