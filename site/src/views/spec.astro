---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { renderLibraryMarkdown } from "../lib/markdown.ts";
import { LINKS } from "../lib/site.ts";
import { BRANCH, REPO_URL } from "../lib/registry.ts";
import { DEFAULT_LOCALE, type Locale } from "../i18n/locales.ts";

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const zh = locale === "zh";
const pt = locale === "pt";
const hi = locale === "hi";
const es = locale === "es";
const fr = locale === "fr";
const doc = await renderLibraryMarkdown("SPEC.md", locale);
const toc = doc?.headings.filter((h) => h.depth === 2 || h.depth === 3) ?? [];
---

<Base
  untranslated={!doc?.translated}
  title={zh ? ".mbmap 格式规范" : fr ? "Spécification du format .mbmap" : es ? "Especificación del formato .mbmap" : hi ? ".mbmap फ़ॉर्मैट विनिर्देश" : pt ? "Especificação do formato .mbmap" : "The .mbmap Format Specification"}
  description={zh ? ".mbmap 格式第 2 版：用于 Modbus 设备寄存器映射表的 JSON 格式。顶层键、寄存器、区域和地址、数据类型、字节序和字序，以及校验。" : fr ? "Le format .mbmap, version 2 : un format JSON pour les cartes de registres de périphériques Modbus. Clés de premier niveau, registres, zones et adresses, types de données, ordre des octets et des mots, et validation." : es ? "El formato .mbmap, versión 2: un formato JSON para mapas de registros de dispositivos Modbus. Claves de primer nivel, registros, áreas y direcciones, tipos de datos, orden de bytes y de palabras, y validación." : hi ? ".mbmap फ़ॉर्मैट, संस्करण 2: Modbus डिवाइस रजिस्टर मैप के लिए JSON फ़ॉर्मैट। शीर्ष-स्तर की कुंजियाँ, रजिस्टर, क्षेत्र और पते, डेटा प्रकार, बाइट और वर्ड क्रम, और सत्यापन।" : pt ? "O formato .mbmap, versão 2: um formato JSON para mapas de registos de dispositivos Modbus. Chaves de topo, registos, áreas e endereços, tipos de dados, ordem de bytes e de palavras, e validação." : "The .mbmap format, version 2: a JSON format for Modbus device register maps. Top-level keys, registers, areas and addresses, data types, byte and word order, and validation."}
  nav="spec"
>
  <header class="page-head">
    <p class="key">{zh ? "规范" : fr ? "Spécification" : es ? "Especificación" : hi ? "विनिर्देश" : pt ? "Especificação" : "Specification"}</p>
    <h1>{doc?.title ?? (zh ? ".mbmap 格式" : fr ? "Le format .mbmap" : es ? "El formato .mbmap" : hi ? ".mbmap फ़ॉर्मैट" : pt ? "O formato .mbmap" : "The .mbmap format")}</h1>
    <div class="actions">
      <a class="btn" href={LINKS.spec}><Icon name="github" /> {zh ? "GitHub 上的 SPEC.md" : fr ? "SPEC.md sur GitHub" : es ? "SPEC.md en GitHub" : hi ? "GitHub पर SPEC.md" : pt ? "SPEC.md no GitHub" : "SPEC.md on GitHub"}</a>
      <a class="btn" href={LINKS.schema}><Icon name="raw" /> JSON Schema</a>
      <a class="btn" href={LINKS.example}><Icon name="official" /> {zh ? "示例映射表" : fr ? "Carte d’exemple" : es ? "Mapa de ejemplo" : hi ? "उदाहरण मैप" : pt ? "Mapa de exemplo" : "Example map"}</a>
      <a class="btn" href={`${REPO_URL}/commits/${BRANCH}/SPEC.md`}>{zh ? "历史" : fr ? "Historique" : es ? "Historial" : hi ? "इतिहास" : pt ? "Histórico" : "History"}</a>
    </div>
  </header>

  {
    doc ? (
      <div class="spec">
        <nav class="toc card" aria-label={zh ? "目录" : fr ? "Sommaire" : es ? "Índice" : hi ? "विषय-सूची" : pt ? "Índice" : "Contents"}>
          <p class="key">{zh ? "目录" : fr ? "Sommaire" : es ? "Índice" : hi ? "विषय-सूची" : pt ? "Índice" : "Contents"}</p>
          <ol>
            {toc.map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`} data-toc={h.slug}>{h.text.replace(/`/g, "")}</a>
              </li>
            ))}
          </ol>
        </nav>
        <article class="card pad prose spec-body" set:html={doc.html} />
      </div>
    ) : (
      <section class="card pad empty">
        <strong>{zh ? "无法读取规范" : fr ? "La spécification n’a pas pu être lue" : es ? "No se pudo leer la especificación" : hi ? "विनिर्देश पढ़ा नहीं जा सका" : pt ? "Não foi possível ler a especificação" : "The specification could not be read"}</strong>
        {zh ? <>请在 GitHub 上阅读 <a href={LINKS.spec}>SPEC.md</a>。</> : fr ? <>Lisez <a href={LINKS.spec}>SPEC.md</a> sur GitHub.</> : es ? <>Lee <a href={LINKS.spec}>SPEC.md</a> en GitHub.</> : hi ? <>GitHub पर <a href={LINKS.spec}>SPEC.md</a> पढ़ें।</> : pt ? <>Leia o <a href={LINKS.spec}>SPEC.md</a> no GitHub.</> : <>Read <a href={LINKS.spec}>SPEC.md</a> on GitHub.</>}
      </section>
    )
  }
</Base>

<script>
  // Marks the section being read in the contents
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>("[data-toc]").forEach((a) => links.set(a.dataset.toc!, a));
  const heads = [...document.querySelectorAll<HTMLElement>(".spec-body h2[id], .spec-body h3[id]")];
  let current: HTMLElement | undefined;
  const mark = () => {
    const line = innerHeight * 0.25;
    let id = heads[0]?.id;
    for (const h of heads) {
      if (h.getBoundingClientRect().top <= line) id = h.id;
      else break;
    }
    const a = id ? links.get(id) : undefined;
    if (a === current) return;
    current?.removeAttribute("aria-current");
    a?.setAttribute("aria-current", "true");
    current = a;
    a?.scrollIntoView({ block: "nearest" });
  };
  addEventListener("scroll", mark, { passive: true });
  mark();
</script>

<style>
  .page-head {
    margin: 4px 0 18px;
  }

  .page-head .key {
    margin: 0 0 4px;
  }

  .page-head .actions {
    margin-top: 14px;
  }

  .spec {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .toc {
    position: sticky;
    top: calc(var(--bar-h) + 16px);
    max-height: calc(100vh - var(--bar-h) - 32px);
    overflow-y: auto;
    padding: 14px 10px;
    font-size: 13px;
  }

  .toc .key {
    margin: 0 8px 6px;
  }

  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc a {
    display: block;
    padding: 4px 8px;
    border-radius: 7px;
    color: var(--text-2);
    text-decoration: none;
    transition:
      background-color 0.14s var(--ease),
      color 0.14s var(--ease);
  }

  .toc .d3 a {
    padding-left: 20px;
    color: var(--text-3);
    font-size: 12.5px;
  }

  .toc a:hover {
    color: var(--text);
  }

  .toc a[aria-current] {
    background: var(--accent-soft);
    color: var(--text);
    font-weight: 500;
  }

  .spec-body {
    max-width: none;
  }

  .spec-body > :global(*) {
    max-width: 80ch;
  }

  .spec-body > :global(.table-wrap),
  .spec-body > :global(pre) {
    max-width: none;
  }

  .spec-body :global(h2),
  .spec-body :global(h3) {
    scroll-margin-top: calc(var(--bar-h) + 16px);
  }

  .spec-body :global(h2) {
    margin-top: 36px;
    padding-top: 20px;
    box-shadow: inset 0 1px 0 var(--border);
  }

  .spec-body :global(h2:first-child) {
    padding-top: 0;
    box-shadow: none;
  }

  .spec-body :global(.table-wrap) {
    margin: 0 0 16px;
  }

  .spec-body :global(.table.md) {
    font-size: 13px;
    line-height: 1.5;
  }

  .spec-body :global(.table.md td) {
    vertical-align: top;
  }

  .spec-body :global(.table.md td:first-child code) {
    white-space: nowrap;
  }

  .spec-body :global(pre.json) {
    max-height: none;
  }

  @media (max-width: 960px) {
    .spec {
      grid-template-columns: minmax(0, 1fr);
    }
    .toc {
      position: static;
      max-height: 300px;
    }
  }
</style>
