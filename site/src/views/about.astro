---
import { DEFAULT_LOCALE, PROSE_LOCALES, type Locale } from "../i18n/locales.ts";
import { statusLabel, statusLong } from "../i18n/labels.ts";
import { href } from "../lib/base.ts";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { STATUSES, STATUS_INFO, plural } from "../lib/mbmap.ts";
import { rawUrl, registry, REPO_URL } from "../lib/registry.ts";
import { LINKS, MODBENCH_URL, SITE_NAME } from "../lib/site.ts";

const { devices, manufacturers, statusCounts } = registry();
const example = `{
  "mbmap": 2,
  "vendor": "Example Corp",
  "model": "EM-100",
  "protocol": "rtu",
  "baudrate": 9600,
  "parity": "E",
  "word_order": "big",
  "registers": [
    {"name": "Voltage", "group": "Measurements", "area": "input", "address": 0, "type": "float32", "unit": "V"},
    {"name": "Active energy", "group": "Energy", "area": "holding", "address": 256, "type": "uint32", "scale": 0.01, "unit": "kWh", "word_order": "little"},
    {"name": "Reset energy", "group": "Commands", "area": "coil", "address": 0, "type": "bool", "access": "W"}
  ]
}`;

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const zh = locale === "zh";
const pt = locale === "pt";
---

<Base
  untranslated={!PROSE_LOCALES.includes(locale)}
  title={zh ? "关于 MBMap" : pt ? "Sobre o MBMap" : "About MBMap"}
  description={zh ? "MBMap 是一个开放的、由社区驱动的 Modbus 设备映射库，采用任何工具都可读取的同一种 JSON 格式。它是什么、格式如何运作以及如何参与贡献。" : pt ? "O MBMap é um registo aberto, mantido pela comunidade, de mapas de dispositivos Modbus num só formato JSON, legível por qualquer ferramenta. O que é, como funciona o formato e como contribuir." : "MBMap is an open, community-driven registry of Modbus device maps in one JSON format, readable by any tool. What it is, how the format works and how to contribute."}
  nav="about"
>
{zh ? (
<>
  <div class="about">
    <section class="card pad prose">
      <h1>关于 {SITE_NAME}</h1>
      <p class="lead">
        {SITE_NAME} 是一种开放格式，也是一个由社区共同维护的 Modbus 设备映射库：目前收录来自 {manufacturers.length} 家制造商的 {devices.length} 台设备，全部属于公有领域。
      </p>

      <h2>问题所在</h2>
      <p>
        读取 Modbus 设备要从它的寄存器映射表开始，而这张表通常藏在 PDF 手册里：一张包含地址、数据类型、比例系数和字节序的表格，每位工程师都要手工把它输入自己的工具。每个工具用自己的格式保存，于是同样的工作要为每台设备、在每个工具里、由每个使用者重复一遍。抄写中的错误（差一位的地址、颠倒的字序）会在现场表现为错误的数值。
      </p>

      <h2>{SITE_NAME} 做什么</h2>
      <p>
        一个 <code>.mbmap.json</code> 文件描述一种设备型号：谁制造它、如何连接它，以及每个寄存器的含义。映射表只需编写一次、核对一次，任何兼容的工具都可以加载它，变量已经命名、换算并标明类型。映射库把这些映射表集中存放在
        <a href={REPO_URL}>GitHub</a> 上，任何人都可以添加设备或更正内容。
      </p>

      <h2 id="format">格式如何运作</h2>
      <p>
        映射表是一份普通的 JSON 文档，配有 <a href={LINKS.schema}>JSON Schema</a>。顶层键给出制造商、型号和连接默认值（协议、单元 ID、串口设置、字节序和字序、地址基数）。每个寄存器都有名称、Modbus 区域（<code>coil</code>、<code>discrete</code>、<code>input</code>、<code>holding</code>）、地址和类型，还可以添加单位、比例、访问权限、写入限制，以及状态和位字段的对照表。每行一个寄存器，使每次修改都只是一行差异。
      </p>
      <pre><code>{example}</code></pre>
      <p>
        完整的规则，包括所有读取方都以同样方式报告的校验代码，见<a href={LINKS.spec}>规范（SPEC.md）</a>。
      </p>

      <h2 id="status">映射表有多可信</h2>
      <p>
        库中的每个映射表都在 <code>x_status</code> 中说明其来源。这是本库的约定，不属于格式本身，Modbench 会在每个映射表旁显示它。
      </p>
      <ul class="status-list">
        {
          STATUSES.map((s) => (
            <li>
              <span class={`status ${s}`}>
                <Icon name={s} /> {statusLabel(locale, s)}
              </span>
              <span>
                {statusLong(locale, s)} <span class="faint">（{statusCounts[s]} 个映射表）</span>
              </span>
            </li>
          ))
        }
      </ul>
      <p>
        许多非官方映射表是为了启动本库，从其他开放目录转换而来的，目前还没有人对照制造商文档检查过。无论状态如何，映射表都按现状提供：向运行中的设备写入之前，请对照制造商文档核对映射表。
      </p>

      <h2 id="modbench">{SITE_NAME} 和 Modbench</h2>
      <p>
        <a href={MODBENCH_URL}>Modbench</a> 是适用于 Windows、Linux 和 macOS 的 Modbus TCP/RTU 客户端，也是读取 {SITE_NAME} 映射表的主要工具。它可直接浏览和下载本库，按寄存器名称读写设备，根据映射表的型号和固件核对设备，还可以运行一个依照映射表构建的模拟设备。本网站是它在网页上的搭档：同样的映射表，同样的外观，用于在连接设备之前查找设备。
      </p>

      <h2 id="integrate">在您自己的工具中使用映射表</h2>
      <p>格式是开放的，任何工具都可以读取。所有内容都由仓库提供：</p>
      <ul>
        <li><a href={rawUrl("index.json")}><code>index.json</code></a> 列出每个映射表及其路径、大小、SHA-256、状态和寄存器数。</li>
        <li>每个映射表位于 <code>{rawUrl("maps/<vendor>/<model>.mbmap.json")}</code>。</li>
        <li>
          索引的签名副本发布在 <a href={`${REPO_URL}/tree/signed`}><code>signed</code></a> 分支上，应用可以据此核实所下载的映射表确实来自本库（参见 <a href={`${LINKS.contributing}#signed-index`}>签名索引</a>）。
        </li>
        <li><a href={LINKS.tests}><code>tests/</code></a> 文件夹包含示例文件和读取方必须报告的诊断信息，可用来对照规范检查实现。</li>
      </ul>
      <p>
        支持格式的一部分或全部，然后提交拉取请求，即可把您的工具列入<a href={href("/compatibility")}>兼容性页面</a>。
      </p>

      <h2>一个开放的社区项目</h2>
      <p>
        映射表、规范和工具均以 <a href={LINKS.license}>CC0 1.0</a> 贡献给公有领域：可用于任何用途，包括商业产品，无需征求许可。映射库因工程师、技术人员、集成商和制造商的贡献而不断壮大：新的映射表、更正，以及在真实硬件上的测试。
        <a href={href("/contribute")}>了解如何参与</a>。
      </p>
    </section>

    <aside class="card pad links" aria-label="链接">
      <h2 class="key">链接</h2>
      <ul>
        <li><a href={REPO_URL}><Icon name="github" /> GitHub 上的 mbmap-library</a></li>
        <li><a href={LINKS.spec}><Icon name="library" /> 规范（SPEC.md）</a></li>
        <li><a href={LINKS.schema}><Icon name="raw" /> JSON Schema</a></li>
        <li><a href={LINKS.contributing}><Icon name="plus" /> CONTRIBUTING.md</a></li>
        <li><a href={LINKS.example}><Icon name="official" /> 示例映射表</a></li>
        <li><a href={LINKS.discussions}><Icon name="about" /> 讨论区</a></li>
        <li><a href={MODBENCH_URL}><Icon name="registers" /> Modbench</a></li>
      </ul>
    </aside>
  </div>
</>
) : pt ? (
<>
  <div class="about">
    <section class="card pad prose">
      <h1>Sobre o {SITE_NAME}</h1>
      <p class="lead">
        O {SITE_NAME} é um formato aberto e um registo partilhado, mantido pela comunidade, de mapas de dispositivos Modbus: hoje {devices.length} dispositivos de {manufacturers.length} fabricantes, todos no domínio público.
      </p>

      <h2>O problema</h2>
      <p>
        Ler um dispositivo Modbus começa pelo seu mapa de registos, e esse mapa costuma estar num manual em PDF: uma tabela de endereços, tipos de dados, fatores de escala e ordens de bytes que cada engenheiro escreve à mão na sua própria ferramenta. Cada ferramenta guarda-o no seu formato, por isso o mesmo trabalho repete-se para cada dispositivo, em cada ferramenta, por cada pessoa que o usa. Os erros da cópia (um endereço desviado de um, uma ordem de palavras trocada) aparecem em obra como valores errados.
      </p>

      <h2>O que o {SITE_NAME} faz</h2>
      <p>
        Um ficheiro <code>.mbmap.json</code> descreve um modelo de dispositivo: quem o fabrica, como ligar-se a ele e o que significa cada registo. Escreve-se o mapa uma vez, confere-se, e qualquer ferramenta compatível pode carregá-lo com as variáveis já nomeadas, escaladas e tipadas. O registo reúne estes mapas num só lugar, no
        <a href={REPO_URL}>GitHub</a>, onde qualquer pessoa pode acrescentar um dispositivo ou corrigir um.
      </p>

      <h2 id="format">Como funciona o formato</h2>
      <p>
        Um mapa é um documento JSON simples com um <a href={LINKS.schema}>JSON Schema</a>. As chaves de topo indicam o fabricante, o modelo e os valores de ligação por omissão (protocolo, ID da unidade, definições série, ordem de bytes e de palavras, base dos endereços). Cada registo tem um nome, uma área Modbus (<code>coil</code>, <code>discrete</code>, <code>input</code>, <code>holding</code>), um endereço e um tipo, e pode acrescentar uma unidade, uma escala, direitos de acesso, limites de escrita e tabelas de tradução para estados e campos de bits. Um registo por linha faz de cada alteração uma diferença de uma só linha.
      </p>
      <pre><code>{example}</code></pre>
      <p>
        As regras completas, incluindo os códigos de validação que todos os leitores comunicam da mesma forma, estão na <a href={LINKS.spec}>especificação (SPEC.md)</a>.
      </p>

      <h2 id="status">Até onde se pode confiar num mapa</h2>
      <p>
        Cada mapa da biblioteca diz de onde vem em <code>x_status</code>. É uma convenção da biblioteca, não faz parte do formato, e o Modbench mostra-o junto a cada mapa.
      </p>
      <ul class="status-list">
        {
          STATUSES.map((s) => (
            <li>
              <span class={`status ${s}`}>
                <Icon name={s} /> {statusLabel(locale, s)}
              </span>
              <span>
                {statusLong(locale, s)} <span class="faint">({statusCounts[s]} mapas)</span>
              </span>
            </li>
          ))
        }
      </ul>
      <p>
        Muitos mapas não oficiais foram convertidos de outros catálogos abertos para arrancar a biblioteca, e ninguém os conferiu ainda com a documentação do fabricante. Seja qual for o estado, os mapas são fornecidos tal como estão: confira um mapa com a documentação do fabricante antes de escrever num dispositivo em serviço.
      </p>

      <h2 id="modbench">{SITE_NAME} e Modbench</h2>
      <p>
        O <a href={MODBENCH_URL}>Modbench</a> é um cliente Modbus TCP/RTU para Windows, Linux e macOS e a principal ferramenta que lê mapas {SITE_NAME}. Navega e descarrega esta biblioteca diretamente, lê e escreve num dispositivo pelo nome do registo, verifica o dispositivo com os modelos e o firmware do mapa e pode executar um dispositivo simulado à imagem de um mapa. Este sítio é o seu companheiro na web: os mesmos mapas e o mesmo aspeto, para encontrar um dispositivo antes de se ligar a ele.
      </p>

      <h2 id="integrate">Usar os mapas na sua própria ferramenta</h2>
      <p>O formato é aberto e qualquer ferramenta o pode ler. Tudo é servido a partir do repositório:</p>
      <ul>
        <li><a href={rawUrl("index.json")}><code>index.json</code></a> lista todos os mapas com o caminho, o tamanho, o SHA-256, o estado e o número de registos.</li>
        <li>Cada mapa está em <code>{rawUrl("maps/<vendor>/<model>.mbmap.json")}</code>.</li>
        <li>
          Uma cópia assinada do índice é publicada no ramo <a href={`${REPO_URL}/tree/signed`}><code>signed</code></a>, para que uma aplicação possa verificar que os mapas que descarrega são os da biblioteca (veja <a href={`${LINKS.contributing}#signed-index`}>Índice assinado</a>).
        </li>
        <li>A pasta <a href={LINKS.tests}><code>tests/</code></a> tem ficheiros de exemplo e os diagnósticos que um leitor deve comunicar, para conferir uma implementação com a especificação.</li>
      </ul>
      <p>
        Suporte parte do formato ou o formato todo e depois abra um pull request para listar a sua ferramenta na <a href={href("/compatibility")}>página de compatibilidade</a>.
      </p>

      <h2>Um projeto comunitário aberto</h2>
      <p>
        Os mapas, a especificação e as ferramentas estão dedicados ao domínio público ao abrigo da <a href={LINKS.license}>CC0 1.0</a>: use-os para qualquer fim, incluindo produtos comerciais, sem pedir autorização. O registo cresce com as contribuições de engenheiros, técnicos, integradores e fabricantes: novos mapas, correções e testes em hardware real.
        <a href={href("/contribute")}>Veja como ajudar</a>.
      </p>
    </section>

    <aside class="card pad links" aria-label="Ligações">
      <h2 class="key">Ligações</h2>
      <ul>
        <li><a href={REPO_URL}><Icon name="github" /> mbmap-library no GitHub</a></li>
        <li><a href={LINKS.spec}><Icon name="library" /> Especificação (SPEC.md)</a></li>
        <li><a href={LINKS.schema}><Icon name="raw" /> JSON Schema</a></li>
        <li><a href={LINKS.contributing}><Icon name="plus" /> CONTRIBUTING.md</a></li>
        <li><a href={LINKS.example}><Icon name="official" /> Mapa de exemplo</a></li>
        <li><a href={LINKS.discussions}><Icon name="about" /> Discussões</a></li>
        <li><a href={MODBENCH_URL}><Icon name="registers" /> Modbench</a></li>
      </ul>
    </aside>
  </div>
</>
) : (
<>
  <div class="about">
    <section class="card pad prose">
      <h1>About {SITE_NAME}</h1>
      <p class="lead">
        {SITE_NAME} is an open format and a shared, community-maintained registry of Modbus device maps:
        {plural(devices.length, "device")} from {plural(manufacturers.length, "manufacturer")} today, all in the public domain.
      </p>

      <h2>The problem</h2>
      <p>
        Reading a Modbus device starts with its register map, and that map usually lives in a PDF manual: a table of
        addresses, data types, scale factors and byte orders that every engineer types into their own tool by hand. Each
        tool stores it in its own format, so the same work is repeated for every device, in every tool, by everyone who
        uses it. Mistakes in the copy (an address off by one, a swapped word order) show up as wrong values on site.
      </p>

      <h2>What {SITE_NAME} does</h2>
      <p>
        A <code>.mbmap.json</code> file describes one device model: who makes it, how to connect to it and what every
        register means. Write the map once, check it, and any compatible tool can load it with the variables already named,
        scaled and typed. The registry collects these maps in one place, on
        <a href={REPO_URL}>GitHub</a>, where anyone can add a device or correct one.
      </p>

      <h2 id="format">How the format works</h2>
      <p>
        A map is a plain JSON document with a <a href={LINKS.schema}>JSON Schema</a>. Top-level keys give the manufacturer,
        the model and the connection defaults (protocol, unit id, serial settings, byte and word order, address base).
        Each register has a name, a Modbus area (<code>coil</code>, <code>discrete</code>, <code>input</code>,
        <code>holding</code>), an address and a type, and may add a unit, a scale, access rights, write limits, translation
        tables for states and bit fields. One register per line keeps every change a one-line diff.
      </p>
      <pre><code>{example}</code></pre>
      <p>
        The full rules, including validation codes every reader reports the same way, are in the
        <a href={LINKS.spec}>specification (SPEC.md)</a>.
      </p>

      <h2 id="status">How far a map can be trusted</h2>
      <p>
        Every map in the library says where it comes from in <code>x_status</code>. It is a library convention, not part of
        the format, and Modbench shows it next to each map.
      </p>
      <ul class="status-list">
        {
          STATUSES.map((s) => (
            <li>
              <span class={`status ${s}`}>
                <Icon name={s} /> {STATUS_INFO[s].label}
              </span>
              <span>
                {STATUS_INFO[s].long} <span class="faint">({statusCounts[s]} maps)</span>
              </span>
            </li>
          ))
        }
      </ul>
      <p>
        Many unofficial maps were converted from other open catalogues to get the library started, and nobody has checked them
        against the manufacturer's documentation yet. Whatever the status, the maps are provided as is: check a map against
        the manufacturer's documentation before you write to a live device.
      </p>

      <h2 id="modbench">{SITE_NAME} and Modbench</h2>
      <p>
        <a href={MODBENCH_URL}>Modbench</a> is a Modbus TCP/RTU client for Windows, Linux and macOS, and the main tool
        that reads {SITE_NAME} maps. It browses and downloads this library directly, reads and writes a device by register
        name, checks the device against the map's models and firmware, and can run a simulated device shaped after a map.
        This website is its companion on the web: the same maps and the same look, for finding a device before you connect to it.
      </p>

      <h2 id="integrate">Using the maps in your own tool</h2>
      <p>The format is open and any tool can read it. Everything is served from the repository:</p>
      <ul>
        <li><a href={rawUrl("index.json")}><code>index.json</code></a> lists every map with its path, size, SHA-256, status and register count.</li>
        <li>Each map is at <code>{rawUrl("maps/<vendor>/<model>.mbmap.json")}</code>.</li>
        <li>
          A signed copy of the index is published on the <a href={`${REPO_URL}/tree/signed`}><code>signed</code></a> branch,
          so an app can check that the maps it downloads are the library's (see <a href={`${LINKS.contributing}#signed-index`}>Signed index</a>).
        </li>
        <li>The <a href={LINKS.tests}><code>tests/</code></a> folder has sample files and the diagnostics a reader must report, to check an implementation against the spec.</li>
      </ul>
      <p>
        Support part of the format or all of it, then open a pull request to list your tool on the
        <a href={href("/compatibility")}>compatibility page</a>.
      </p>

      <h2>An open community project</h2>
      <p>
        The maps, the specification and the tools are dedicated to the public domain under <a href={LINKS.license}>CC0 1.0</a>:
        use them for anything, including commercial products, without asking. The registry grows with contributions from
        engineers, technicians, integrators and manufacturers: new maps, corrections and tests on real hardware.
        <a href={href("/contribute")}>Here is how to help</a>.
      </p>
    </section>

    <aside class="card pad links" aria-label="Links">
      <h2 class="key">Links</h2>
      <ul>
        <li><a href={REPO_URL}><Icon name="github" /> mbmap-library on GitHub</a></li>
        <li><a href={LINKS.spec}><Icon name="library" /> Specification (SPEC.md)</a></li>
        <li><a href={LINKS.schema}><Icon name="raw" /> JSON Schema</a></li>
        <li><a href={LINKS.contributing}><Icon name="plus" /> CONTRIBUTING.md</a></li>
        <li><a href={LINKS.example}><Icon name="official" /> Example map</a></li>
        <li><a href={LINKS.discussions}><Icon name="about" /> Discussions</a></li>
        <li><a href={MODBENCH_URL}><Icon name="registers" /> Modbench</a></li>
      </ul>
    </aside>
  </div>
</>
)}
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 16px;
    align-items: start;
  }

  .about h1 {
    margin-bottom: 4px;
  }

  .about .lead {
    margin-bottom: 8px;
  }

  .status-list {
    list-style: none;
    padding: 0 !important;
  }

  .status-list li {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 12px;
  }

  .links {
    position: sticky;
    top: calc(var(--bar-h) + 16px);
  }

  .links ul {
    margin: 8px -8px 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 8px;
    border-radius: 8px;
    text-decoration: none;
  }

  .links a:hover {
    background: var(--accent-soft);
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
    .links {
      position: static;
    }
    .status-list li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
