} as const;

// de text of the cards, in the order of `cards`.
const cardsDe = {
  add: { title: "Ein neues Gerät hinzufügen", text: "Schreiben Sie eine Map nach der öffentlichen Dokumentation des Herstellers, prüfen Sie sie mit dem Validator und eröffnen Sie einen Pull Request.", links: ["So fügen Sie eine Map hinzu", "Beispielmap"] },
  request: { title: "Ein Gerät anfragen", text: "Sie können die Map nicht selbst schreiben? Fragen Sie sie an, am besten mit einem Link zur Modbus-Dokumentation des Herstellers.", links: ["Eine Map anfragen"] },
