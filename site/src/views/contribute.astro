---
import { DEFAULT_LOCALE, PROSE_LOCALES, type Locale } from "../i18n/locales.ts";
import { statusLabel } from "../i18n/labels.ts";
import { href } from "../lib/base.ts";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { STATUS_INFO } from "../lib/mbmap.ts";
import { LINKS } from "../lib/site.ts";

const cards = [
  {
    id: "add",
    icon: "plus",
    title: "Add a new device",
    text: "Write a map from the manufacturer's public documentation, check it with the validator and open a pull request.",
    links: [
      { href: `${LINKS.contributing}#adding-a-map`, label: "How to add a map", primary: true },
      { href: LINKS.example, label: "Example map" },
    ],
  },
  {
    id: "request",
    icon: "issue",
    title: "Request a device",
    text: "Can't write the map yourself? Ask for it, ideally with a link to the manufacturer's Modbus documentation.",
    links: [{ href: LINKS.mapRequest, label: "Request a map", primary: true }],
  },
  {
    id: "verify",
    icon: "verified",
    title: "Verify a map on real hardware",
    text: "Read a device with a map and compare the values with its display. Report the result, good or bad, even if you did not write the map.",
    links: [
      { href: LINKS.testReport, label: "Report a test", primary: true },
      { href: `${LINKS.contributing}#reporting-a-test`, label: "What to check" },
    ],
  },
  {
    id: "correct",
    icon: "edit",
    title: "Report or fix incorrect data",
    text: "A wrong address, type, scale or byte order? Every device page has “Suggest a correction”, which edits the file on GitHub and opens a pull request, and “Report a problem”.",
    links: [
      { href: `${LINKS.contributing}#changing-a-map`, label: "Changing a map", primary: true },
      { href: LINKS.issues, label: "Open issues" },
    ],
  },
  {
    id: "check",
    icon: "official",
    title: "Check an unofficial map",
    text: "Compare a converted map with the manufacturer's manual, fix what is wrong and record the document you used. It then becomes official.",
    links: [
      { href: `${LINKS.contributing}#checking-and-correcting-an-unofficial-map`, label: "How to check one", primary: true },
      { href: href("/devices?status=unofficial"), label: "Unofficial maps" },
    ],
  },
  {
    id: "docs",
    icon: "library",
    title: "Improve the documentation",
    text: "Questions about the format, ideas for it, or a tool that reads .mbmap files: start a discussion, or propose a change to the docs.",
    links: [
      { href: LINKS.qa, label: "Ask a question", primary: true },
      { href: LINKS.ideas, label: "Suggest an idea" },
      { href: LINKS.showAndTell, label: "Show a tool" },
    ],
  },
] as const;
// Simplified Chinese text of the cards, in the order of `cards`.
const cardsZh = {
  add: { title: "添加新设备", text: "根据制造商的公开文档编写映射表，用校验器检查，然后提交拉取请求。", links: ["如何添加映射表", "示例映射表"] },
  request: { title: "请求添加设备", text: "自己无法编写映射表？提出请求，最好附上制造商 Modbus 文档的链接。", links: ["请求映射表"] },
  verify: { title: "在真实硬件上验证映射表", text: "用映射表读取设备，并将数值与设备显示屏对照。无论结果好坏，即使映射表不是您编写的，也请报告结果。", links: ["报告测试结果", "需要核对什么"] },
  correct: { title: "报告或修正错误数据", text: "地址、类型、比例或字节序有误？每个设备页面都有“建议更正”（在 GitHub 上编辑文件并创建拉取请求）和“报告问题”。", links: ["修改映射表", "未解决的 issue"] },
  check: { title: "检查非官方映射表", text: "将转换而来的映射表与制造商手册对照，修正错误并记录所用文档。它随后会成为官方映射表。", links: ["如何检查", "非官方映射表"] },
  docs: { title: "改进文档", text: "对格式有疑问、有想法，或有读取 .mbmap 文件的工具：发起一个讨论，或提出对文档的修改。", links: ["提问", "提出想法", "展示工具"] },
} as const;

// Portuguese text of the cards, in the order of `cards`.
const cardsPt = {
  add: { title: "Acrescentar um dispositivo novo", text: "Escreva um mapa a partir da documentação pública do fabricante, confira-o com o validador e abra um pull request.", links: ["Como acrescentar um mapa", "Mapa de exemplo"] },
  request: { title: "Pedir um dispositivo", text: "Não consegue escrever o mapa? Peça-o, de preferência com uma ligação para a documentação Modbus do fabricante.", links: ["Pedir um mapa"] },
  verify: { title: "Verificar um mapa em hardware real", text: "Leia um dispositivo com um mapa e compare os valores com o seu visor. Comunique o resultado, bom ou mau, mesmo que não tenha escrito o mapa.", links: ["Comunicar um teste", "O que conferir"] },
  correct: { title: "Comunicar ou corrigir dados errados", text: "Um endereço, tipo, escala ou ordem de bytes errados? Cada página de dispositivo tem “Sugerir uma correção”, que edita o ficheiro no GitHub e abre um pull request, e “Comunicar um problema”.", links: ["Alterar um mapa", "Issues abertas"] },
  check: { title: "Conferir um mapa não oficial", text: "Compare um mapa convertido com o manual do fabricante, corrija o que estiver errado e registe o documento que usou. Passa então a oficial.", links: ["Como conferir um", "Mapas não oficiais"] },
  docs: { title: "Melhorar a documentação", text: "Dúvidas sobre o formato, ideias para ele, ou uma ferramenta que lê ficheiros .mbmap: abra uma discussão ou proponha uma alteração à documentação.", links: ["Fazer uma pergunta", "Sugerir uma ideia", "Mostrar uma ferramenta"] },
} as const;

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const zh = locale === "zh";
const pt = locale === "pt";
---

<Base
  untranslated={!PROSE_LOCALES.includes(locale)}
  title={zh ? "参与贡献" : pt ? "Contribuir" : "Contribute"}
  description={zh ? "添加 Modbus 设备映射表、更正寄存器，或报告在真实硬件上的测试。MBMap 映射表存放在 GitHub 上，向所有人开放。" : pt ? "Acrescente um mapa de dispositivo Modbus, corrija um registo ou comunique um teste em hardware real. Os mapas MBMap estão no GitHub e são abertos a todos." : "Add a Modbus device map, correct a register, or report a test on real hardware. MBMap maps live on GitHub and are open to everyone."}
  nav="contribute"
>
{zh ? (
<>
  <header class="page-head">
    <h1>参与贡献</h1>
    <p class="lead">
      一个好的映射表能让下一个人省去对着 PDF 手册折腾一下午。所有映射表都存放在 GitHub 上的 <a href={LINKS.repo}>mbmap-library</a> 仓库中；每一项贡献都通过它完成。
    </p>
  </header>

  <div class="ways">
    {
      cards.map((c) => (
        <section class="card pad way" id={c.id} aria-labelledby={`${c.id}-t`}>
          <Icon name={c.icon} size={18} />
          <h2 id={`${c.id}-t`}>{cardsZh[c.id].title}</h2>
          <p class="muted">{cardsZh[c.id].text}</p>
          <div class="actions">
            {c.links.map((l, i) => (
              <a class={`btn${"primary" in l && l.primary ? " primary" : ""}`} href={l.href}>{cardsZh[c.id].links[i]}</a>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <section class="card pad prose diff" aria-labelledby="diff-t">
    <h2 id="diff-t">提交映射表与验证映射表</h2>
    <p>
      <strong>提交</strong>是添加或修改一个文件：您根据某个来源编写寄存器，并在 <code>sources</code> 中说明来源。根据制造商文档编写的映射表是
      <span class="status official"><Icon name="official" size={14} /> {statusLabel(locale, "official")}</span>；从其他目录、论坛或第三方集成复制而来的则是
      <span class="status unofficial"><Icon name="unofficial" size={14} /> {statusLabel(locale, "unofficial")}</span>。
    </p>
    <p>
      <strong>验证</strong>是在真实设备上测试现有的映射表：读取它，将数值与设备显示屏或其自带软件对照（每个寄存器分组至少核对一个值，以及 32 位数值的字节序和字序），并报告您使用的设备、固件和连接方式。只有这样，映射表才会成为
      <span class="status verified"><Icon name="verified" size={14} /> {statusLabel(locale, "verified")}</span>。任何人都可以验证映射表；您不必是它的作者。发现问题的测试同样有用：请报告它，以免该映射表被标记为已验证。
    </p>

    <h2>提交拉取请求之前</h2>
    <ul>
      <li>文件命名为 <code>maps/&lt;vendor&gt;/&lt;model&gt;.mbmap.json</code>，使用小写的 slug，例如 <code>maps/acme-meters/pm-200.mbmap.json</code>。</li>
      <li>运行校验器并修正所有错误：<code>python tools/validate/validate.py maps/&lt;vendor&gt;/&lt;model&gt;.mbmap.json</code></li>
      <li>重建索引：<code>python tools/index/build_index.py</code></li>
      <li>当修改会影响设备的读取或写入方式时，增加 <code>revision</code>。</li>
    </ul>

    <h2>规则</h2>
    <ul>
      <li><strong>只用公开信息。</strong>不得使用受保密协议约束或标明机密的文档中的任何内容。</li>
      <li><strong>不要复制手册。</strong>地址、类型和单位是事实；说明请用自己的话撰写。</li>
      <li><strong>不含私人数据。</strong>不得包含真实安装现场的 IP 地址、序列号或现场名称。</li>
      <li><strong>准确优先于全面。</strong>如果对某个寄存器没有把握，请省略它或注明。</li>
    </ul>
    <p>
      完整指南见 <a href={LINKS.contributing}>CONTRIBUTING.md</a>。参与贡献即表示您同意以 <a href={LINKS.license}>CC0 1.0</a> 发布您的贡献。
    </p>
  </section>
</>
) : pt ? (
<>
  <header class="page-head">
    <h1>Contribuir</h1>
    <p class="lead">
      Um bom mapa poupa à pessoa seguinte uma tarde com um manual em PDF. Todos os mapas estão no repositório <a href={LINKS.repo}>mbmap-library</a>, no GitHub; todas as contribuições passam por ele.
    </p>
  </header>

  <div class="ways">
    {
      cards.map((c) => (
        <section class="card pad way" id={c.id} aria-labelledby={`${c.id}-t`}>
          <Icon name={c.icon} size={18} />
          <h2 id={`${c.id}-t`}>{cardsPt[c.id].title}</h2>
          <p class="muted">{cardsPt[c.id].text}</p>
          <div class="actions">
            {c.links.map((l, i) => (
              <a class={`btn${"primary" in l && l.primary ? " primary" : ""}`} href={l.href}>{cardsPt[c.id].links[i]}</a>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <section class="card pad prose diff" aria-labelledby="diff-t">
    <h2 id="diff-t">Submeter um mapa e verificar um mapa</h2>
    <p>
      <strong>Submeter</strong> acrescenta ou altera um ficheiro: escreve os registos a partir de uma fonte e indica qual em <code>sources</code>. Um mapa escrito a partir da documentação do fabricante é
      <span class="status official"><Icon name="official" size={14} /> {statusLabel(locale, "official")}</span>; um copiado de outro catálogo, de um fórum ou de uma integração de terceiros é
      <span class="status unofficial"><Icon name="unofficial" size={14} /> {statusLabel(locale, "unofficial")}</span>.
    </p>
    <p>
      <strong>Verificar</strong> é testar um mapa existente num dispositivo real: lê-lo, comparar os valores com o visor do dispositivo ou com o seu próprio software (pelo menos um valor por grupo de registos, e a ordem de bytes e de palavras de um valor de 32 bits) e comunicar o dispositivo, o firmware e a ligação que usou. Só então um mapa passa a
      <span class="status verified"><Icon name="verified" size={14} /> {statusLabel(locale, "verified")}</span>. Qualquer pessoa pode verificar um mapa; não precisa de ser o seu autor. Um teste que encontra problemas é igualmente útil: comunique-o para que o mapa não fique marcado como verificado.
    </p>

    <h2>Antes de abrir um pull request</h2>
    <ul>
      <li>Dê ao ficheiro o nome <code>maps/&lt;vendor&gt;/&lt;model&gt;.mbmap.json</code> com slugs em minúsculas, por exemplo <code>maps/acme-meters/pm-200.mbmap.json</code>.</li>
      <li>Execute o validador e corrija todos os erros: <code>python tools/validate/validate.py maps/&lt;vendor&gt;/&lt;model&gt;.mbmap.json</code></li>
      <li>Reconstrua o índice: <code>python tools/index/build_index.py</code></li>
      <li>Aumente <code>revision</code> quando uma alteração afeta a forma como um dispositivo é lido ou escrito.</li>
    </ul>

    <h2>Regras</h2>
    <ul>
      <li><strong>Só informação pública.</strong> Nada de documentos sob NDA ou marcados como confidenciais.</li>
      <li><strong>Não copie manuais.</strong> Endereços, tipos e unidades são factos; escreva as descrições por palavras suas.</li>
      <li><strong>Sem dados privados.</strong> Sem endereços IP, números de série nem nomes de instalações reais.</li>
      <li><strong>Mais vale rigor do que cobertura.</strong> Se tem dúvidas sobre um registo, deixe-o de fora ou diga-o.</li>
    </ul>
    <p>
      O guia completo é o <a href={LINKS.contributing}>CONTRIBUTING.md</a>. Ao contribuir, aceita publicar a sua contribuição ao abrigo da <a href={LINKS.license}>CC0 1.0</a>.
    </p>
  </section>
</>
) : (
<>
  <header class="page-head">
    <h1>Contribute</h1>
    <p class="lead">
      A good map saves the next person an afternoon with a PDF manual. All maps live in the
      <a href={LINKS.repo}>mbmap-library</a> repository on GitHub; every contribution goes through it.
    </p>
  </header>

  <div class="ways">
    {
      cards.map((c) => (
        <section class="card pad way" id={c.id} aria-labelledby={`${c.id}-t`}>
          <Icon name={c.icon} size={18} />
          <h2 id={`${c.id}-t`}>{c.title}</h2>
          <p class="muted">{c.text}</p>
          <div class="actions">
            {c.links.map((l) => (
              <a class={`btn${"primary" in l && l.primary ? " primary" : ""}`} href={l.href}>{l.label}</a>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <section class="card pad prose diff" aria-labelledby="diff-t">
    <h2 id="diff-t">Submitting a map and verifying a map</h2>
    <p>
      <strong>Submitting</strong> adds or changes a file: you write the registers from a source, and say which in
      <code>sources</code>. A map written from the manufacturer's documentation is
      <span class="status official"><Icon name="official" size={14} /> {STATUS_INFO.official.label}</span>; one copied from
      another catalogue, a forum or a third-party integration is
      <span class="status unofficial"><Icon name="unofficial" size={14} /> {STATUS_INFO.unofficial.label}</span>.
    </p>
    <p>
      <strong>Verifying</strong> is testing an existing map on a real device: read it, compare the values with the device's
      display or its own software (at least one value per register group, and the byte and word order of a 32-bit value), and
      report the device, firmware and connection you used. Only then does a map become
      <span class="status verified"><Icon name="verified" size={14} /> {STATUS_INFO.verified.label}</span>. Anyone can verify
      a map; you do not need to be its author. A test that finds problems is just as useful: report it so the map is not
      marked as verified.
    </p>

    <h2>Before you open a pull request</h2>
    <ul>
      <li>Name the file <code>maps/&lt;vendor&gt;/&lt;model&gt;.mbmap.json</code> with lowercase slugs, e.g. <code>maps/acme-meters/pm-200.mbmap.json</code>.</li>
      <li>Run the validator and fix every error: <code>python tools/validate/validate.py maps/&lt;vendor&gt;/&lt;model&gt;.mbmap.json</code></li>
      <li>Rebuild the index: <code>python tools/index/build_index.py</code></li>
      <li>Increase <code>revision</code> when a change affects how a device is read or written.</li>
    </ul>

    <h2>Rules</h2>
    <ul>
      <li><strong>Only public information.</strong> Nothing from documents under NDA or marked confidential.</li>
      <li><strong>Do not copy manuals.</strong> Addresses, types and units are facts; write descriptions in your own words.</li>
      <li><strong>No private data.</strong> No IP addresses, serial numbers or site names from a real installation.</li>
      <li><strong>Prefer accuracy over coverage.</strong> If you are unsure about a register, leave it out or say so.</li>
    </ul>
    <p>
      The full guide is <a href={LINKS.contributing}>CONTRIBUTING.md</a>. By contributing, you agree to release your
      contribution under <a href={LINKS.license}>CC0 1.0</a>.
    </p>
  </section>
</>
)}
</Base>

<style>
  .page-head {
    margin: 4px 0 16px;
  }

  .page-head .lead {
    max-width: 72ch;
  }

  .ways {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 16px;
  }

  .way {
    display: flex;
    flex-direction: column;
    scroll-margin-top: calc(var(--bar-h) + 16px);
  }

  .way h2 {
    margin: 10px 0 4px;
    font-size: 15px;
  }

  .way p {
    flex: 1;
    margin: 0 0 14px;
    font-size: 13.5px;
  }

  .way:target {
    box-shadow:
      var(--e2),
      0 0 0 2px var(--text);
  }

  .diff {
    max-width: none;
    margin-top: 16px;
  }

  .diff > * {
    max-width: 80ch;
  }

  .diff .status {
    display: inline-flex;
    vertical-align: -2px;
  }
</style>
