// tr text of the cards, in the order of `cards`.
const cardsTr = {
  add: { title: "Yeni bir cihaz ekleyin", text: "Üreticinin herkese açık belgelerinden bir harita yazın, doğrulayıcıyla kontrol edin ve bir pull request açın.", links: ["Harita nasıl eklenir", "Örnek harita"] },
  request: { title: "Bir cihaz isteyin", text: "Haritayı kendiniz yazamıyor musunuz? İsteyin, mümkünse üreticinin Modbus belgesine bir bağlantıyla.", links: ["Bir harita isteyin"] },
  verify: { title: "Bir haritayı gerçek donanımda doğrulayın", text: "Bir cihazı bir haritayla okuyun ve değerleri ekranıyla karşılaştırın. Haritayı siz yazmamış olsanız bile sonucu, iyi ya da kötü, bildirin.", links: ["Bir test bildirin", "Neler doğrulanır"] },
  correct: { title: "Yanlış verileri bildirin veya düzeltin", text: "Yanlış bir adres, tür, ölçek veya bayt sırası mı? Her cihaz sayfasında, dosyayı GitHub'da düzenleyip bir pull request açan “Düzeltme öner” ve “Sorun bildir” vardır.", links: ["Bir haritayı düzenleyin", "Açık issue'lar"] },
  check: { title: "Gayriresmi bir haritayı doğrulayın", text: "Dönüştürülmüş bir haritayı üreticinin kılavuzuyla karşılaştırın, yanlış olanı düzeltin ve kullandığınız belgeyi not edin. Böylece harita resmi olur.", links: ["Nasıl doğrulanır", "Gayriresmi haritalar"] },
  docs: { title: "Belgelendirmeyi iyileştirin", text: "Biçimle ilgili sorular, ona dair fikirler ya da .mbmap dosyalarını okuyan bir araç: bir tartışma açın veya belgelerde bir değişiklik önerin.", links: ["Bir soru sorun", "Bir fikir önerin", "Bir aracı tanıtın"] },
