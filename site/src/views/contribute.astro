---
import { DEFAULT_LOCALE, PROSE_LOCALES, type Locale } from "../i18n/locales.ts";
import { statusLabel } from "../i18n/labels.ts";
import { href } from "../lib/base.ts";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { STATUS_INFO } from "../lib/mbmap.ts";
import { LINKS } from "../lib/site.ts";

const cards = [
  {
    id: "add",
    icon: "plus",
    title: "Add a new device",
    text: "Write a map from the manufacturer's public documentation, check it with the validator and open a pull request.",
    links: [
      { href: `${LINKS.contributing}#adding-a-map`, label: "How to add a map", primary: true },
      { href: LINKS.example, label: "Example map" },
    ],
  },
  {
    id: "request",
    icon: "issue",
    title: "Request a device",
    text: "Can't write the map yourself? Ask for it, ideally with a link to the manufacturer's Modbus documentation.",
    links: [{ href: LINKS.mapRequest, label: "Request a map", primary: true }],
  },
  {
    id: "verify",
    icon: "verified",
    title: "Verify a map on real hardware",
    text: "Read a device with a map and compare the values with its display. Report the result, good or bad, even if you did not write the map.",
    links: [
      { href: LINKS.testReport, label: "Report a test", primary: true },
      { href: `${LINKS.contributing}#reporting-a-test`, label: "What to check" },
    ],
  },
  {
    id: "correct",
    icon: "edit",
    title: "Report or fix incorrect data",
    text: "A wrong address, type, scale or byte order? Every device page has “Suggest a correction”, which edits the file on GitHub and opens a pull request, and “Report a problem”.",
    links: [
      { href: `${LINKS.contributing}#changing-a-map`, label: "Changing a map", primary: true },
      { href: LINKS.issues, label: "Open issues" },
    ],
  },
  {
    id: "check",
    icon: "official",
    title: "Check an unofficial map",
    text: "Compare a converted map with the manufacturer's manual, fix what is wrong and record the document you used. It then becomes official.",
    links: [
      { href: `${LINKS.contributing}#checking-and-correcting-an-unofficial-map`, label: "How to check one", primary: true },
      { href: href("/devices?status=unofficial"), label: "Unofficial maps" },
    ],
  },
  {
    id: "docs",
    icon: "library",
    title: "Improve the documentation",
    text: "Questions about the format, ideas for it, or a tool that reads .mbmap files: start a discussion, or propose a change to the docs.",
    links: [
      { href: LINKS.qa, label: "Ask a question", primary: true },
      { href: LINKS.ideas, label: "Suggest an idea" },
      { href: LINKS.showAndTell, label: "Show a tool" },
    ],
  },
] as const;
// Simplified Chinese text of the cards, in the order of `cards`.
const cardsZh = {
  add: { title: "添加新设备", text: "根据制造商的公开文档编写映射表，用校验器检查，然后提交拉取请求。", links: ["如何添加映射表", "示例映射表"] },
  request: { title: "请求添加设备", text: "自己无法编写映射表？提出请求，最好附上制造商 Modbus 文档的链接。", links: ["请求映射表"] },
  verify: { title: "在真实硬件上验证映射表", text: "用映射表读取设备，并将数值与设备显示屏对照。无论结果好坏，即使映射表不是您编写的，也请报告结果。", links: ["报告测试结果", "需要核对什么"] },
  correct: { title: "报告或修正错误数据", text: "地址、类型、比例或字节序有误？每个设备页面都有“建议更正”（在 GitHub 上编辑文件并创建拉取请求）和“报告问题”。", links: ["修改映射表", "未解决的 issue"] },
  check: { title: "检查非官方映射表", text: "将转换而来的映射表与制造商手册对照，修正错误并记录所用文档。它随后会成为官方映射表。", links: ["如何检查", "非官方映射表"] },
  docs: { title: "改进文档", text: "对格式有疑问、有想法，或有读取 .mbmap 文件的工具：发起一个讨论，或提出对文档的修改。", links: ["提问", "提出想法", "展示工具"] },
} as const;

// Portuguese text of the cards, in the order of `cards`.
const cardsPt = {
  add: { title: "Acrescentar um dispositivo novo", text: "Escreva um mapa a partir da documentação pública do fabricante, confira-o com o validador e abra um pull request.", links: ["Como acrescentar um mapa", "Mapa de exemplo"] },
  request: { title: "Pedir um dispositivo", text: "Não consegue escrever o mapa? Peça-o, de preferência com uma ligação para a documentação Modbus do fabricante.", links: ["Pedir um mapa"] },
  verify: { title: "Verificar um mapa em hardware real", text: "Leia um dispositivo com um mapa e compare os valores com o seu visor. Comunique o resultado, bom ou mau, mesmo que não tenha escrito o mapa.", links: ["Comunicar um teste", "O que conferir"] },
  correct: { title: "Comunicar ou corrigir dados errados", text: "Um endereço, tipo, escala ou ordem de bytes errados? Cada página de dispositivo tem “Sugerir uma correção”, que edita o ficheiro no GitHub e abre um pull request, e “Comunicar um problema”.", links: ["Alterar um mapa", "Issues abertas"] },
  check: { title: "Conferir um mapa não oficial", text: "Compare um mapa convertido com o manual do fabricante, corrija o que estiver errado e registe o documento que usou. Passa então a oficial.", links: ["Como conferir um", "Mapas não oficiais"] },
  docs: { title: "Melhorar a documentação", text: "Dúvidas sobre o formato, ideias para ele, ou uma ferramenta que lê ficheiros .mbmap: abra uma discussão ou proponha uma alteração à documentação.", links: ["Fazer uma pergunta", "Sugerir uma ideia", "Mostrar uma ferramenta"] },
} as const;

// Hindi text of the cards, in the order of `cards`.
const cardsHi = {
  add: { title: "नया डिवाइस जोड़ें", text: "निर्माता के सार्वजनिक दस्तावेज़ों से मैप लिखें, वैलिडेटर से जाँचें और pull request खोलें।", links: ["मैप कैसे जोड़ें", "उदाहरण मैप"] },
  request: { title: "डिवाइस माँगें", text: "मैप खुद नहीं लिख सकते? उसे माँगें, बेहतर होगा निर्माता के Modbus दस्तावेज़ की कड़ी के साथ।", links: ["मैप माँगें"] },
  verify: { title: "असली हार्डवेयर पर मैप सत्यापित करें", text: "किसी मैप से डिवाइस को पढ़ें और मानों की तुलना उसकी स्क्रीन से करें। नतीजा, अच्छा या बुरा, ज़रूर बताएँ, भले ही मैप आपने न लिखा हो।", links: ["परीक्षण की रिपोर्ट करें", "क्या जाँचें"] },
  correct: { title: "गलत डेटा की रिपोर्ट करें या ठीक करें", text: "गलत पता, प्रकार, स्केल या बाइट क्रम? हर डिवाइस पेज पर “सुधार सुझाएँ” है, जो GitHub पर फ़ाइल संपादित करके pull request खोलता है, और “समस्या बताएँ” भी।", links: ["मैप बदलना", "खुले issue"] },
  check: { title: "अनौपचारिक मैप जाँचें", text: "बदलकर लाए गए मैप की तुलना निर्माता के मैनुअल से करें, जो गलत है उसे ठीक करें और जिस दस्तावेज़ का उपयोग किया उसे दर्ज करें। तब वह आधिकारिक बन जाता है।", links: ["किसी को कैसे जाँचें", "अनौपचारिक मैप"] },
  docs: { title: "दस्तावेज़ीकरण सुधारें", text: "फ़ॉर्मैट के बारे में प्रश्न, उसके लिए विचार, या .mbmap फ़ाइलें पढ़ने वाला टूल: चर्चा शुरू करें, या दस्तावेज़ों में बदलाव प्रस्तावित करें।", links: ["प्रश्न पूछें", "विचार सुझाएँ", "टूल दिखाएँ"] },
} as const;

// Spanish text of the cards, in the order of `cards`.
const cardsEs = {
  add: { title: "Añadir un dispositivo nuevo", text: "Escribe un mapa a partir de la documentación pública del fabricante, compruébalo con el validador y abre una pull request.", links: ["Cómo añadir un mapa", "Mapa de ejemplo"] },
  request: { title: "Solicitar un dispositivo", text: "¿No puedes escribir el mapa tú mismo? Pídelo, a ser posible con un enlace a la documentación Modbus del fabricante.", links: ["Solicitar un mapa"] },
  verify: { title: "Verificar un mapa en hardware real", text: "Lee un dispositivo con un mapa y compara los valores con su pantalla. Informa del resultado, bueno o malo, aunque no hayas escrito el mapa.", links: ["Informar de una prueba", "Qué comprobar"] },
  correct: { title: "Informar de datos incorrectos o corregirlos", text: "¿Una dirección, tipo, escala u orden de bytes incorrectos? Cada página de dispositivo tiene «Sugerir una corrección», que edita el archivo en GitHub y abre una pull request, e «Informar de un problema».", links: ["Modificar un mapa", "Issues abiertas"] },
  check: { title: "Comprobar un mapa no oficial", text: "Compara un mapa convertido con el manual del fabricante, corrige lo que esté mal y anota el documento que usaste. Pasa entonces a ser oficial.", links: ["Cómo comprobar uno", "Mapas no oficiales"] },
  docs: { title: "Mejorar la documentación", text: "Preguntas sobre el formato, ideas para él, o una herramienta que lee archivos .mbmap: abre un debate o propón un cambio en la documentación.", links: ["Hacer una pregunta", "Sugerir una idea", "Mostrar una herramienta"] },
} as const;

// French text of the cards, in the order of `cards`.
const cardsFr = {
  add: { title: "Ajouter un nouveau périphérique", text: "Écrivez une carte à partir de la documentation publique du fabricant, vérifiez-la avec le validateur et ouvrez une pull request.", links: ["Comment ajouter une carte", "Carte d’exemple"] },
  request: { title: "Demander un périphérique", text: "Vous ne pouvez pas écrire la carte vous-même ? Demandez-la, de préférence avec un lien vers la documentation Modbus du fabricant.", links: ["Demander une carte"] },
  verify: { title: "Vérifier une carte sur du matériel réel", text: "Lisez un périphérique avec une carte et comparez les valeurs avec son afficheur. Signalez le résultat, bon ou mauvais, même si vous n’avez pas écrit la carte.", links: ["Signaler un test", "Que vérifier"] },
  correct: { title: "Signaler ou corriger des données incorrectes", text: "Une adresse, un type, une échelle ou un ordre d’octets incorrects ? Chaque page de périphérique a « Suggérer une correction », qui modifie le fichier sur GitHub et ouvre une pull request, et « Signaler un problème ».", links: ["Modifier une carte", "Issues ouvertes"] },
  check: { title: "Vérifier une carte non officielle", text: "Comparez une carte convertie avec le manuel du fabricant, corrigez ce qui est faux et notez le document utilisé. Elle devient alors officielle.", links: ["Comment en vérifier une", "Cartes non officielles"] },
