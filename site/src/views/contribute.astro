// Bengali text of the cards, in the order of `cards`.
const cardsBn = {
  add: { title: "নতুন ডিভাইস যোগ করুন", text: "নির্মাতার প্রকাশ্য নথি থেকে একটি ম্যাপ লিখুন, ভ্যালিডেটর দিয়ে যাচাই করুন এবং একটি pull request খুলুন।", links: ["কীভাবে ম্যাপ যোগ করবেন", "উদাহরণ ম্যাপ"] },
