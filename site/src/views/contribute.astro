  correct: { title: "Falsche Daten melden oder korrigieren", text: "Eine falsche Adresse, ein falscher Typ, eine falsche Skalierung oder Bytereihenfolge? Jede Geräteseite hat „Korrektur vorschlagen“, was die Datei auf GitHub bearbeitet und einen Pull Request öffnet, sowie „Problem melden“.", links: ["Eine Map bearbeiten", "Offene Issues"] },
  check: { title: "Eine inoffizielle Map prüfen", text: "Vergleichen Sie eine umgewandelte Map mit dem Handbuch des Herstellers, korrigieren Sie, was falsch ist, und vermerken Sie das verwendete Dokument. Dann wird sie offiziell.", links: ["So prüfen Sie eine", "Inoffizielle Maps"] },
  docs: { title: "Die Dokumentation verbessern", text: "Fragen zum Format, Ideen dafür oder ein Werkzeug, das .mbmap-Dateien liest: Eröffnen Sie eine Diskussion oder schlagen Sie eine Änderung der Dokumentation vor.", links: ["Eine Frage stellen", "Eine Idee vorschlagen", "Ein Werkzeug vorstellen"] },
