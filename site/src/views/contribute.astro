const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const zh = locale === "zh";
const pt = locale === "pt";
const hi = locale === "hi";
const es = locale === "es";
const fr = locale === "fr";
const bn = locale === "bn";
const ru = locale === "ru";
const de = locale === "de";
const tr = locale === "tr";
---

<Base
  untranslated={!PROSE_LOCALES.includes(locale)}
