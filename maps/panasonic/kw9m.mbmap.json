  "source": "Panasonic KW9M Eco-POWER METER User's Manual, section 7.4 MODBUS (RTU) communication",
  "sources": [
    {
      "title": "KW9M Eco-POWER METER User's Manual",
      "url": "https://mediap.industry.panasonic.eu/assets/custom-upload/Factory%20&%20Automation/Eco-POWER%20METERS/Manuals/mn_kw9m_user_jp_en.pdf",
      "note": "Section 7.4.2, Data Register List (MODBUS communication)"
    }
