    "fronius_state": {"1": "Off", "2": "Sleeping", "3": "Starting", "4": "Running (MPPT)", "5": "Throttled", "6": "Shutting down", "7": "Fault", "8": "Standby", "9": "No SolarNet communication", "10": "No communication with inverter", "11": "Overcurrent on SolarNet plug", "12": "Inverter being updated", "13": "AFCI event"},
    "disabled_enabled": {"0": "Disabled", "1": "Enabled"},
    "model_type": {"1": "Float", "2": "Integer with scale factors"},
    "der_type": {"4": "PV"}
