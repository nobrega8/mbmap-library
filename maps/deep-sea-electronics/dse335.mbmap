# DSE335 automatic transfer switch controller, GenComm protocol.
# Address = page * 256 + offset. Pages 6, 7, 154, 170, 171, 180 and 190 use the
# 3xx / 335 layouts. Expansion module rows read as unimplemented when no module
# is fitted.
# Checked on a real DSE335 (RS485, 9600 8N2) on 2026-10-13: status, battery,
# S1 voltages and frequency, phase rotation and clock read correctly.
@mbmap=1
@vendor=Deep Sea Electronics
@model=DSE335
@description=Automatic transfer switch controller (3xx family), GenComm Modbus protocol. S1 and S2 are the two supplies; Load is the switched output
@source=Deep Sea Electronics, "GenComm standard for use with generating set control equipment" v2.272 (2025-07-21): sections 8.1 (sentinels) and 10 (pages 3, 4, 6, 7, 16, 154, 170, 171, 180, 190)
@protocol=rtu
@parity=N
@databits=8
@stopbits=2
@byte_order=ABCD
@address_base=0
@max_read_registers=125
@sentinel_uint16=0xFFFF=Unimplemented|0xFFFE=Over measurable range|0xFFFD=Under measurable range|0xFFFC=Transducer fault|0xFFFB=Bad data|0xFFFA=High digital input|0xFFF9=Low digital input
@sentinel_int16=0x7FFF=Unimplemented|0x7FFE=Over measurable range|0x7FFD=Under measurable range|0x7FFC=Transducer fault|0x7FFB=Bad data|0x7FFA=High digital input|0x7FF9=Low digital input
@sentinel_uint32=0xFFFFFFFF=Unimplemented|0xFFFFFFFE=Over measurable range|0xFFFFFFFD=Under measurable range|0xFFFFFFFC=Transducer fault|0xFFFFFFFB=Bad data|0xFFFFFFFA=High digital input|0xFFFFFFF9=Low digital input
@sentinel_int32=0x7FFFFFFF=Unimplemented|0x7FFFFFFE=Over measurable range|0x7FFFFFFD=Under measurable range|0x7FFFFFFC=Transducer fault|0x7FFFFFFB=Bad data|0x7FFFFFFA=High digital input|0x7FFFFFF9=Low digital input
@enum_control_mode=0=Stop|1=Auto|2=Manual|3=Test on load|4=Auto with manual restore|5=User configuration|6=Test off load|7=Off
@enum_phase_rotation=0=Indeterminate|1=L1-L2-L3|2=L3-L2-L1|3=Phase error
@enum_sm_status=0=Implemented, not changed|1=Implemented, changed|2=Reserved|3=Unimplemented
@enum_alarm_condition=0=Disabled digital input|1=Not active|2=Warning|3=Shutdown|4=Electrical trip|8=Inactive indication|9=Inactive indication (displayed)|10=Active indication|15=Unimplemented
@enum_sender_category=0=Unused|1=Pressure|2=Temperature|3=Level|4=Digital
@enum_system_control=0x8B74748B=Select Stop mode|0x8B75748A=Select Auto mode|0x8B767489=Select Manual mode|0x8B777488=Select Test on load mode|0x8B787487=Select Auto with manual restore mode|0x8B797486=Start engine if in manual or test modes|0x8B7A7485=Mute alarm|0x8B7B7484=Reset alarms|0x8B7C7483=Transfer to generator|0x8B7D7482=Transfer to mains|0x8B7E7481=Reset mains failure|0x8B7F7480=Close Bus (Bus Tie Controller)|0x8B80747F=Open Bus (Bus Tie Controller)|0x8B81747E=Toggle Bus Open/Closed (Bus Tie Controller)|0x8B82747D=Scroll through mode selections (mode button on 330/331/334/335)|0x8B83747C=Enable selected mode (scroll button on 330/331/334/335)|0x8B84747B=Mimic Mode Button Action (G8600 only)|0x8B94746B=Telemetry start if in auto mode|0x8B95746A=Cancel telemetry start in auto mode|0x8B967469=Reset alarms|0x8B977468=Clear telemetry alarm flag|0x8B987467=Lock the user controls|0x8B997466=Unlock the user controls|0x8B9A7465=Reset the maintenance alarm 1 due times|0x8B9B7464=MSC alarm inhibit on|0x8B9C7463=MSC alarm inhibit off|0x8B9D7462=Reset the maintenance alarm 2 due times|0x8B9E7461=Reset the maintenance alarm 3 due times|0x8BA2745D=Start data logging (temporarily overrides the module state)|0x8BA3745C=Stop data logging (temporarily overrides the module state)|0x8BA4745B=Erase all data log files internal to the module (NOT on USB)|0x8BA5745A=Force USB drive to stop logging, ready to eject|0x8BB67449=Reset battery maintenance alarm 1|0x8BB77448=Reset battery maintenance alarm 2|0x8BB87447=Reset battery maintenance alarm 3|0x8BB97446=Auto DPF regeneration inhibit on|0x8BBA7445=Auto DPF regeneration inhibit off|0x8BBB7444=Start manual DPF regeneration|0x8BBC7443=Battery Charger Boost Mode|0x8BBD7442=Battery Charger Stop Charging|0x8BBE7441=Battery Charger Battery Test|0x8BBF7440=Battery Charger Select Alternative Charging Voltage|0x8BC0743F=Select Off Mode|0x8BC1743E=Throttle Down|0x8BC2743D=Throttle Up|0x8BC3743C=Wake ECU|0x8BC4743B=Lamp Test|0x8BC5743A=Battery Charger Auxiliary Boost Mode|0x8BC67439=Battery Charger Auxiliary Stop Charging|0x8BC77438=Battery Charger Auxiliary Battery Test|0x8BC87437=Battery Charger Auxiliary Select Alternative Charging Voltage|0x8BC97436=Stop manual DPF regeneration|0x8BCA7435=DSE Proprietary|0x8BCB7434=Battery Charger Max Current Mode Timed|0x8BCC7433=Battery Charger max Current Mode Manual|0x8BCD7432=AVR Droop Enable|0x8BCE7431=AVR Droop Disable|0x8BCF7430=Governor Droop Enable|0x8BD0742F=Governor Droop Disable|0x8BD1742E=Remote Mains Fail Enable|0x8BD2742D=Remote Mains Fail Disable|0x8BD3742C=Remote Mains Fail Toggle (on then off, leaving the alarm latched but able to be reset)|0x8BD4742B=Enable signal injection|0x8BD5742A=Disable signal injection|0x8BD77428=Reset maintenance alarm 4 due times|0x8BD87427=Reset maintenance alarm 5 due times|0x8BD97426=Battery Charger Stop Charging Out 1|0x8BDA7425=Battery Charger Stop Charging Out 2|0x8BDB7424=Battery Charger Stop Charging Out 1 and Out 2|0x8BDC7423=Reset maintenance alarm 6 due times|0x8BDD7422=Reset maintenance alarm 7 due times|0x8BDE7421=Reset maintenance alarm 8 due times|0x8BDF7420=Reset maintenance alarm 9 due times|0x8BE0741F=Reset maintenance alarm 10 due times|0x8BE1741E=Switch to Multi Set platform (G8600 only)|0x8BE2741D=Switch to Single Set platform (G8600 only)|0x8BE3741C=Switch to Mains Parallel platform (G8600 or G8660)|0x8BE4741B=Switch to Group Controller platform (G8600 or G8660)

