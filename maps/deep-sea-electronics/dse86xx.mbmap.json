  "address_base": 0,
  "max_read_registers": 125,
  "x_status": "unofficial",
  "enums": {
    "phase_rotation": {"0": "Indeterminate", "1": "L1-L2-L3", "2": "L3-L2-L1", "3": "Phase error"},
    "alarm_condition": {"0": "Disabled digital input", "1": "Not active", "2": "Warning", "3": "Shutdown", "4": "Electrical trip", "8": "Inactive indication", "9": "Inactive indication (displayed)", "10": "Active indication", "15": "Unimplemented"}
  },
  "sentinels": {
    "uint16": {"0xFFFF": "Unimplemented", "0xFFFE": "Over measurable range", "0xFFFD": "Under measurable range", "0xFFFC": "Transducer fault", "0xFFFB": "Bad data", "0xFFFA": "High digital input", "0xFFF9": "Low digital input"},
    "int16": {"0x7FFF": "Unimplemented", "0x7FFE": "Over measurable range", "0x7FFD": "Under measurable range", "0x7FFC": "Transducer fault", "0x7FFB": "Bad data", "0x7FFA": "High digital input", "0x7FF9": "Low digital input"},
