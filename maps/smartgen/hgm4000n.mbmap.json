  "vendor_website": "smartgen.cn",
  "description": "Genset controller (HGM4010N auto start, HGM4020N AMF): mains and generator values, engine sensors, alarms, status and remote commands",
  "revision": 1,
  "source": "SmartGen, HGM4000N Genset Controller Communication Protocol",
  "sources": [
    {
      "title": "HGM4000N Genset Controller Communication Protocol",
      "url": "https://www.smartgen.cn/yun/data/download/HGM4000N_Protocol_en.pdf",
      "accessed": "2026-11-14",
      "sha256": "6b73b406553d3579f34f895015c08f77e8aacaf429a28a62caaffb3c80ea1028",
      "note": "function code 01H, 03H and 05H tables"
    }
  ],
  "notes": [
    "Modbus RTU over RS485, slave only. Address 1 to 254 (default 1); 2400 to 115200 baud (default 9600), 8 data bits, no parity by default, 1 stop bit. Up to 120 registers per read; allow more than 200 ms for the answer.",
    "Status bits are coils read with function 01; remote commands are coils at the same addresses written with function 05 (0xFF00), each sent once. Values are holding registers read with 03.",
    "Addresses are the 'Modbus Address' column of the manual (the PLC address less 1).",
    "Written from the manufacturer's document; not tested on a device."
  ],
  "protocol": "rtu",
  "unit_id": 1,
  "baudrate": 9600,
  "parity": "N",
  "databits": 8,
  "stopbits": 1,
  "byte_order": "big",
  "address_base": 0,
  "x_status": "official",
