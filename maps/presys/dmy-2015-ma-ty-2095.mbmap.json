    "parity": {"0": "None", "1": "Even", "2": "Odd"},
    "decimals": {"0": "No decimals", "1": "1 decimal", "2": "2 decimals", "3": "3 decimals"},
    "input_type": {"0": "Current 20 mA", "1": "Channel disabled"}
  },
