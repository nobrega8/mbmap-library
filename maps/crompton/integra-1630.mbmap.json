    {
      "title": "Integra 1630 Communications Guide",
      "version": "Issue 7 (Nov-17)",
      "url": "https://www.crompton-instruments.com/installation_docs/Integra_1630_Communications_Guide_Iss_7.pdf",
      "note": "Section 1: Modbus implementation, input registers (1.2) and holding registers (1.3)",
      "accessed": "2026-11-15",
