{
  "$schema": "https://raw.githubusercontent.com/nobrega8/mbmap-library/main/schema/mbmap-2.schema.json",
  "mbmap": 2,
  "vendor": "Datakom",
  "model": "D-300 to D-700 genset controllers",
  "models": [
    "D-300",
    "D-500",
    "D-700"
  ],
  "vendor_website": "datakom.com.tr",
  "description": "Genset controllers: mains and genset voltages, currents, powers, power factors and frequency, battery and sensor readings, harmonics, operating status and mode, counters, energies and pushbutton commands",
  "revision": 1,
  "firmware": "5.6",
  "source": "Datakom, D-300 / 500 / 700 Modbus Application Manual, V5.6 (25.04.2016)",
  "sources": [
    {
      "title": "D-300 / 500 / 700 Modbus Application Manual",
      "version": "V5.6 (25.04.2016)",
      "url": "https://www.datakom.com.tr/upload/Files/500_MODBUS.pdf",
      "accessed": "2026-11-15",
      "sha256": "8222940774f059a875e73c313f7c781285b122400fe71eb09b164f95f73eb407"
    }
  ],
  "notes": [
    "Modbus RTU over RS485 or RS232 (2400 to 115200 baud, 8 data bits, no parity, 1 stop bit) and Modbus TCP on Ethernet models. Read with function 03 (up to 16 registers), write with 06 or 16; address 1 to 240.",
    "Addresses are those of the manual, as sent.",
    "32-bit values are high word first. The manual does not say which values are signed; powers, power factors and temperatures are taken as signed here.",
    "The manual's page with the energy and fuel counters appears twice with different addresses; this map keeps the first table (11569 on).",
    "Not in this map: the alarm bit arrays (10504-10551), digital input, output and LED status arrays, function flags, the scopemeter and LCD buffers.",
    "Written from the manufacturer's manual; not tested on a device."
  ],
  "protocol": "tcp+rtu",
  "parity": "N",
  "databits": 8,
  "stopbits": 1,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
