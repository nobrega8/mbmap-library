    {"name": "Energy reset", "group": "Settings", "area": "holding", "address": "0x0002", "type": "int16", "access": "W", "enum": {"1": "Clear energy"}},
    {"name": "Network type", "group": "Settings", "area": "holding", "address": "0x0003", "type": "int16", "access": "RW", "enum": {"0": "3-phase 4-wire", "1": "3-phase 3-wire"}},
    {"name": "CT ratio", "group": "Settings", "area": "holding", "address": "0x0006", "type": "int16", "access": "RW", "description": "1-9999"},
    {"name": "VT ratio", "group": "Settings", "area": "holding", "address": "0x0007", "type": "int16", "scale": 0.1, "access": "RW", "description": "0.1-999.9"},
    {"name": "Display rotation time", "group": "Settings", "area": "holding", "address": "0x000A", "type": "int16", "unit": "s", "access": "RW"},
