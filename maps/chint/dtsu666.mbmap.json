{
  "$schema": "https://raw.githubusercontent.com/nobrega8/mbmap-library/main/schema/mbmap-2.schema.json",
  "mbmap": 2,
  "vendor": "Chint",
  "model": "DTSU666 / DSSU666",
  "vendor_website": "chintglobal.com",
  "description": "Three-phase DIN rail energy meter with RS485 (DTSU666 four-wire, DSSU666 three-wire), bidirectional",
  "revision": 1,
  "source": "Chint, \"DTSU666.001 / DSSU666.001 series User Manual\", ZTW0.464.0104 (2023-11-14); https://www.chintglobal.com/content/dam/chint/global/product-center/instruments-meters/electricity-meter/din-rail-meter/dtsu666/manual/DTSU666%20DSSU666%20User%20Manual.pdf",
  "notes": [
    "Chint DTSU666 (three-phase four-wire) and DSSU666 (three-phase three-wire) DIN rail energy meters, Modbus RTU.",
    "This is the meter often supplied with solar inverters as a grid meter.",
    "Measurements and energies are IEEE 754 floats (ABCD). The electricity data block is in raw units: apply the scale column (e.g. a voltage of 2301.5 means 230.15 V).",
    "All values are on the secondary side: with CTs or VTs, multiply by the CT ratio (0x0006) and the VT ratio (0x0007 x 0.1).",
    "Rows marked \"4-wire only\" read nothing useful on a DSSU666 / three-wire connection."
  ],
  "protocol": "rtu",
  "unit_id": 1,
  "baudrate": 9600,
  "parity": "N",
  "databits": 8,
  "stopbits": 1,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
