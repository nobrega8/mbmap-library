# Active Power (Piller Power Systems) CleanSource CS XT and CS HD flywheel UPS.
# Read-only (FC03). 32-bit values: the lower register holds bits 15-0, so the
# word order is low word first (CDAB); read both registers in one request.
@mbmap=1
@vendor=Active Power (Piller Power Systems)
@model=CS XT / CS HD
@vendor_website=piller.com
@description=CleanSource CS XT and CS HD flywheel UPS
@source=Active Power, a Division of Piller Power Systems Inc., "CS XT / CS HD Modbus Register Map", 6090618-1 Rev. E (2019)
@protocol=tcp+rtu
@byte_order=CDAB
@address_base=0
@enum_output_source=0=Unknown|1=Flywheel discharging|2=No output|3=Online mode|4=Bypass mode|5=Battery discharge mode

name,group,area,address,type,length,scale,offset,unit,access,byte_order,bit,bits,enum,description
