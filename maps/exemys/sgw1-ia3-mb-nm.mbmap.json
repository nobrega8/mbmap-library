  "models": [
    "SGW1-IA3-MB-NM"
  ],
  "vendor_website": "exemys.com",
  "description": "NMEA 0183 to Modbus converter: position, speed, course, depth, wind, water speed, heading, temperatures and rudder angle from the sentences of marine instruments",
  "revision": 1,
  "source": "Exemys, SGW1-IA3-MB-NM User's Manual, Rev. 9",
  "sources": [
    {
      "title": "SGW1-IA3-MB-NM User's Manual",
      "version": "Rev. 9",
      "url": "https://www.exemys.com/beta/docs/english/SGW1-IA3-MB-NM_UM_E.pdf",
      "note": "chapter Modbus registers",
      "accessed": "2026-11-15",
      "sha256": "2ced2dc6c8bc3ef5e9a1d44e1a2144e0958f1baf73f792e1ff743d5abd69bcfa"
    }
  ],
  "notes": [
    "NMEA 0183 talker to Modbus slave converter: the registers of each NMEA sentence (GGA, VTG, MWV, XDR, VHW, ROT, VBW, DPT, HDM, ZDA, HDT, RMC, RMB, APB, DBT, MTW, MTA, RSA, VDO and others) hold the fields of the last sentence received.",
    "Modbus RTU and Modbus TCP; the Modbus slave ID for the internal register memory is set in the configuration.",
    "Register numbers are those of the manual (40001 is the first holding register), counted from 1 (address_base 1).",
    "32-bit values are two registers, the first holding the lower part and the second the upper part (low word first).",
    "Values the source does not send read as 0. Latitude and longitude are degrees multiplied by 10,000,000 (signed); ASCII registers hold the character code.",
    "Written from the manufacturer's manual; not tested on a device."
  ],
  "protocol": "tcp+rtu",
  "port": 502,
  "byte_order": "big",
  "word_order": "little",
  "address_base": 1,
  "x_status": "official",
