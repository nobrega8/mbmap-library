  "models": [
    "RMS1-AI"
  ],
  "vendor_website": "exemys.com",
  "description": "Serial analog acquisition module, 8 inputs 0-10 V or 4-20 mA, Modbus RTU slave: analog values, current input status, scaled values, converter counts, input type, average and scaling",
  "revision": 1,
  "source": "Exemys, RMS1-AI Manual de Usuario, Rev. 4",
  "sources": [
    {
      "title": "RMS1-AI Manual de Usuario",
      "version": "Rev. 4",
      "url": "https://exemys.com.ar/beta/docs/spanish/RMS1_AI_UM_S.pdf",
      "note": "Modbus register table",
      "accessed": "2026-11-15",
      "sha256": "186bb14b23b9b94e52fb9fccfa4dbcf790c457ddd76331b6f5d3132fb544f50b"
    }
  ],
  "notes": [
    "Modbus RTU slave on RS-232 or RS-485 (the serial port is set with the configuration console: 9600 bit/s, 8 data bits, no parity, 1 stop bit by default).",
    "The module can also work as a Hostlink master; this map is for the Modbus slave mode.",
    "Analog values are the input in volts or milliamps multiplied by 100. The status registers read 0 on inputs configured as voltage.",
    "Register numbers are those of the manual (40001 is the first holding register), counted from 1 (address_base 1).",
    "Written from the manufacturer's manual (in Spanish); not tested on a device."
  ],
  "protocol": "rtu",
  "byte_order": "big",
  "word_order": "big",
  "address_base": 1,
  "x_status": "official",
