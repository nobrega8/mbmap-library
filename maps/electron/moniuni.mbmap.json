    {"title": "Mapa de Registradores – Protocolo Modbus RTU: Monitor Universal de Sinais MoniUni", "version": "3.2", "url": "https://electron.com.br/api/downloads/file/mapa_de_registradores_moniuni_modbus_rtu_pt-br_v3-2.pdf", "note": "linked in issue #138"}
