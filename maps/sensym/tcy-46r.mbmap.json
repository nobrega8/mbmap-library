    "alarm_action": {"0": "Normally open", "1": "Normally closed"},
    "lock": {"0": "No level locked", "1": "Level V", "2": "Levels V and IV", "3": "Levels V, IV and III", "4": "Levels V, IV, III and II", "5": "Levels V, IV, III, II and I"},
    "sensor": {"0": "Pt-100", "1": "Ni-120", "2": "Thermocouple B", "3": "Thermocouple E", "4": "Thermocouple J", "5": "Thermocouple K", "6": "Thermocouple N", "7": "Thermocouple R", "8": "Thermocouple S", "9": "Thermocouple T", "10": "0 to 50 mV", "11": "0 to 5 V", "12": "1 to 5 V", "13": "0 to 10 V", "14": "0 to 20 mA", "15": "4 to 20 mA"},
    "baud": {"0": "2400", "1": "4800", "2": "9600", "3": "19200", "4": "38400"},
