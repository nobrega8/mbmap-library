    "enabled": {"0": "Disabled", "1": "Enabled"},
    "availability": {"0": "Inoperative", "1": "Operative"},
    "yes_no": {"0": "No", "1": "Yes"},
    "phases": {"1": "1 phase", "3": "3 phases"},
    "meter_type": {"0": "RTU", "1": "TCP/IP", "2": "UDP", "3": "P1", "4": "Other"}
  },
