  "vendor_website": "daikin.eu",
  "description": "Modbus RTU interface (P1P2) for Daikin Altherma LT heat pumps: setpoints, operation mode, DHW, quiet and weather-dependent modes, error codes, pump, compressor and heater status, water and refrigerant temperatures and flow",
  "revision": 1,
  "source": "Daikin, DCOM-LT/MB reference and installation manual (English)",
  "sources": [
    {
      "title": "DCOM-LT/MB – Reference manual",
      "url": "https://www.daikin.eu/content/dam/document-library/installation-manuals/ctrl/bms/dcom-lt-mb/DCOM-LT-MB_reference%20and%20installation%20manual_English.pdf",
      "note": "holding and input register tables",
      "accessed": "2026-11-15",
      "sha256": "ff718941c65ed91cb9c4081c7756d5f9f2feba0fee2a3f2211517b898d0bc54b"
    }
  ],
  "notes": [
    "Modbus RTU over RS485: 9600 baud, 8 data bits, no parity, 1 stop bit; address set with DIP switch SW1. Functions 03, 04, 06 and 16, up to 64 registers per request.",
    "Addresses are the DCOM register offsets, sent as they are (Modicon 40001 + offset or 30001 + offset).",
    "Temperatures in the input registers are temp16: signed, divided by 100. Setpoints are whole °C. A register reads 32767 when the unit does not support it, 32766 when it is not available in the current configuration and 32765 while its value is still loading.",
    "The manual also lists a second, different set of offsets on a later page; this map follows the main tables.",
    "Written from the manufacturer's manual; not tested on a device."
  ],
  "protocol": "rtu",
  "baudrate": 9600,
  "parity": "N",
  "databits": 8,
  "stopbits": 1,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
  "sentinels": {
    "int16": {
      "32767": "Register unsupported",
      "32766": "Register unavailable",
      "32765": "Wait for value"
    }
  },
