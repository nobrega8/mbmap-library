    {"name": "Baud rate", "group": "Settings", "area": "holding", "address": "0x0003", "type": "uint16", "unit": "bps", "access": "RW", "description": "The value is the speed itself: 1200, 2400, 4800 or 9600 (default 9600)"},
    {"name": "Pulse output constant", "group": "Settings", "area": "holding", "address": "0x0009", "type": "float32", "access": "RW", "description": "Pulses per kWh (the manual writes 10 as 41 20 00 00 to 40010)"},
