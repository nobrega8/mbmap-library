# Lovato Electric DCRG8 digital power factor controller.
# Addresses are as in the protocol tables; the wire address is one less.
# FC06 and FC16 work only on addresses above 1000H.
@mbmap=1
@vendor=Lovato Electric
@model=DCRG8
@vendor_website=lovatoelectric.com
@description=Digital power factor controller (DCRG8 series). Values marked single/three phase depend on how the controller is wired and programmed
@source=Lovato Electric, "DCRG8 Series Modbus Communication Protocol", doc. I432IGB05_20 (2020-05-20), tables 2-9; from firmware revision 4
@protocol=tcp+rtu
@unit_id=1
@port=1001
@baudrate=9600
@parity=N
@databits=8
@stopbits=1
@byte_order=ABCD
@address_base=1
@max_read_registers=80
@enum_step_status=0=Not inserted|1=Inserted|2=Not configured|3=Moving
@enum_cap_ind=0=Capacitive|1=Inductive
@enum_command=1=Reset partial energy|2=Reset external counter|3=Reset limits|4=Reset max temperature|5=Reset capacitor overload|6=Reset step insertion time|7=Reset step insertion count|8=Reset step trimming|9=Reset total energy|10=Restore test mode|11=Reset events log|12=Setup to default|13=Backup parameters|14=Restore parameters|15=Reset week TPF|16=Reset maintenance 1|17=Reset maintenance 2|18=Reset maintenance 3

name,group,area,address,type,length,scale,offset,unit,access,byte_order,bit,bits,enum,description
