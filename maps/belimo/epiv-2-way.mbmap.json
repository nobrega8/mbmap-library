    {
      "title": "2-way EPIV Modbus interface description",
      "version": "V4.2 (2025-09)",
      "url": "https://www.belimo.com/mam/general-documents/system_integration/Modbus/belimo_Modbus-Register_2way-EPIV_V4_2_en-gb.pdf",
      "note": "Modbus register description",
