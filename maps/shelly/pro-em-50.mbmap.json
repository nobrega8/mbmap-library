    {"name": "Total returned active energy 2", "group": "Energy 2", "area": "input", "address": 2324, "type": "float32", "unit": "Wh"},
    {"name": "Lagging reactive energy 2", "group": "Energy 2", "area": "input", "address": 2326, "type": "float32", "unit": "varh"},
    {"name": "Leading reactive energy 2", "group": "Energy 2", "area": "input", "address": 2328, "type": "float32", "unit": "varh"},
    {"name": "Total active energy (perpetual) 2", "group": "Energy 2", "area": "input", "address": 2330, "type": "float32", "unit": "Wh", "description": "Never reset"},
    {"name": "Total returned active energy (perpetual) 2", "group": "Energy 2", "area": "input", "address": 2332, "type": "float32", "unit": "Wh", "description": "Never reset"}
  ]
