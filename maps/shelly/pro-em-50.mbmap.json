    "Pro EM-50"
  ],
  "vendor_website": "shelly.com",
  "description": "Two-channel energy meter with a relay output and Modbus TCP",
  "revision": 1,
  "revised": "2026-10-18",
  "source": "Shelly Gen2 API documentation: Modbus and component pages",
  "sources": [
    {
      "title": "Shelly Gen2 API: Modbus",
      "url": "https://shelly-api-docs.shelly.cloud/gen2/ComponentsAndServices/Modbus"
    },
    {
      "title": "Shelly Gen2 API: EM1",
      "url": "https://shelly-api-docs.shelly.cloud/gen2/ComponentsAndServices/EM1",
      "note": "Modbus registers table"
    },
    {
      "title": "Shelly Gen2 API: EM1Data",
      "url": "https://shelly-api-docs.shelly.cloud/gen2/ComponentsAndServices/EM1Data",
      "note": "Modbus registers table"
    },
    {
      "title": "Shelly Gen2 API: Switch",
      "url": "https://shelly-api-docs.shelly.cloud/gen2/ComponentsAndServices/Switch",
      "note": "Modbus registers table"
    }
  ],
  "notes": [
    "Modbus TCP must be enabled first (Modbus.SetConfig enable=true, or in the web interface).",
    "The documentation lists input registers in 3xxxx notation: 33000 is input register 3000.",
    "Floats and 32-bit values are sent low word first, as in the documentation's modbus_cli examples (-B mixed).",
    "The two channels are the EM1 components 0 and 1; each next component's block starts 20 registers after the previous one (EM1 at 32000, EM1Data at 32300)."
  ],
  "protocol": "tcp",
  "port": 502,
  "byte_order": "big",
  "word_order": "little",
  "address_base": 0,
  "x_status": "official",
  "registers": [
    {"name": "MAC address", "group": "Device", "area": "input", "address": 0, "type": "string", "length": 6},
    {"name": "Model", "group": "Device", "area": "input", "address": 6, "type": "string", "length": 10, "role": "model"},
    {"name": "Device name", "group": "Device", "area": "input", "address": 16, "type": "string", "length": 32},
    {"name": "Output", "group": "Output", "area": "coil", "address": 100, "type": "bool", "access": "RW", "description": "1 = on, 0 = off"},
    {"name": "Output state", "group": "Output", "area": "input", "address": 3000, "type": "bool", "bit": 0},
    {"name": "Last update 1", "group": "Channel 1", "area": "input", "address": 2000, "type": "uint32", "unit": "s", "description": "Unix timestamp"},
    {"name": "Meter error 1", "group": "Channel 1", "area": "input", "address": 2002, "type": "bool", "bit": 0},
