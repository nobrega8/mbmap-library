    {"name": "Energy last update", "group": "Energy", "area": "input", "address": 1160, "type": "uint32", "unit": "s", "description": "Unix timestamp"},
    {"name": "Total active energy", "group": "Energy", "area": "input", "address": 1162, "type": "float32", "unit": "Wh", "description": "All phases, never reset"},
    {"name": "Total returned active energy", "group": "Energy", "area": "input", "address": 1164, "type": "float32", "unit": "Wh", "description": "All phases, never reset"},
    {"name": "Active energy A", "group": "Energy", "area": "input", "address": 1170, "type": "float32", "unit": "Wh"},
