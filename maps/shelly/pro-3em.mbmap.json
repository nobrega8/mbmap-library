{
  "$schema": "https://raw.githubusercontent.com/nobrega8/mbmap-library/main/schema/mbmap-2.schema.json",
  "mbmap": 2,
  "vendor": "Shelly",
  "model": "Pro 3EM",
  "vendor_website": "shelly.com",
  "description": "Three-phase energy meter with Modbus TCP",
  "revision": 1,
  "revised": "2026-10-14",
  "source": "Shelly Gen2 API documentation: Modbus, EM and EMData components",
  "sources": [
    {
      "title": "Shelly Gen2 API: Modbus",
      "url": "https://shelly-api-docs.shelly.cloud/gen2/ComponentsAndServices/Modbus"
    },
    {
      "title": "Shelly Gen2 API: EM",
      "url": "https://shelly-api-docs.shelly.cloud/gen2/ComponentsAndServices/EM",
      "note": "Modbus registers table"
    },
    {
      "title": "Shelly Gen2 API: EMData",
      "url": "https://shelly-api-docs.shelly.cloud/gen2/ComponentsAndServices/EMData",
      "note": "Modbus registers table"
    }
  ],
  "notes": [
    "Modbus TCP must be enabled first (Modbus.SetConfig enable=true, or in the web interface).",
    "The documentation lists input registers in 3xxxx notation: 31000 is input register 1000.",
    "32-bit values are sent low word first, as in the documentation's modbus_cli examples (-B mixed).",
    "A second EM or EMData component, when present, has its registers at +80 (EM) and +70 (EMData)."
  ],
  "protocol": "tcp",
  "port": 502,
  "byte_order": "big",
  "word_order": "little",
  "address_base": 0,
  "x_status": "official",
  "registers": [
    {"name": "MAC address", "group": "Device", "area": "input", "address": 0, "type": "string", "length": 6},
    {"name": "Model", "group": "Device", "area": "input", "address": 6, "type": "string", "length": 10, "role": "model"},
    {"name": "Device name", "group": "Device", "area": "input", "address": 16, "type": "string", "length": 32},
    {"name": "EM last update", "group": "Status", "area": "input", "address": 1000, "type": "uint32", "unit": "s", "description": "Unix timestamp"},
