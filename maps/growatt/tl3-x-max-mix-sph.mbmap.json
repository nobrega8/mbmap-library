{
  "$schema": "https://raw.githubusercontent.com/nobrega8/mbmap-library/main/schema/mbmap-2.schema.json",
  "mbmap": 2,
  "vendor": "Growatt",
  "model": "TL3-X / MAX / MIX / SPH inverters",
  "vendor_website": "growatt.com",
  "description": "Grid-tied and storage inverters that use the first register group (0-124) of the Growatt protocol",
  "revision": 1,
  "revised": "2026-10-14",
  "source": "Growatt Inverter Modbus RTU Protocol V1.24",
  "sources": [
    {
      "title": "Growatt Inverter Modbus RTU Protocol",
      "version": "V1.24",
      "url": "https://github.com/johanmeijer/grott/raw/master/documentatie/Growatt-Inverter-Modbus-RTU-Protocol-II-V1-24-English-new.pdf",
      "note": "holding registers 0-88 and input registers 0-119 (first group)"
    }
  ],
  "notes": [
    "This map covers the first register group (0-124), used by TL3-X (MAX, MID, MAC), MAX 1500V, MIX and SPH inverters.",
    "TL-X / TL-XH (MIN) and MOD TL3-XH inverters use the 3000-3374 range instead and are not covered by this map.",
    "32-bit values are sent high word first (H, then L).",
    "Default serial settings: 9600 baud, 8N1; the address range is 1-254."
  ],
  "protocol": "rtu",
  "unit_id": 1,
  "baudrate": 9600,
  "parity": "N",
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "max_read_registers": 125,
  "x_status": "official",
  "registers": [
