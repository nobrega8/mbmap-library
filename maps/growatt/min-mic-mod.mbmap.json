    {"name": "Inverter mode", "group": "Status", "area": "input", "address": 3000, "type": "uint16", "bit": 8, "bits": 8, "enum": {"0": "Waiting module", "1": "Self-test", "3": "System fault", "4": "Flash", "5": "PV and battery online", "6": "Battery online", "7": "PV offline", "8": "Battery offline"}, "description": "High byte: detailed operating mode"},
    {"name": "PV input power", "group": "PV", "area": "input", "address": 3001, "type": "uint32", "scale": 0.1, "unit": "W"},
