    {"name": "Derating mode", "group": "Status", "area": "input", "address": 3086, "type": "uint16", "enum": {"0": "Not derated", "1": "PV high", "2": "Constant power", "3": "Grid voltage high", "4": "Frequency high", "5": "DC source mode", "6": "Inverter temperature", "7": "Active power order", "8": "Load speed process", "9": "Over-back by time", "10": "Internal temperature", "11": "Output temperature", "12": "Line impedance", "13": "Parallel anti-backflow", "14": "Local anti-backflow", "15": "BDC load priority", "16": "CT error"}},
