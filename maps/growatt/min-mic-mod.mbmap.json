    {"name": "PV3 current", "group": "PV", "area": "input", "address": 3012, "type": "uint16", "scale": 0.1, "unit": "A"},
    {"name": "PV3 power", "group": "PV", "area": "input", "address": 3013, "type": "uint32", "scale": 0.1, "unit": "W"},
    {"name": "System output power", "group": "Grid", "area": "input", "address": 3019, "type": "uint32", "scale": 0.1, "unit": "W"},
