{
  "$schema": "https://raw.githubusercontent.com/nobrega8/mbmap-library/main/schema/mbmap-2.schema.json",
  "mbmap": 2,
  "vendor": "Eastron",
  "model": "SDM72CT-M",
  "vendor_website": "eastroneurope.com",
  "description": "Three-phase DIN rail energy meter for current transformers (5 A secondary). Values a wiring system does not use read 0",
  "revision": 2,
  "revised": "2026-10-17",
  "source": "Zhejiang Eastron Electronic, \"Eastron SDM72CT-M User Manual\", V1.0, Modbus protocol section",
  "sources": [{"title": "Eastron SDM72CT-M User Manual", "version": "V1.0", "url": "https://xn--stromzhler-v5a.eu/media/db/c6/8c/1696582671/sdm72ct-m.pdf", "note": "Modbus protocol section"}],
  "notes": [
    "Measurements are float32 input registers (FC04); settings are float32 holding registers (FC03 read, FC16 write).",
    "Settings marked KPPA need the password (default 1000) written to the access authority register first."
  ],
  "protocol": "rtu",
  "unit_id": 1,
  "baudrate": 9600,
  "parity": "N",
  "databits": 8,
  "stopbits": 1,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
  "registers": [
    {"name": "Phase 1 line to neutral volts", "group": "Measurements", "area": "input", "address": "0x0000", "type": "float32", "unit": "V", "access": "R", "description": "Valid on 3P4W, 1P2W; reads 0 otherwise"},
    {"name": "Phase 2 line to neutral volts", "group": "Measurements", "area": "input", "address": "0x0002", "type": "float32", "unit": "V", "access": "R", "description": "Valid on 3P4W; reads 0 otherwise"},
    {"name": "Phase 3 line to neutral volts", "group": "Measurements", "area": "input", "address": "0x0004", "type": "float32", "unit": "V", "access": "R", "description": "Valid on 3P4W; reads 0 otherwise"},
    {"name": "Phase 1 current", "group": "Measurements", "area": "input", "address": "0x0006", "type": "float32", "unit": "A", "access": "R"},
    {"name": "Phase 2 current", "group": "Measurements", "area": "input", "address": "0x0008", "type": "float32", "unit": "A", "access": "R", "description": "Valid on 3P4W, 3P3W; reads 0 otherwise"},
    {"name": "Phase 3 current", "group": "Measurements", "area": "input", "address": "0x000A", "type": "float32", "unit": "A", "access": "R", "description": "Valid on 3P4W, 3P3W; reads 0 otherwise"},
    {"name": "Phase 1 active power", "group": "Measurements", "area": "input", "address": "0x000C", "type": "float32", "unit": "W", "access": "R", "description": "Valid on 3P4W, 1P2W; reads 0 otherwise"},
    {"name": "Phase 2 active power", "group": "Measurements", "area": "input", "address": "0x000E", "type": "float32", "unit": "W", "access": "R", "description": "Valid on 3P4W; reads 0 otherwise"},
    {"name": "Phase 3 active power", "group": "Measurements", "area": "input", "address": "0x0010", "type": "float32", "unit": "W", "access": "R", "description": "Valid on 3P4W; reads 0 otherwise"},
    {"name": "Phase 1 apparent power", "group": "Measurements", "area": "input", "address": "0x0012", "type": "float32", "unit": "VA", "access": "R", "description": "Valid on 3P4W, 1P2W; reads 0 otherwise"},
    {"name": "Phase 2 apparent power", "group": "Measurements", "area": "input", "address": "0x0014", "type": "float32", "unit": "VA", "access": "R", "description": "Valid on 3P4W; reads 0 otherwise"},
    {"name": "Phase 3 apparent power", "group": "Measurements", "area": "input", "address": "0x0016", "type": "float32", "unit": "VA", "access": "R", "description": "Valid on 3P4W; reads 0 otherwise"},
    {"name": "Phase 1 reactive power", "group": "Measurements", "area": "input", "address": "0x0018", "type": "float32", "unit": "var", "access": "R", "description": "Valid on 3P4W, 1P2W; reads 0 otherwise"},
    {"name": "Phase 2 reactive power", "group": "Measurements", "area": "input", "address": "0x001A", "type": "float32", "unit": "var", "access": "R", "description": "Valid on 3P4W; reads 0 otherwise"},
    {"name": "Phase 3 reactive power", "group": "Measurements", "area": "input", "address": "0x001C", "type": "float32", "unit": "var", "access": "R", "description": "Valid on 3P4W; reads 0 otherwise"},
    {"name": "Phase 1 power factor", "group": "Measurements", "area": "input", "address": "0x001E", "type": "float32", "access": "R", "description": "Valid on 3P4W, 1P2W; reads 0 otherwise"},
    {"name": "Phase 2 power factor", "group": "Measurements", "area": "input", "address": "0x0020", "type": "float32", "access": "R", "description": "Valid on 3P4W; reads 0 otherwise"},
    {"name": "Phase 3 power factor", "group": "Measurements", "area": "input", "address": "0x0022", "type": "float32", "access": "R", "description": "Valid on 3P4W; reads 0 otherwise"},
    {"name": "Average line to neutral volts", "group": "Measurements", "area": "input", "address": "0x002A", "type": "float32", "unit": "V", "access": "R", "description": "Valid on 3P4W; reads 0 otherwise"},
    {"name": "Average line current", "group": "Measurements", "area": "input", "address": "0x002E", "type": "float32", "unit": "A", "access": "R"},
    {"name": "Sum of line currents", "group": "Measurements", "area": "input", "address": "0x0030", "type": "float32", "unit": "A", "access": "R"},
    {"name": "Total system power", "group": "Measurements", "area": "input", "address": "0x0034", "type": "float32", "unit": "W", "access": "R"},
    {"name": "Total system apparent power", "group": "Measurements", "area": "input", "address": "0x0038", "type": "float32", "unit": "VA", "access": "R"},
    {"name": "Total system reactive power", "group": "Measurements", "area": "input", "address": "0x003C", "type": "float32", "unit": "var", "access": "R"},
    {"name": "Total system power factor", "group": "Measurements", "area": "input", "address": "0x003E", "type": "float32", "access": "R"},
    {"name": "Frequency of supply voltages", "group": "Measurements", "area": "input", "address": "0x0046", "type": "float32", "unit": "Hz", "access": "R"},
    {"name": "Import active energy", "group": "Energy", "area": "input", "address": "0x0048", "type": "float32", "unit": "kWh", "access": "R"},
    {"name": "Export active energy", "group": "Energy", "area": "input", "address": "0x004A", "type": "float32", "unit": "kWh", "access": "R"},
    {"name": "Import reactive energy", "group": "Energy", "area": "input", "address": "0x004C", "type": "float32", "unit": "kvarh", "access": "R"},
    {"name": "Export reactive energy", "group": "Energy", "area": "input", "address": "0x004E", "type": "float32", "unit": "kvarh", "access": "R"},
    {"name": "Line 1 to Line 2 volts", "group": "Measurements", "area": "input", "address": "0x00C8", "type": "float32", "unit": "V", "access": "R", "description": "Valid on 3P4W, 3P3W; reads 0 otherwise"},
    {"name": "Line 2 to Line 3 volts", "group": "Measurements", "area": "input", "address": "0x00CA", "type": "float32", "unit": "V", "access": "R", "description": "Valid on 3P4W, 3P3W; reads 0 otherwise"},
    {"name": "Line 3 to Line 1 volts", "group": "Measurements", "area": "input", "address": "0x00CC", "type": "float32", "unit": "V", "access": "R", "description": "Valid on 3P4W, 3P3W; reads 0 otherwise"},
    {"name": "Average line to line volts", "group": "Measurements", "area": "input", "address": "0x00CE", "type": "float32", "unit": "V", "access": "R", "description": "Valid on 3P4W, 3P3W; reads 0 otherwise"},
    {"name": "Neutral current", "group": "Measurements", "area": "input", "address": "0x00E0", "type": "float32", "unit": "A", "access": "R", "description": "Valid on 3P4W; reads 0 otherwise"},
    {"name": "Total active energy", "group": "Energy", "area": "input", "address": "0x0156", "type": "float32", "unit": "kWh", "access": "R"},
    {"name": "Total reactive energy", "group": "Energy", "area": "input", "address": "0x0158", "type": "float32", "unit": "kvarh", "access": "R"},
    {"name": "Pulse 1 width", "group": "Setup", "area": "holding", "address": "0x000C", "type": "float32", "unit": "ms", "access": "RW", "description": "60, 100 or 200 ms, default 200"},
    {"name": "Access authority (KPPA)", "group": "Setup", "area": "holding", "address": "0x000E", "type": "float32", "access": "RW", "enum": {"0": "No access", "1": "Access granted"}, "description": "Write the password to get access to the protected settings"},
    {"name": "Parity and stop bits", "group": "Setup", "area": "holding", "address": "0x0012", "type": "float32", "access": "RW", "enum": {"0": "No parity, 1 stop bit", "1": "Even parity, 1 stop bit", "2": "Odd parity, 1 stop bit", "3": "No parity, 2 stop bits"}, "description": "Default 0"},
    {"name": "Modbus address", "group": "Setup", "area": "holding", "address": "0x0014", "type": "float32", "access": "RW", "write_min": 1, "write_max": 247, "description": "Default 1"},
    {"name": "Pulse 1 rate", "group": "Setup", "area": "holding", "address": "0x0016", "type": "float32", "access": "RW", "enum": {"1": "0.01 kWh/imp", "2": "0.1 kWh/imp", "3": "1 kWh/imp", "4": "10 kWh/imp", "5": "100 kWh/imp"}},
    {"name": "Password", "group": "Setup", "area": "holding", "address": "0x0018", "type": "float32", "access": "RW", "description": "Read gives the password, write changes it. Default 1000"},
    {"name": "Network baud rate", "group": "Setup", "area": "holding", "address": "0x001C", "type": "float32", "access": "RW", "enum": {"0": "2400", "1": "4800", "2": "9600", "5": "1200"}, "description": "Default 2 (9600)"},
    {"name": "CT ratio", "group": "Setup", "area": "holding", "address": "0x0020", "type": "float32", "access": "RW", "write_min": 1, "write_max": 2000, "description": "Default 1. Needs KPPA"},
    {"name": "Scroll display time", "group": "Setup", "area": "holding", "address": "0x003A", "type": "float32", "unit": "s", "access": "RW", "write_min": 0, "write_max": 30, "description": "Default 0 = no scrolling"},
    {"name": "Backlight time", "group": "Setup", "area": "holding", "address": "0x003C", "type": "float32", "unit": "min", "access": "RW", "write_min": 0, "write_max": 120, "description": "Default 0 = always on"},
    {"name": "Pulse 1 energy type", "group": "Setup", "area": "holding", "address": "0x0056", "type": "float32", "access": "RW", "enum": {"1": "Import active", "2": "Total active", "4": "Export active", "5": "Import reactive", "6": "Total reactive", "8": "Export reactive"}, "description": "Default 4"},
    {"name": "Serial number", "group": "Device", "area": "holding", "address": "0xFC00", "type": "uint32", "access": "R", "role": "serial"}
  ]
}
