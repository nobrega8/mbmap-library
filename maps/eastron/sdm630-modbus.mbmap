# Eastron SDM630-Modbus three-phase energy meter (RS485).
# Every value is a float32 in two registers. The meter answers FC03, FC04 and FC16 only (no FC06)
# and rejects reads or writes of an odd number of registers.
@mbmap=1
@vendor=Eastron
@model=SDM630-Modbus
@vendor_website=eastroneurope.com
@description=Three-phase multifunction DIN rail energy meter, direct connection (SDM630-Modbus and SDM630-Modbus V2). Values a wiring system does not use read 0
@source=Eastron Europe, "Eastron SDM630Modbus Smart Meter Modbus Protocol Implementation V1.8"; https://www.eastroneurope.com/images/uploads/products/protocol/SDM630_MODBUS_Protocol.pdf
@protocol=rtu
@unit_id=1
@baudrate=9600
@parity=N
@databits=8
@stopbits=1
@byte_order=ABCD
@address_base=0
@max_read_registers=80

