  "models": ["SDM530-MT"],
  "vendor_website": "eastroneurope.com",
  "description": "Three-phase four-wire multi-tariff DIN rail energy meter for current transformers, with four tariffs and twelve months of history",
  "revision": 3,
  "revised": "2026-10-18",
  "source": "Eastron, \"Eastron SDM530-MT User Manual\" with the SDM530-MT Modbus protocol",
  "sources": [{"title": "Eastron SDM530-MT User Manual (including the Modbus protocol)", "url": "https://xn--stromzhler-v5a.eu/media/10/6c/b2/1696582675/sdm530mt-manual-incl-protocoll.pdf", "note": "sections 1.2 and 1.3 of the protocol"}],
  "notes": [
    "Measurements are float32 input registers (FC04); settings are float32 holding registers (FC03 read, FC16 write, one parameter per write).",
    "Requests must cover an even number of registers; at most 40 values per read.",
    "Protected settings need the password written to the password register; it times out after one minute unless the password lock register is read.",
    "Not in this map: the monthly history blocks (input registers 0x0201-0x0321 and 0xF101-0xFB01, five values per block: total and tariffs 1-4), the clock (0xF000), the demand/display setup (0xF500) and the tariff schedule (0xF700)."
  ],
  "protocol": "rtu",
  "unit_id": 1,
  "baudrate": 9600,
  "parity": "N",
  "databits": 8,
  "stopbits": 1,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "max_read_registers": 80,
  "x_status": "official",
