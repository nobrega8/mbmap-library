    {
      "name": "Demand Period",
      "group": "Settings",
      "area": "holding",
      "address": 2,
      "type": "float32",
      "access": "RW",
      "description": "Demand Period time, default 60, unit min. Range: 0 to 60, 0 represents real-time update (demand updated every 1 second)."
    },
    {
      "name": "Relay Pulse Width",
      "group": "Settings",
      "area": "holding",
      "address": 12,
      "type": "float32",
      "access": "RW",
      "description": "Write relay on period in milliseconds: 60, 100 or 200, default 60ms."
    },
    {
      "name": "Parity and Stop Bit",
      "group": "Settings",
      "area": "holding",
      "address": 18,
      "type": "float32",
      "enum": {
        "0": "One stop bit and no parity",
        "1": "One stop bit and even parity",
        "2": "One stop bit and odd parity",
        "3": "Two stop bits and no parity"
      },
      "access": "RW",
      "description": "Write the network port parity/stop bits for MODBUS Protocol, where: 0 = One stop bit and no parity 1 = One stop bit and even parity 2 = One stop bit and odd parity 3 = Two stop bits and no parity."
    },
    {
      "name": "Modbus Address",
      "group": "Settings",
      "area": "holding",
      "address": 20,
      "type": "float32",
      "access": "RW",
      "description": "Write the Modbus Address address: 1 to 247 for MODBUS Protocol, default 1."
    },
    {
      "name": "Baud Rate",
      "group": "Settings",
      "area": "holding",
      "address": 28,
      "type": "float32",
      "enum": {
        "0": "2400 baud",
        "1": "4800 baud",
        "2": "9600 baud",
        "5": "1200baud"
      },
      "access": "RW",
      "description": "Write the baud rate for MODBUS Protocol, where: 0 = 2400 baud 1 = 4800 baud 2 = 9600 baud 5=1200baud Default:2 = 9600 baud."
    },
    {
      "name": "CT1",
      "group": "Settings",
      "area": "holding",
      "address": 50,
      "type": "float32",
      "access": "RW",
      "description": "CT Primary current Ranges from 5 to 9999，Default ID is 5."
    },
    {
      "name": "Backlit time",
      "group": "Settings",
      "area": "holding",
      "address": 60,
      "type": "float32",
      "access": "RW",
      "description": "Range 0~121, 0 means backlit always on, 121 means backlit always off. Default: 60 min."
    },
    {
      "name": "Pulse 1 output mode",
      "group": "Settings",
      "area": "holding",
      "address": 86,
      "type": "float32",
      "enum": {
        "1": "Import active energy",
        "2": "Import + export active energy",
        "4": "Export active energy, (default)",
        "5": "Import reactive energy",
        "6": "Import + export reactive energy",
        "8": "Export reactive energy"
      },
      "access": "RW",
      "description": "Write MODBUS Protocol input parameter for pulse out 1: 0001: Import active energy, 0002: Import + export active energy, 0004: Export active energy, (default). 0005: Import reactive energy, 0006: Import + export reactive energy, 0008: Export reactive energy,."
    },
    {
      "name": "Reset",
      "group": "Settings",
      "area": "holding",
      "address": 61456,
      "type": "uint16",
      "access": "W",
      "description": "00 00: reset the Maximum demand."
