{
  "$schema": "https://raw.githubusercontent.com/nobrega8/mbmap-library/main/schema/mbmap-2.schema.json",
  "mbmap": 2,
  "vendor": "Eastron",
  "model": "SDM120CT-40mA",
  "models": [
    "SDM120CT-40mA",
    "SDM120CT-M-40mA"
  ],
  "vendor_website": "eastrongroup.com",
  "description": "Single-phase energy meter for 40 mA CT secondaries with RS485: voltage, current, powers, power factor, frequency, demand and energies",
  "revision": 1,
  "source": "Eastron, SDM120CT-40mA User Manual, V1.0",
  "notes": [
    "Modbus RTU over RS485. Function 04 reads the input registers, 03 reads and 16 writes the holding registers.",
    "Addresses are the 'Modbus Protocol Start Address Hex' of the manual (the 3xxxx/4xxxx numbers less 30001/40001; the six-digit 31xxxx/46xxxx ones less 300001/400001).",
    "Floats are IEEE 754, high word first. Holding-register settings are floats too unless the entry says otherwise.",
    "Key parameters (system type, address, baud rate, parity) can only be written after the password has been written to the KPPA register.",
    "Written from the manufacturer's manual; not tested on a device."
  ],
  "protocol": "rtu",
  "unit_id": 1,
  "baudrate": 9600,
  "parity": "N",
  "databits": 8,
  "stopbits": 1,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "sources": [
    {
      "title": "SDM120CT-40mA User Manual",
      "version": "V1.0",
      "note": "Modbus input and holding register tables",
      "url": "https://www.eastrongroup.com/eastrongroup/2026/07/17/EastronSDM120CT-M40mAUsermanualV10.pdf",
      "accessed": "2026-11-14",
      "sha256": "c917bf248c619dad3ef2baf58b390238539af7c083c881c39b79cde6c40c7541"
    }
  ],
  "x_status": "official",
