{
  "$schema": "https://raw.githubusercontent.com/nobrega8/mbmap-library/main/schema/mbmap-2.schema.json",
  "mbmap": 2,
  "vendor": "JXCT",
  "model": "JXBS-3001-NPK-RS",
  "models": [
    "JXBS-3001-NPK-RS"
  ],
  "vendor_website": "jxct-iot.com",
  "description": "Soil sensor with RS485 Modbus RTU: pH, moisture, temperature, conductivity, nitrogen, phosphorus and potassium",
  "revision": 3,
  "revised": "2026-11-13",
  "source": "JXCT, JXBS-3001-NPK-RS Soil NPK Sensor User Manual, RS485 Modbus, Version 2.0 (2020-10-24), section 4.3 Register address",
  "sources": [
    {
      "title": "JXBS-3001-NPK-RS Soil NPK Sensor User Manual (RS485 Modbus)",
      "version": "2.0, 2020-10-24",
      "url": "https://hestore.hu/prod_getfile.php?id=17219",
      "note": "sections 4.1 to 4.4: communication settings, register table and examples"
    }
  ],
  "notes": [
    "JXCT JXBS-3001-NPK-RS soil sensor.",
    "Register addresses are the hex addresses of the manual's table (0006H = 6). The sensor reads with function 03; 16-bit values are high byte first.",
    "Factory default: address 1, 9600 bit/s, 8 data bits, no parity, 1 stop bit.",
    "Not tested on a device."
  ],
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
  "registers": [
    {
      "name": "Soil pH",
      "group": "Measurements",
      "area": "holding",
      "address": 6,
      "type": "uint16",
      "scale": 0.01,
      "unit": "pH",
      "access": "R"
    },
    {
      "name": "Soil moisture",
      "group": "Measurements",
      "area": "holding",
      "address": 18,
      "type": "uint16",
      "scale": 0.1,
      "unit": "%",
      "access": "R"
    },
    {
      "name": "Soil temperature",
      "group": "Measurements",
      "area": "holding",
      "address": 19,
      "type": "int16",
      "scale": 0.1,
      "unit": "°C",
      "description": "Negative temperatures are sent as two's complement (0xFF9B = -10.1 °C).",
      "access": "R"
    },
    {
      "name": "Soil conductivity",
      "group": "Measurements",
      "area": "holding",
      "address": 21,
      "type": "uint16",
      "unit": "µS/cm",
      "access": "R"
    },
    {
      "name": "Soil nitrogen",
      "group": "Measurements",
      "area": "holding",
      "address": 30,
      "type": "uint16",
      "unit": "mg/kg",
      "access": "R"
    },
    {
      "name": "Soil phosphorus",
      "group": "Measurements",
      "area": "holding",
      "address": 31,
      "type": "uint16",
      "unit": "mg/kg",
      "access": "R"
    },
    {
      "name": "Soil potassium",
      "group": "Measurements",
      "area": "holding",
      "address": 32,
      "type": "uint16",
      "unit": "mg/kg",
      "access": "R"
    },
    {
      "name": "Device address",
      "group": "Configuration",
      "area": "holding",
      "address": 256,
      "type": "uint16",
      "access": "RW",
      "description": "0 to 255. Factory default 1."
    },
    {
      "name": "Baud rate",
      "group": "Configuration",
      "area": "holding",
      "address": 257,
      "type": "uint16",
      "access": "RW",
      "description": "2400, 4800 or 9600 bit/s (factory default 9600). The manual does not give the value codes."
    }
  ]
}
