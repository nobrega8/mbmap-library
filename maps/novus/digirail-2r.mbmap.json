  "vendor_website": "novus.com.br",
  "description": "Two-relay digital output module with Modbus RTU over RS485: output states, timed activation, tags and serial settings",
  "revision": 1,
  "revised": "2026-11-26",
  "source": "Novus DigiRail-2R communication manual",
  "sources": [
    {
      "title": "DigiRail-2R Digital Outputs Module - Communication Manual",
      "url": "https://cdn.shopify.com/s/files/1/2586/3536/files/communication_manual_digirail-2r_english.pdf",
      "note": "coil tables and holding register table",
      "accessed": "2026-11-26",
      "sha256": "50d526578484594b8e02ef2710ebd21e2d679c30d84f24cdc662dc8497956f0f"
    }
  ],
  "notes": [
    "Factory defaults: address 247, 1200 bit/s, even parity, 1 stop bit. Pressing the RCom button puts the module in diagnostic mode for one minute with address 246, 1200 bit/s, even parity.",
    "Functions 01, 03, 05, 06 and 15.",
    "The manual lists no write-multiple function for holding registers, so each word is written with function 06; a tool that writes the activation times or tags with function 16 may be refused.",
    "The manual does not give the character order of the tags; this map assumes the first character is in the high byte.",
    "Written from the manufacturer's manual; not tested on a device."
  ],
  "protocol": "rtu",
  "unit_id": 247,
  "baudrate": 1200,
  "databits": 8,
  "parity": "E",
  "stopbits": 1,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
