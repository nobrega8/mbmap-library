  "description": "Process indicator with two alarms and optional RS485 Modbus RTU: process value, min/max, status words, alarm settings, input configuration, calibration and communication settings",
  "revision": 1,
  "revised": "2026-11-24",
  "firmware": "Communication manual for software V2.0x",
  "source": "Novus N1540 communication manual V2.0x A (Portuguese)",
  "sources": [
    {
      "title": "Indicador N1540 - Manual de Comunicação",
      "version": "V2.0x A",
      "url": "https://cdn.novusautomation.com/downloads/manual_comm_n1540_v20x_a_pt.pdf",
      "note": "tables 01 to 04",
      "accessed": "2026-11-24",
