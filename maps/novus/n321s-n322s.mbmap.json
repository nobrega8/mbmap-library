    }
  ],
  "notes": [
    "Modbus RTU needs the RS485 interface. Functions 03 and 06; a read takes at most four registers. Broadcast (address 0) writes only.",
    "9600 bit/s, 8 data bits, no parity, 1 stop bit; the address is set with Addr.",
    "Temperatures, setpoints and hysteresis are sent multiplied by 10.",
    "A write outside the allowed range is refused with exception 03.",
    "Written from the manufacturer's document; not tested on a device."
  ],
  "protocol": "rtu",
  "unit_id": 1,
  "baudrate": 9600,
  "databits": 8,
  "parity": "N",
  "stopbits": 1,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "max_read_registers": 4,
  "x_status": "official",
