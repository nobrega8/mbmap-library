    {
      "title": "Controlador N2000 - Manual de Instruções",
      "version": "V3.0x P",
      "url": "https://github.com/user-attachments/files/34218870/Manual_N2000_PT.pdf",
      "note": "linked in issue #89; annex 1, tables 12-16"
    }
