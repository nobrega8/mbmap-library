  "mbmap": 2,
  "vendor": "Circutor",
  "model": "CVM-C10",
  "vendor_website": "circutor.com",
  "description": "Three-phase panel power analyzer (CVM-C10-ITF, -ITF-IN, -MC, -mV, -Flex) with RS-485 Modbus RTU",
  "revision": 1,
  "source": "Circutor, \"CVM-C10 Instruction Manual\", M001B01-03-23A; https://docs.circutor.com/docs/M001B01-03.pdf",
  "notes": [
    "Circutor CVM-C10 panel power analyzer, Modbus RTU over RS-485.",
    "Addresses are the manual's hexadecimal addresses, sent as-is on the wire.",
    "Every measurement is a 32-bit integer in two registers; at most 20 values (40 registers) per request.",
    "Generated active power reads negative. Measurements answer FC03 and FC04; configuration answers FC04 and is",
    "written with FC16 (all registers of a group at once), and only takes effect after a reset."
  ],
  "protocol": "rtu",
  "unit_id": 1,
  "baudrate": 9600,
  "parity": "N",
  "databits": 8,
  "stopbits": 1,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "max_read_registers": 40,
  "enums": {
    "installation": {"0": "3-phase 4-wire", "1": "3-phase 3-wire", "2": "3-phase 3-wire Aron", "3": "2-phase 3-wire", "4": "1-phase L-L", "5": "1-phase L-N"}
  },
