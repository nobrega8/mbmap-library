    {
      "title": "PRO 1 Series MID DIN rail single phase two wire energy meter, User Manual",
      "version": "Product version 1.12 (2014)",
      "url": "https://portal.segen.co.uk/reseller/docs/PRO1_series_MID_user_manual.PDF",
