  "vendor_website": "buderus.us",
  "description": "SSB condensing boilers, Modbus RTU: state, status and error code, pumps, temperatures, firing rate, flame current, ignition and burn hour counters, lockout and blocking history, cascade dependents and setpoints",
  "revision": 1,
  "source": "Buderus (Bosch Thermotechnology), Modbus for Buderus SSB boilers, Installation and Service Instructions, 6720818450 (2015/10) US",
  "sources": [
    {
      "title": "Modbus for Buderus SSB boilers",
      "version": "6720818450 (2015/10) US",
      "url": "https://www.bosch-homecomfort.com/us/media/country_pool/service/technical_guides/6720818450_ssb_boiler_modbus_installation_instructions_en_10.2015_us_us.pdf",
      "note": "chapters 3-5",
      "accessed": "2026-11-15",
      "sha256": "ebc5857516707d858af71c92a849943a32f6a2d33c3bbca1a64f2f477f313bdd"
    }
  ],
  "notes": [
    "Modbus RTU on RS485: 9600 bit/s, 8 data bits, no parity, 2 stop bits (1 configurable), address 1 by default.",
    "Addresses are those of the manual, counted from 0 (the manual adds 1 for software that counts from 1).",
    "Before any write, set the write enable bit (register 99, bit 0); it clears after the write or after 4 s.",
    "Temperatures, percentages, pressures and flame current are sent multiplied by 10. Temperatures follow the unit selection in register 98.",
    "Written from the manufacturer's manual; not tested on a device."
  ],
  "protocol": "rtu",
  "unit_id": 1,
  "baudrate": 9600,
  "databits": 8,
  "parity": "N",
  "stopbits": 2,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
