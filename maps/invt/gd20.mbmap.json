  "vendor_website": "invt.com",
  "description": "Goodrive20 (GD20) vector VFD over RS485 Modbus: control command, set values, status words, fault code, running values and communication parameters",
  "revision": 1,
  "source": "INVT, Goodrive20 Series VFD Manual V1.9, chapter 7 (Communication protocol)",
  "sources": [
    {
      "title": "Goodrive20 Series VFD Manual",
      "version": "V1.9",
      "url": "https://www.invt.com/uploads/file1/20230629/GD20%20Series%20VFD%20Manual_V1.9.pdf",
      "note": "section 7.4, data address definition; P07 and P14 parameter lists",
      "accessed": "2026-11-15",
      "sha256": "9e12f6721c37ea7fea8159d3c39cc7aab407b281c2eb85b05d92b137fc9a3f15"
    }
  ],
  "notes": [
    "A function code Pxx.yy is the holding register 0xXXYY with both parts in hex (P05.05 is 0x0505, P10.01 is 0x0A01). Setting the high bit (0x8000 + address) writes to RAM only, without saving to EEPROM; that address cannot be read.",
    "Defaults: address 1, 19200 bit/s, RTU 8E1 (P14.00-P14.02).",
    "Values are integers scaled by the decimals of the parameter's setting range (50.12 Hz is 5012).",
    "Running and stopping over Modbus need P00.01 = communication running command channel; PID reference over Modbus needs P09.00 = Modbus communication.",
    "Written from the manufacturer's manual; not tested on a device."
  ],
  "protocol": "rtu",
  "unit_id": 1,
  "baudrate": 19200,
  "databits": 8,
  "parity": "E",
  "stopbits": 1,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
  "enums": {
    "fault": {
      "0": "No fault",
      "1": "Inverter unit U phase protection (OUt1)",
      "2": "Inverter unit V phase protection (OUt2)",
      "3": "Inverter unit W phase protection (OUt3)",
      "4": "Overcurrent during acceleration (OC1)",
      "5": "Overcurrent during deceleration (OC2)",
      "6": "Overcurrent during constant speed running (OC3)",
      "7": "Overvoltage during acceleration (OV1)",
      "8": "Overvoltage during deceleration (OV2)",
      "9": "Overvoltage during constant speed running (OV3)",
      "10": "Bus undervoltage (UV)",
      "11": "Motor overload (OL1)",
      "12": "VFD overload (OL2)",
      "13": "Phase loss on input side(SPI)",
      "14": "Phase loss on output side (SPO)",
      "15": "Rectifier module overheat(OH1)",
      "16": "Inverter module overheat (OH2)",
      "17": "External fault (EF)",
      "18": "485 communication fault (CE)",
      "19": "Current detection fault (ItE)",
      "20": "Motor autotuning fault (tE)",
      "21": "EEPROM operation fault (EEP)",
      "22": "PID feedback offline fault (PIDE)",
      "23": "Braking unit fault (bCE)",
      "24": "Running time reached (END)",
      "25": "Electronic overload (OL3)",
      "26": "Keypad communication error (PCE)",
      "27": "Parameter upload error (UPE)",
      "28": "Parameter download error (DNE)",
      "32": "To-ground short-circuit fault 1 (ETH1)",
      "33": "To-ground short-circuit fault 2 (ETH2)",
      "34": "Speed deviation fault (dEu)",
      "35": "Mal-adjustment fault (STo)",
      "36": "Underload fault (LL)"
    }
  },
