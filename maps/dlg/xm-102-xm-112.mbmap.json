      "title": "Conversor Universal XM-102 / XM-112 - Manual do usuário",
      "version": "MAN-PT-DE-XM1_2-01.00_16",
      "url": "https://www.dlg.com.br/manuaisdownload/MAN-PT-DE-XM1_2.pdf",
      "note": "Modbus table and register types",
      "accessed": "2026-11-18",
