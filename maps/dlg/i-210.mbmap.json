    {
      "title": "Indicador Universal Modbus I-210 - Manual do usuário",
      "version": "MAN-PT-DE-I210-01.00_13",
      "url": "https://www.dlg.com.br/manuaisdownload/I-210%20-%20Indicador%20Universal%20Modbus.pdf",
      "note": "section 8, Modbus table and bit masks",
      "accessed": "2026-11-18",
