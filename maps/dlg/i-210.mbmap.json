    "burnout": {"0": "Off", "1": "Low", "2": "High", "3": "Low and high"},
    "alarm_type": {"0": "Off", "1": "Low", "2": "High", "3": "Differential"},
    "retrans": {"0": "0-20 mA or 0-10 V from the engineering zero and span", "1": "0-20 mA or 0-10 V from the retransmission limits", "2": "4-20 mA or 2-10 V from the engineering zero and span", "3": "4-20 mA or 2-10 V from the retransmission limits"}
