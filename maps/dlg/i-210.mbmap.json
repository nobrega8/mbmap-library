    "baud": {"0": "9600 bit/s", "1": "19200 bit/s", "2": "38400 bit/s", "3": "57600 bit/s", "4": "115200 bit/s"},
    "parity": {"0": "Even", "1": "Odd", "2": "None"},
    "temp_unit": {"0": "Celsius", "1": "Fahrenheit"},
