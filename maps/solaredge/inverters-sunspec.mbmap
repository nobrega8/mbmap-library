# SolarEdge inverters, SunSpec monitoring data (models 101, 102 and 103).
# Values are integers with scale factor registers; values a model does not use read 0xFFFF or 0x8000.
# Modbus TCP is off by default: enable it in the inverter's LAN or communication menu.
@mbmap=1
@vendor=SolarEdge
@model=Inverters (SunSpec 101-103)
@vendor_website=solaredge.com
@description=SolarEdge single, split and three phase inverters with SetApp or LCD firmware 3.xxxx+, monitoring data through SunSpec. Multi-MPPT model 160 (Synergy) and the energy meters are separate maps
@source=SolarEdge, "SolarEdge Inverters - SunSpec Logging - Technical Note" v2.6 (December 2023), register mapping; SunSpec Alliance information model definitions (github.com/sunspec/models), models 1 and 103
@protocol=tcp+rtu
@unit_id=1
@port=502
@baudrate=115200
@parity=N
@databits=8
@stopbits=1
@byte_order=ABCD
@address_base=0
@enum_inverter_state=1=Off|2=Sleeping|3=Starting|4=MPPT|5=Throttled|6=Shutting down|7=Fault|8=Standby
@sentinel_int16=-32768=Not implemented
@sentinel_uint16=0xFFFF=Not implemented
@sentinel_int32=-2147483648=Not implemented
@sentinel_uint32=0xFFFFFFFF=Not implemented

