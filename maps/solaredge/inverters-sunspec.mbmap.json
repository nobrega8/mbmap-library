    {"name": "DC Power", "group": "DC side", "area": "holding", "address": 40100, "type": "int16", "scale_factor": "DCW_SF", "unit": "W", "access": "R", "description": "SunSpec DCW"},
    {"name": "DCW_SF", "group": "Scale factors", "area": "holding", "address": 40101, "type": "int16", "access": "R", "description": "SunSpec DCW_SF"},
    {"name": "Heat Sink Temperature", "group": "Temperature", "area": "holding", "address": 40103, "type": "int16", "scale_factor": "Tmp_SF", "unit": "°C", "access": "R", "description": "SunSpec TmpSnk"},
    {"name": "Tmp_SF", "group": "Scale factors", "area": "holding", "address": 40106, "type": "int16", "access": "R", "description": "SunSpec Tmp_SF"},
