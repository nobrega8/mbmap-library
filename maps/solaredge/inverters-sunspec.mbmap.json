    {"name": "Model", "group": "Device", "area": "holding", "address": 40020, "type": "string", "length": 16, "access": "R", "description": "SunSpec Md"},
    {"name": "Options", "group": "Device", "area": "holding", "address": 40036, "type": "string", "length": 8, "access": "R", "description": "SunSpec Opt"},
    {"name": "Version", "group": "Device", "area": "holding", "address": 40044, "type": "string", "length": 8, "access": "R", "description": "SunSpec Vr"},
