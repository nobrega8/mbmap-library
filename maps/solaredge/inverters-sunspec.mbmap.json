    {"name": "Hz_SF", "group": "Scale factors", "area": "holding", "address": 40086, "type": "int16", "access": "R", "description": "SunSpec Hz_SF"},
    {"name": "AC Apparent Power", "group": "AC side", "area": "holding", "address": 40087, "type": "int16", "scale_factor": "VA_SF", "unit": "VA", "access": "R", "description": "SunSpec VA"},
    {"name": "VA_SF", "group": "Scale factors", "area": "holding", "address": 40088, "type": "int16", "access": "R", "description": "SunSpec VA_SF"},
    {"name": "AC Reactive Power", "group": "AC side", "area": "holding", "address": 40089, "type": "int16", "scale_factor": "VAr_SF", "unit": "var", "access": "R", "description": "SunSpec VAr"},
    {"name": "VAr_SF", "group": "Scale factors", "area": "holding", "address": 40090, "type": "int16", "access": "R", "description": "SunSpec VAr_SF"},
