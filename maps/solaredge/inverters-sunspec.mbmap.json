    {"name": "Inverter model ID", "group": "Model header", "area": "holding", "address": 40069, "type": "uint16", "access": "R", "description": "SunSpec ID. 101 = single phase, 102 = split phase, 103 = three phase"},
    {"name": "Inverter model length", "group": "Model header", "area": "holding", "address": 40070, "type": "uint16", "access": "R", "description": "SunSpec L"},
    {"name": "AC Current", "group": "AC side", "area": "holding", "address": 40071, "type": "uint16", "scale_factor": "A_SF", "unit": "A", "access": "R", "description": "SunSpec A. Sum of active phases"},
    {"name": "Phase A Current", "group": "AC side", "area": "holding", "address": 40072, "type": "uint16", "scale_factor": "A_SF", "unit": "A", "access": "R", "description": "SunSpec AphA. Connected Phase"},
    {"name": "Phase B Current", "group": "AC side", "area": "holding", "address": 40073, "type": "uint16", "scale_factor": "A_SF", "unit": "A", "access": "R", "description": "SunSpec AphB. Connected Phase"},
    {"name": "Phase C Current", "group": "AC side", "area": "holding", "address": 40074, "type": "uint16", "scale_factor": "A_SF", "unit": "A", "access": "R", "description": "SunSpec AphC. Connected Phase"},
