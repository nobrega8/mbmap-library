    {"name": "Phase Voltage BN", "group": "AC side", "area": "holding", "address": 40080, "type": "uint16", "scale_factor": "V_SF", "unit": "V", "access": "R", "description": "SunSpec PhVphB. Split-phase configurations only (Japanese grid, 240 V North America)"},
    {"name": "Phase Voltage CN", "group": "AC side", "area": "holding", "address": 40081, "type": "uint16", "scale_factor": "V_SF", "unit": "V", "access": "R", "description": "SunSpec PhVphC. Split-phase configurations only (Japanese grid, 240 V North America)"},
    {"name": "V_SF", "group": "Scale factors", "area": "holding", "address": 40082, "type": "int16", "access": "R", "description": "SunSpec V_SF"},
