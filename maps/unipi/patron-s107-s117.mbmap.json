  "source": "Patron S107 Modbus map v2.0, Unipi technology; Patron S117 Modbus map v2.0, Unipi technology, Unipi knowledge base page https://kb.unipi.technology/en:hw:04-extensions:downloads",
  "sources": [
    {
      "title": "Patron S107 Modbus map",
      "version": "2.0",
      "url": "https://kb.unipi.technology/_media/files:products:patron:unipi-patron-s107-modbus-map-v2.0.pdf",
      "note": "Registers and Coils sheets"
    },
    {
      "title": "Patron S117 Modbus map",
      "version": "2.0",
