{
  "$schema": "https://raw.githubusercontent.com/nobrega8/mbmap-library/main/schema/mbmap-2.schema.json",
  "mbmap": 2,
  "vendor": "Unipi technology",
  "model": "Unipi Lite",
  "models": ["Unipi Lite", "UniPi Lite"],
  "vendor_website": "www.unipi.technology",
  "description": "Unipi Lite controller: 6 digital inputs, 6 relay outputs",
  "revision": 1,
  "source": "unipi-lite-modbus-map.xlsx, Unipi knowledge base page https://kb.unipi.technology/en:hw:04-extensions:downloads",
  "sources": [
    {"title": "Unipi Lite Modbus map (unipi-lite-modbus-map.xlsx)", "url": "https://kb.unipi.technology/_media/files:products:unipi1:unipi-lite-modbus-map.xlsx", "note": "Sheets Registers, Coils and Description; listed on https://kb.unipi.technology/en:hw:04-extensions:downloads"}
  ],
  "notes": [
    "Configuration is not permanently saved: the Description sheet states it is set on each power-on. Defaults: counters 0, debounce 0 ms, outputs OFF.",
    "Multi-register values (counters, floats) are taken as big-endian (most significant register first), as in the other Unipi maps; the spreadsheet only says bit 0 is the LSB and bit 15 the MSB.",
    "The spreadsheet does not state the transport or default unit id, so the format defaults (tcp+rtu, unit 1) are kept.",
    "Coils repeat the relay outputs that also appear as bits of holding register 1."
  ],
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
  "registers": [
