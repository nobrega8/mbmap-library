  "vendor": "SunSpec Alliance",
  "model": "Inverter 101/102/103 (integer, scale factors)",
  "vendor_website": "sunspec.org",
  "description": "Generic SunSpec Modbus inverter model with integer values with scale factor registers. Used by many inverters (SolarEdge, Fronius, SMA, Kostal and others); the model and its position are set by each device",
  "revision": 1,
  "source": "SunSpec Alliance, SunSpec information model definitions (github.com/sunspec/models), models 1, 101-103",
  "notes": [
    "SunSpec Inverter 101/102/103 (integer, scale factors).",
    "The SunSpec chain starts at address 40000 ('SunS'), then the common block, then the inverter model.",
    "This map assumes a common block of 65 registers, so the inverter model starts at 40069 (as in SolarEdge inverters). A device with the 66-register common block of the specification starts it at 40070: read the Model ID row, which must show 101-103 or 111-113, to check."
  ],
  "protocol": "tcp+rtu",
  "unit_id": 1,
  "port": 502,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "enums": {
    "inverter_state": {"1": "Off", "2": "Sleeping", "3": "Starting", "4": "MPPT", "5": "Throttled", "6": "Shutting down", "7": "Fault", "8": "Standby"}
  },
  "sentinels": {
    "int16": {"-32768": "Not implemented"},
    "uint16": {"0xFFFF": "Not implemented"},
    "int32": {"-2147483648": "Not implemented"},
    "uint32": {"0xFFFFFFFF": "Not implemented"}
  },
