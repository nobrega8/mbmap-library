      "name": "Current weight",
      "group": "Weighing",
      "area": "holding",
      "address": 4096,
      "type": "int32",
      "access": "R",
      "scale": 0.1,
      "unit": "kg",
      "description": "Divide by 10 to the power of the decimal places set for the weighing channel (one decimal in the manual's example)"
    },
    {
      "name": "Partial accumulated weight",
      "group": "Weighing",
      "area": "holding",
      "address": 4098,
