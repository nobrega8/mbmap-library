    {"name": "Zone2 Room Temperature", "area": "input", "address": 12, "type": "int16", "scale": 0.1, "unit": "°C", "description": "Zone 2 room temperature"},
    {"name": "DHW Operating Mode", "area": "input", "address": 13, "type": "int16", "description": "DHW mode: 0=Disable, 1=Comfort, 2=Economy, 3=Force"},
