    {"name": "Heating Zone1 Min Water Temperature", "area": "holding", "address": 4, "type": "int16", "scale": 0.5, "unit": "°C", "description": "Minimum outgoing water temperature for heating zone 1", "access": "RW", "write_min": 25, "write_max": 55},
    {"name": "Heating Zone1 Max Outdoor Temperature", "area": "holding", "address": 5, "type": "int16", "scale": 0.5, "unit": "°C", "description": "Maximum outdoor air temperature correlation for heating zone 1", "access": "RW"},
    {"name": "Heating Zone1 Min Outdoor Temperature", "area": "holding", "address": 6, "type": "int16", "scale": 0.5, "unit": "°C", "description": "Minimum outdoor air temperature correlation for heating zone 1", "access": "RW"},
    {"name": "Heating Zone2 Fixed Water Setpoint", "area": "holding", "address": 7, "type": "int16", "scale": 0.5, "unit": "°C", "description": "Fixed outgoing water set point for heating zone 2", "access": "RW", "write_min": 25, "write_max": 55},
    {"name": "Heating Zone2 Max Water Temperature", "area": "holding", "address": 8, "type": "int16", "scale": 0.5, "unit": "°C", "description": "Maximum outgoing water temperature for heating zone 2", "access": "RW", "write_min": 25, "write_max": 55},
    {"name": "Heating Zone2 Min Water Temperature", "area": "holding", "address": 9, "type": "int16", "scale": 0.5, "unit": "°C", "description": "Minimum outgoing water temperature for heating zone 2", "access": "RW", "write_min": 25, "write_max": 55},
    {"name": "Heating Zone2 Max Outdoor Temperature", "area": "holding", "address": 10, "type": "int16", "scale": 0.5, "unit": "°C", "description": "Maximum outdoor air temperature correlation for heating zone 2", "access": "RW", "enum": {"0": "Off", "1": "Heat", "2": "Cool"}},
    {"name": "Heating Zone2 Min Outdoor Temperature", "area": "holding", "address": 11, "type": "int16", "scale": 0.5, "unit": "°C", "description": "Minimum outdoor air temperature correlation for heating zone 2", "access": "RW"},
    {"name": "Cooling Zone1 Fixed Water Setpoint", "area": "holding", "address": 13, "type": "int16", "scale": 0.5, "unit": "°C", "description": "Fixed outgoing water set point for cooling zone 1", "access": "RW", "write_min": 5, "write_max": 25, "enum": {"0": "Off", "1": "Heat"}},
    {"name": "Cooling Zone2 Fixed Water Setpoint", "area": "holding", "address": 18, "type": "int16", "scale": 0.5, "unit": "°C", "description": "Fixed outgoing water set point for cooling zone 2", "access": "RW", "write_min": 5, "write_max": 25},
    {"name": "DHW Priority", "area": "holding", "address": 26, "type": "int16", "description": "DHW production priority: 0=Standard, 1=Priority", "access": "RW"},
    {"name": "DHW Comfort Temperature", "area": "holding", "address": 27, "type": "int16", "scale": 0.5, "unit": "°C", "description": "DHW comfort temperature", "access": "RW", "write_min": 40, "write_max": 60},
    {"name": "DHW Economy Temperature", "area": "holding", "address": 28, "type": "int16", "scale": 0.5, "unit": "°C", "description": "DHW economy temperature", "access": "RW", "write_min": 40, "write_max": 60},
    {"name": "DHW Force Temperature", "area": "holding", "address": 29, "type": "int16", "scale": 0.5, "unit": "°C", "description": "DHW force temperature", "access": "RW", "write_min": 50, "write_max": 70},
    {"name": "Pump Run Time", "area": "holding", "address": 37, "type": "int16", "unit": "min", "description": "Pump run time after compressor off", "access": "RW"},
    {"name": "Pump Frequency", "area": "holding", "address": 38, "type": "int16", "unit": "Hz", "description": "Pump frequency setting", "access": "RW"},
    {"name": "Compressor Start Delay", "area": "holding", "address": 39, "type": "int16", "unit": "min", "description": "Compressor start delay", "access": "RW"},
    {"name": "Frost Protection Start Temperature", "area": "holding", "address": 50, "type": "int16", "scale": 0.5, "unit": "°C", "description": "Temperature at which frost protection starts", "access": "RW"},
    {"name": "Frost Protection Stop Temperature", "area": "holding", "address": 51, "type": "int16", "scale": 0.5, "unit": "°C", "description": "Temperature at which frost protection stops", "access": "RW"}
