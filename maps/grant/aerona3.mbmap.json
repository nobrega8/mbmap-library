    {"name": "Previous Error Code 2", "area": "input", "address": 23, "type": "int16", "description": "Previous error code 2"},
    {"name": "Previous Error Code 3", "area": "input", "address": 24, "type": "int16", "description": "Previous error code 3"},
    {"name": "Previous Error Code 4", "area": "input", "address": 25, "type": "int16", "description": "Previous error code 4"},
    {"name": "Previous Error Code 5", "area": "input", "address": 26, "type": "int16", "description": "Previous error code 5"},
    {"name": "Plate Heat Exchanger Temperature", "area": "input", "address": 32, "type": "int16", "unit": "°C", "description": "Plate heat exchanger temperature"},
