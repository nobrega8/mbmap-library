{
  "$schema": "https://raw.githubusercontent.com/nobrega8/mbmap-library/main/schema/mbmap-2.schema.json",
  "mbmap": 2,
  "vendor": "Seneca",
  "model": "S203T",
  "models": ["S203T"],
  "vendor_website": "seneca.it",
  "description": "Seneca S203T three-phase network analyzer with RS-485 Modbus RTU and analog retransmission",
  "revision": 2,
  "revised": "2026-10-17",
  "source": "Seneca, \"S203T Advanced Three-phase Network Analyzer\" user manual, MI001266-E",
  "sources": [{"title": "S203T user manual", "version": "MI001266-E", "url": "https://www.seneca.it/media/2601/mi001266-e.pdf", "note": "MODBUS REGISTERS section"}],
  "notes": [
    "All registers are holding registers: FC03 reads and FC06/FC16 writes, at most 16 registers at a time within the same group.",
    "Addresses are the manual's register numbers minus 40000, with address_base 1 (register 40135 is address 135).",
    "Floats are two registers, most significant word first. Currents are in mA.",
    "Defaults: address 1, 38400 baud, no parity.",
    "The CT ratio (40026) scales the float currents, powers and energies, not the normalised (0-10000) values."
  ],
  "protocol": "rtu",
  "unit_id": 1,
  "baudrate": 38400,
  "parity": "N",
  "databits": 8,
  "stopbits": 1,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 1,
  "x_status": "official",
  "registers": [
    {"name": "Machine ID", "group": "Device", "area": "holding", "address": 1, "type": "uint16", "access": "R", "description": "High byte: module ID (26); low byte: firmware revision"},
    {"name": "CT type", "group": "Setup", "area": "holding", "address": 24, "type": "uint16", "access": "RW", "enum": {"0": "Passive CT", "1": "Compensated CT"}, "description": "Default 0"},
    {"name": "Retransmitted phase", "group": "Setup", "area": "holding", "address": 25, "type": "uint16", "access": "RW", "description": "0 phase A, 1 phase B, 2 phase C, any other value three-phase"},
    {"name": "CT rated current", "group": "Setup", "area": "holding", "address": 26, "type": "float32", "unit": "A", "access": "RW", "description": "Default 1000.0"},
    {"name": "Retransmission minimum", "group": "Setup", "area": "holding", "address": 28, "type": "float32", "access": "RW", "description": "Value of the retransmitted quantity giving 0 % output, in its unit (V, mA or W). Default 0.0"},
    {"name": "Retransmission maximum", "group": "Setup", "area": "holding", "address": 30, "type": "float32", "access": "RW", "description": "Value giving 100 % output. Default 600.0"},
    {"name": "Frequency compensation", "group": "Setup", "area": "holding", "address": 32, "type": "uint16", "access": "RW", "enum": {"0": "Off", "1": "On"}, "description": "Corrects power and energy when the line frequency is unstable"},
    {"name": "Address and parity", "group": "Setup", "area": "holding", "address": 33, "type": "uint16", "access": "RW", "description": "High byte: address 0-255 (default 1); low byte: parity 0 none (default), 1 even, 2 odd"},
    {"name": "Baud rate and response delay", "group": "Setup", "area": "holding", "address": 34, "type": "uint16", "access": "RW", "description": "High byte: 0 4800, 1 9600, 2 19200, 3 38400 (default), 4 57600, 5 115200, 6 1200, 7 2400; low byte: response delay in pauses of 6 characters (default 0)"},
    {"name": "Reset and zero energy", "group": "Commands", "area": "holding", "address": 131, "type": "uint16", "access": "W", "enum": {"4096": "Reset active energy", "4660": "Restart the instrument"}, "description": "0x1000 resets the active energy of all phases; 0x1234 restarts"},
    {"name": "Status", "group": "Status", "area": "holding", "address": 133, "type": "uint16", "access": "R", "description": "Bit 15: error saving energy; bit 6: phases B and C reversed; bits 3-5: voltage on A, B, C above 40 V"},
