        "1788": "Ready",
        "1789": "Warm-up",
        "1790": "Synchronize",
        "1791": "Activated",
        "1792": "Re-synchronize",
        "1793": "Generator separation",
        "1794": "Shut-off delay",
        "1795": "Blocked",
        "1796": "Locked after error",
        "16777213": "Information not available"
