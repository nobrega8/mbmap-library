{
  "$schema": "https://raw.githubusercontent.com/nobrega8/mbmap-library/main/schema/mbmap-2.schema.json",
  "mbmap": 2,
  "vendor": "SMA",
  "model": "Sunny Island",
  "models": [
    "Sunny Island 3.0M",
    "Sunny Island 4.4M",
    "Sunny Island 5.0H",
    "Sunny Island 6.0H",
    "Sunny Island 8.0H"
  ],
  "vendor_website": "sma.de",
  "description": "Sunny Island battery inverter over the SMA Modbus profile (Modbus TCP): device type, status, power, battery state of charge, current, voltage and temperature, generator and operating status, and active power control",
  "revision": 1,
  "source": "SMA, Sunny Island Modbus interface, user manual SI-Modbus-BA-en-12, section 8.2",
  "sources": [
    {
      "title": "Sunny Island with Modbus interface, User Manual",
      "version": "SI-Modbus-BA-en-12",
      "url": "https://files.sma.de/downloads/SI-Modbus-BA-en-12.pdf",
      "note": "section 8.2, measured values and parameters selected",
      "accessed": "2026-11-15",
      "sha256": "e878009db8611781093bc884a7d6f87ce01129cdcea1df404b48b4e748ef18ef"
    }
  ],
  "notes": [
    "Modbus TCP through the SMA Modbus profile, unit ID 3 (the SMA standard unit ID).",
    "Addresses are the decimal Modbus registers of the manual. Values are 32-bit, high word first; FIXn formats are scaled by 10^-n.",
    "Registers 40210, 44031 and 44033 need a logon with the SMA Grid Guard code (register 43090).",
    "Written from the manufacturer's manual; not tested on a device."
  ],
  "protocol": "tcp",
  "unit_id": 3,
  "port": 502,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
  "registers": [
    {
      "name": "Device type",
      "group": "Measured values",
      "area": "input",
      "address": 30053,
      "type": "uint32",
      "access": "R",
      "enum": {
        "9331": "Sunny Island 3.0M-12",
        "9332": "Sunny Island 4.4M-12",
        "9333": "Sunny Island 6.0H-12",
        "9334": "Sunny Island 8.0H-12",
        "9474": "Sunny Island 4.4M-13",
        "9475": "Sunny Island 6.0H-13",
        "9476": "Sunny Island 8.0H-13",
        "9486": "Sunny Island 5.0H-13"
