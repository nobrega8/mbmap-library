  "parity": "N",
  "byte_order": "big",
  "word_order": "big",
  "address_base": 1,
  "enums": {
    "type_code": {"0x30": "0-20 mA", "0x31": "4-20 mA", "0x32": "±10 V"}
  },
  "x_status": "official",
