  "vendor_website": "advantech.com",
  "description": "Two-channel 32-bit counter/frequency input module with two alarm digital outputs, Modbus RTU",
  "revision": 3,
  "revised": "2026-11-13",
  "source": "Advantech, ADAM-4000 Series User Manual, Edition 9, Appendix G (I/O Modbus Mapping Table), module 16: ADAM-4080",
  "sources": [
    {
      "title": "ADAM-4000 Series User Manual",
      "version": "Edition 9 (2023)",
      "url": "https://advdownload.advantech.com/productfile/Downloadfile1/1-2IIGU49/ADAM-4000_Series_User_manual_Ed.9_FINAL.pdf",
      "note": "Appendix G, module 16"
    }
  ],
  "notes": [
    "Advantech ADAM-4080 two-channel counter/frequency module.",
    "The manual lists 0X coils from 00001 and 4X registers from 40001; address 0 here is 00001 or 40001. Coils are read with 01 and written with 05; registers are read with 03.",
    "The counter values use two registers each. The manual does not say which word comes first; this map assumes high word first.",
    "The module may ship set to the ADAM ASCII protocol: switch it to Modbus with the Adam/Apax .NET utility (Appendix H).",
    "Not tested on a device."
  ],
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
