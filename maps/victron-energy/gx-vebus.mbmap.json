    {"name": "Input current phase 2", "area": "holding", "address": 7, "type": "int16", "scale": 0.1, "unit": "A", "description": "D-Bus /Ac/ActiveIn/L2/I; Positive: current flowing from mains to Multi. Negative: current flowing from Multi to mains"},
    {"name": "Input current phase 3", "area": "holding", "address": 8, "type": "int16", "scale": 0.1, "unit": "A", "description": "D-Bus /Ac/ActiveIn/L3/I; Positive: current flowing from mains to Multi. Negative: current flowing from Multi to mains"},
    {"name": "Input frequency 1", "area": "holding", "address": 9, "type": "int16", "scale": 0.01, "unit": "Hz", "description": "D-Bus /Ac/ActiveIn/L1/F"},
    {"name": "Input frequency 2", "area": "holding", "address": 10, "type": "int16", "scale": 0.01, "unit": "Hz", "description": "D-Bus /Ac/ActiveIn/L2/F"},
