    {"name": "ESS disable charge flag phase", "area": "holding", "address": 38, "type": "uint16", "enum": {"0": "Charge allowed", "1": "Charge disabled"}, "access": "RW", "description": "D-Bus /Hub4/DisableCharge; ESS Mode 3 - Enables/Disables charge (0=enabled, 1=disabled). Note that power setpoint will yield to this setting"},
