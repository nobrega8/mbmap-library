    {"name": "Battery current", "area": "holding", "address": 27, "type": "int16", "scale": 0.1, "unit": "A", "description": "D-Bus /Dc/0/Current; Positive: current flowing from the Multi to the dc system. Negative: the other way around"},
    {"name": "Phase count", "area": "holding", "address": 28, "type": "uint16", "description": "D-Bus /Ac/NumberOfPhases"},
    {"name": "Active input", "area": "holding", "address": 29, "type": "uint16", "enum": {"0": "AC Input 1", "1": "AC Input 2", "240": "Disconnected"}, "description": "D-Bus /Ac/ActiveIn/ActiveInput"},
    {"name": "VE.Bus state of charge", "area": "holding", "address": 30, "type": "uint16", "scale": 0.1, "unit": "%", "access": "RW", "description": "D-Bus /Soc"},
    {"name": "VE.Bus state", "area": "holding", "address": 31, "type": "uint16", "enum": {"0": "Off", "1": "Low Power", "2": "Fault", "3": "Bulk", "4": "Absorption", "5": "Float", "6": "Storage", "7": "Equalize", "8": "Passthru", "9": "Inverting", "10": "Power assist", "11": "Power supply", "244": "Sustain", "252": "External control"}, "description": "D-Bus /State"},
    {"name": "VE.Bus Error", "area": "holding", "address": 32, "type": "uint16", "enum": {"0": "No error", "1": "VE.Bus Error 1: Device is switched off because one of the ot", "2": "VE.Bus Error 2: New and old types MK2 are mixed in the syste", "3": "VE.Bus Error 3: Not all- or more than- the expected devices ", "4": "VE.Bus Error 4: No other device whatsoever detected", "5": "VE.Bus Error 5: Overvoltage on AC-out", "6": "VE.Bus Error 6: Error in DDC Program", "7": "VE.Bus BMS connected- which requires an Assistant- but no as", "10": "VE.Bus Error 10: System time synchronisation problem occurre", "14": "VE.Bus Error 14: Device cannot transmit data", "16": "VE.Bus Error 16: Dongle missing", "17": "VE.Bus Error 17: One of the devices assumed master status be", "18": "VE.Bus Error 18: AC Overvoltage on the output of a slave has", "22": "VE.Bus Error 22: This device cannot function as slave", "24": "VE.Bus Error 24: Switch-over system protection initiated", "25": "VE.Bus Error 25: Firmware incompatibility. The firmware of o", "26": "VE.Bus Error 26: Internal error"}, "description": "D-Bus /VebusError"},
    {"name": "Switch Position", "area": "holding", "address": 33, "type": "uint16", "enum": {"1": "Charger Only", "2": "Inverter Only", "3": "On", "4": "Off"}, "access": "RW", "description": "D-Bus /Mode; See Venus-OS manual for limitations, for example when VE.Bus BMS or DMC is installed"},
