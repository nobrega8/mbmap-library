    {"name": "Input power 2", "area": "holding", "address": 13, "type": "int16", "scale": 10, "unit": "W", "description": "D-Bus /Ac/ActiveIn/L2/P; Sign meaning equal to Input current"},
    {"name": "Input power 3", "area": "holding", "address": 14, "type": "int16", "scale": 10, "unit": "W", "description": "D-Bus /Ac/ActiveIn/L3/P; Sign meaning eaqual to Input current"},
    {"name": "Output voltage phase 1", "area": "holding", "address": 15, "type": "uint16", "scale": 0.1, "unit": "V", "description": "D-Bus /Ac/Out/L1/V"},
    {"name": "Output voltage phase 2", "area": "holding", "address": 16, "type": "uint16", "scale": 0.1, "unit": "V", "description": "D-Bus /Ac/Out/L2/V"},
    {"name": "Output voltage phase 3", "area": "holding", "address": 17, "type": "uint16", "scale": 0.1, "unit": "V", "description": "D-Bus /Ac/Out/L3/V"},
    {"name": "Output current phase 1", "area": "holding", "address": 18, "type": "int16", "scale": 0.1, "unit": "A", "description": "D-Bus /Ac/Out/L1/I; Postive: current flowing from Multi to the load. Negative: current flowing from load to the Multi"},
    {"name": "Output current phase 2", "area": "holding", "address": 19, "type": "int16", "scale": 0.1, "unit": "A", "description": "D-Bus /Ac/Out/L2/I; Postive: current flowing from Multi to the load. Negative: current flowing from load to the Multi"},
