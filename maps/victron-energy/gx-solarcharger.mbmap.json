    {"name": "User yield (3728)", "area": "holding", "address": 3728, "type": "uint32", "unit": "kWh", "description": "D-Bus /Yield/User; Energy generated by the solarcharger since last user reset"},
    {"name": "PV power (3730)", "area": "holding", "address": 3730, "type": "uint16", "unit": "W", "description": "D-Bus /Yield/Power"},
    {"name": "MPP operation mode tracker 1", "area": "holding", "address": 3731, "type": "uint16", "enum": {"0": "Off", "1": "Voltage/current limited", "2": "MPPT active", "255": "Not available"}, "description": "D-Bus /Pv/0/MppOperationMode"},
    {"name": "MPP operation mode tracker 2", "area": "holding", "address": 3732, "type": "uint16", "enum": {"0": "Off", "1": "Voltage/current limited", "2": "MPPT active", "255": "Not available"}, "description": "D-Bus /Pv/1/MppOperationMode"},
    {"name": "MPP operation mode tracker 3", "area": "holding", "address": 3733, "type": "uint16", "enum": {"0": "Off", "1": "Voltage/current limited", "2": "MPPT active", "255": "Not available"}, "description": "D-Bus /Pv/2/MppOperationMode"},
