    {"name": "PV power for tracker 0", "area": "holding", "address": 3724, "type": "uint16", "unit": "W", "description": "D-Bus /Pv/0/P"},
    {"name": "PV power for tracker 1", "area": "holding", "address": 3725, "type": "uint16", "unit": "W", "description": "D-Bus /Pv/1/P"},
