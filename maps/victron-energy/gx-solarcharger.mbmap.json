    {"name": "Yield today for tracker 1", "area": "holding", "address": 3709, "type": "uint16", "scale": 0.1, "unit": "kWh", "description": "D-Bus /History/Daily/0/Pv/1/Yield"},
    {"name": "Yield today for tracker 2", "area": "holding", "address": 3710, "type": "uint16", "scale": 0.1, "unit": "kWh", "description": "D-Bus /History/Daily/0/Pv/2/Yield"},
    {"name": "Yield today for tracker 3", "area": "holding", "address": 3711, "type": "uint16", "scale": 0.1, "unit": "kWh", "description": "D-Bus /History/Daily/0/Pv/3/Yield"},
    {"name": "Yield yesterday for tracker 0", "area": "holding", "address": 3712, "type": "uint16", "scale": 0.1, "unit": "kWh", "description": "D-Bus /History/Daily/1/Pv/0/Yield"},
    {"name": "Yield yesterday for tracker 1", "area": "holding", "address": 3713, "type": "uint16", "scale": 0.1, "unit": "kWh", "description": "D-Bus /History/Daily/1/Pv/1/Yield"},
    {"name": "Yield yesterday for tracker 2", "area": "holding", "address": 3714, "type": "uint16", "scale": 0.1, "unit": "kWh", "description": "D-Bus /History/Daily/1/Pv/2/Yield"},
