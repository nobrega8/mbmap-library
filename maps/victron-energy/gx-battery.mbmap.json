{
  "$schema": "https://raw.githubusercontent.com/nobrega8/mbmap-library/main/schema/mbmap-2.schema.json",
  "mbmap": 2,
  "vendor": "Victron Energy",
  "model": "GX battery",
  "vendor_website": "victronenergy.com",
  "description": "Battery monitors (BMV, SmartShunt, Lynx) and managed batteries, read through a GX device",
  "revision": 2,
  "revised": "2026-10-14",
  "firmware": "Venus OS; register list 3.81",
  "source": "Victron Energy, CCGX Modbus TCP register list 3.81",
  "sources": [
    {
      "title": "CCGX Modbus TCP register list",
      "version": "3.81",
      "url": "https://www.victronenergy.com/upload/documents/CCGX-Modbus-TCP-register-list-3.81.xlsx",
      "note": "Field list, service com.victronenergy.battery"
    }
  ],
  "notes": [
    "Registers of the com.victronenergy.battery service of the GX Modbus TCP server (Settings > Integrations > Modbus TCP server).",
    "Each device on the GX has its own unit ID. Since Venus OS 2.60 they are assigned dynamically: see the list of available services on the GX device.",
    "All registers are holding registers (FC03; FC06/FC16 for the writable ones)."
  ],
  "protocol": "tcp",
  "port": 502,
  "unit_id": 225,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "registers": [
    {"name": "Battery power", "area": "holding", "address": 256, "type": "int32", "unit": "W", "description": "D-Bus /Dc/0/Power"},
    {"name": "Battery power (258)", "area": "holding", "address": 258, "type": "int16", "unit": "W", "description": "D-Bus /Dc/0/Power; Older 16-bit variant of 256"},
    {"name": "Battery voltage", "area": "holding", "address": 259, "type": "uint16", "scale": 0.01, "unit": "V", "description": "D-Bus /Dc/0/Voltage"},
    {"name": "Starter battery voltage", "area": "holding", "address": 260, "type": "uint16", "scale": 0.01, "unit": "V", "description": "D-Bus /Dc/1/Voltage"},
    {"name": "Current", "area": "holding", "address": 261, "type": "int16", "scale": 0.1, "unit": "A", "description": "D-Bus /Dc/0/Current; Postive: battery begin charged. Negative: battery being discharged"},
    {"name": "Battery temperature", "area": "holding", "address": 262, "type": "int16", "scale": 0.1, "unit": "°C", "description": "D-Bus /Dc/0/Temperature; In degrees Celsius"},
    {"name": "Mid-point voltage of the battery bank", "area": "holding", "address": 263, "type": "uint16", "scale": 0.01, "unit": "V", "description": "D-Bus /Dc/0/MidVoltage"},
    {"name": "Mid-point deviation of the battery bank", "area": "holding", "address": 264, "type": "uint16", "scale": 0.01, "unit": "%", "description": "D-Bus /Dc/0/MidVoltageDeviation"},
    {"name": "Consumed Amphours", "area": "holding", "address": 265, "type": "uint16", "scale": -0.1, "unit": "Ah", "description": "D-Bus /ConsumedAmphours; Always negative (to have the same sign as the current)"},
    {"name": "State of charge", "area": "holding", "address": 266, "type": "uint16", "scale": 0.1, "unit": "%", "description": "D-Bus /Soc"},
    {"name": "Alarm", "area": "holding", "address": 267, "type": "uint16", "enum": {"0": "No alarm", "2": "Alarm"}, "description": "D-Bus /Alarms/Alarm; 2015-01-19: Deprecated for CCGX. Value is always 0"},
    {"name": "Low voltage alarm", "area": "holding", "address": 268, "type": "uint16", "enum": {"0": "No alarm", "2": "Alarm"}, "description": "D-Bus /Alarms/LowVoltage"},
    {"name": "High voltage alarm", "area": "holding", "address": 269, "type": "uint16", "enum": {"0": "No alarm", "2": "Alarm"}, "description": "D-Bus /Alarms/HighVoltage"},
    {"name": "Low starter-voltage alarm", "area": "holding", "address": 270, "type": "uint16", "enum": {"0": "No alarm", "2": "Alarm"}, "description": "D-Bus /Alarms/LowStarterVoltage"},
    {"name": "High starter-voltage alarm", "area": "holding", "address": 271, "type": "uint16", "enum": {"0": "No alarm", "2": "Alarm"}, "description": "D-Bus /Alarms/HighStarterVoltage"},
    {"name": "Low State-of-charge alarm", "area": "holding", "address": 272, "type": "uint16", "enum": {"0": "No alarm", "2": "Alarm"}, "description": "D-Bus /Alarms/LowSoc"},
    {"name": "Low temperature alarm", "area": "holding", "address": 273, "type": "uint16", "enum": {"0": "No alarm", "2": "Alarm"}, "description": "D-Bus /Alarms/LowTemperature"},
    {"name": "High temperature alarm", "area": "holding", "address": 274, "type": "uint16", "enum": {"0": "No alarm", "2": "Alarm"}, "description": "D-Bus /Alarms/HighTemperature"},
    {"name": "Mid-voltage alarm", "area": "holding", "address": 275, "type": "uint16", "enum": {"0": "No alarm", "2": "Alarm"}, "description": "D-Bus /Alarms/MidVoltage"},
    {"name": "Low fused-voltage alarm", "area": "holding", "address": 276, "type": "uint16", "enum": {"0": "No alarm", "2": "Alarm"}, "description": "D-Bus /Alarms/LowFusedVoltage; 2014-12-13: Deprecated because over-engineered. Value is always 0"},
    {"name": "High fused-voltage alarm", "area": "holding", "address": 277, "type": "uint16", "enum": {"0": "No alarm", "2": "Alarm"}, "description": "D-Bus /Alarms/HighFusedVoltage; 2014-12-13: Deprecated because over-engineered. Value is always 0"},
    {"name": "Fuse blown alarm", "area": "holding", "address": 278, "type": "uint16", "enum": {"0": "No alarm", "2": "Alarm"}, "description": "D-Bus /Alarms/FuseBlown"},
    {"name": "High internal-temperature alarm", "area": "holding", "address": 279, "type": "uint16", "enum": {"0": "No alarm", "2": "Alarm"}, "description": "D-Bus /Alarms/HighInternalTemperature"},
    {"name": "Relay status", "area": "holding", "address": 280, "type": "uint16", "enum": {"0": "Open", "1": "Closed"}, "access": "RW", "description": "D-Bus /Relay/0/State; Not supported by CAN.Bus BMS batteries"},
    {"name": "Deepest discharge", "area": "holding", "address": 281, "type": "uint16", "scale": -0.1, "unit": "Ah", "description": "D-Bus /History/DeepestDischarge; Not supported by CAN.Bus BMS batteries"},
    {"name": "Last discharge", "area": "holding", "address": 282, "type": "uint16", "scale": -0.1, "unit": "Ah", "description": "D-Bus /History/LastDischarge; Not supported by CAN.Bus BMS batteries"},
    {"name": "Average discharge", "area": "holding", "address": 283, "type": "uint16", "scale": -0.1, "unit": "Ah", "description": "D-Bus /History/AverageDischarge; Not supported by CAN.Bus BMS batteries"},
    {"name": "Charge cycles", "area": "holding", "address": 284, "type": "uint16", "description": "D-Bus /History/ChargeCycles; Not supported by CAN.Bus BMS batteries"},
    {"name": "Full discharges", "area": "holding", "address": 285, "type": "uint16", "description": "D-Bus /History/FullDischarges; Not supported by CAN.Bus BMS batteries"},
    {"name": "Total Ah drawn", "area": "holding", "address": 286, "type": "uint16", "scale": -0.1, "unit": "Ah", "description": "D-Bus /History/TotalAhDrawn; Not supported by CAN.Bus BMS batteries"},
    {"name": "Minimum voltage", "area": "holding", "address": 287, "type": "uint16", "scale": 0.01, "unit": "V", "description": "D-Bus /History/MinimumVoltage; Not supported by CAN.Bus BMS batteries"},
    {"name": "Maximum voltage", "area": "holding", "address": 288, "type": "uint16", "scale": 0.01, "unit": "V", "description": "D-Bus /History/MaximumVoltage; Not supported by CAN.Bus BMS batteries"},
    {"name": "Time since last full charge", "area": "holding", "address": 289, "type": "uint16", "scale": 100, "unit": "s", "description": "D-Bus /History/TimeSinceLastFullCharge; Not supported by CAN.Bus BMS batteries"},
    {"name": "Automatic syncs", "area": "holding", "address": 290, "type": "uint16", "description": "D-Bus /History/AutomaticSyncs; Not supported by CAN.Bus BMS batteries"},
    {"name": "Low voltage alarms", "area": "holding", "address": 291, "type": "uint16", "description": "D-Bus /History/LowVoltageAlarms; Not supported by CAN.Bus BMS batteries"},
    {"name": "High voltage alarms", "area": "holding", "address": 292, "type": "uint16", "description": "D-Bus /History/HighVoltageAlarms; Not supported by CAN.Bus BMS batteries"},
    {"name": "Low starter voltage alarms", "area": "holding", "address": 293, "type": "uint16", "description": "D-Bus /History/LowStarterVoltageAlarms; Not supported by CAN.Bus BMS batteries"},
    {"name": "High starter voltage alarms", "area": "holding", "address": 294, "type": "uint16", "description": "D-Bus /History/HighStarterVoltageAlarms; Not supported by CAN.Bus BMS batteries"},
    {"name": "Minimum starter voltage", "area": "holding", "address": 295, "type": "uint16", "scale": 0.01, "unit": "V", "description": "D-Bus /History/MinimumStarterVoltage; Not supported by CAN.Bus BMS batteries"},
    {"name": "Maximum starter voltage", "area": "holding", "address": 296, "type": "uint16", "scale": 0.01, "unit": "V", "description": "D-Bus /History/MaximumStarterVoltage; Not supported by CAN.Bus BMS batteries"},
    {"name": "Low fused-voltage alarms", "area": "holding", "address": 297, "type": "uint16", "description": "D-Bus /History/LowFusedVoltageAlarms; 2014-12-13: Deprecated because over-engineered. Value is always 0"},
    {"name": "High fused-voltage alarms", "area": "holding", "address": 298, "type": "uint16", "description": "D-Bus /History/HighFusedVoltageAlarms; 2014-12-13: Deprecated because over-engineered. Value is always 0"},
    {"name": "Minimum fused voltage", "area": "holding", "address": 299, "type": "uint16", "scale": 0.01, "unit": "V", "description": "D-Bus /History/MinimumFusedVoltage; 2014-12-13: Deprecated because over-engineered. Value is always 0"},
    {"name": "Maximum fused voltage", "area": "holding", "address": 300, "type": "uint16", "scale": 0.01, "unit": "V", "description": "D-Bus /History/MaximumFusedVoltage; 2014-12-13: Deprecated because over-engineered. Value is always 0"},
