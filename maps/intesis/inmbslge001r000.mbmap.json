  "vendor": "Intesis",
  "model": "INMBSLGE001R000",
  "models": [
    "INMBSLGE001R000",
    "LG-RC-MBS-1"
  ],
  "vendor_website": "intesis.com",
  "description": "Modbus RTU gateway for LG air conditioners: on/off, mode, fan speed, vanes, setpoint, temperatures, alarms, error codes and gateway settings",
  "revision": 1,
  "source": "HMS Networks / Intesis, INMBSLGE001R000 user manual",
  "sources": [
    {
      "title": "INMBSLGE001R000 – Modbus RTU interface – User manual",
      "url": "https://www.hms-networks.com/docs/default-source/products/intesis/manuals-and-guides---manuals/user-manual-inmbslge001r000.pdf",
      "note": "Modbus register table",
      "accessed": "2026-11-14",
      "sha256": "5cf1afe2e380321624c47a62a97db495938a4647243a4e80727dda9a79894b0e"
    }
  ],
  "notes": [
    "Modbus RTU over EIA-485. Function 03 or 04 reads, 06 or 16 writes. The baud rate and slave address are set with the DIP switches (factory: 9600 baud, 8N1).",
    "Addresses are the protocol addresses of the manual (the PLC addresses less 1).",
    "Temperatures are in °C or °F and in degrees or tenths of a degree, as set with the DIP switches; their entries say so.",
    "Written from the manufacturer's manual; not tested on a device."
  ],
  "protocol": "rtu",
  "baudrate": 9600,
  "parity": "N",
  "databits": 8,
  "stopbits": 1,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
  "registers": [
    {
      "name": "AC unit On/Off",
      "group": "Control and status",
      "area": "holding",
      "address": 0,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "Off",
        "1": "On"
      }
    },
    {
      "name": "AC unit Mode",
      "group": "Control and status",
      "area": "holding",
      "address": 1,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "Auto",
        "1": "Heat",
        "2": "Dry",
        "3": "Fan",
        "4": "Cool"
      }
    },
    {
      "name": "AC unit Fan Speed",
      "group": "Control and status",
      "area": "holding",
      "address": 2,
      "type": "uint16",
      "access": "RW",
      "description": "0: Auto 1..7: Pos. 1 .. Pos. 7"
    },
    {
      "name": "AC unit Vane Position",
      "group": "Control and status",
      "area": "holding",
      "address": 3,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "No Swing",
        "10": "Swing",
        "11": "Swirl"
      }
    },
    {
      "name": "AC unit Temperature Setpoint",
      "group": "Control and status",
      "area": "holding",
      "address": 4,
      "type": "int16",
      "access": "RW",
      "description": "-32768 (Initialization value) 16..30ºC (ºC/x10ºC) 61..86ºF Degrees or tenths of a degree, °C or °F, as set with the DIP switches; -32768 means not initialised."
    },
    {
      "name": "AC unit Temperature reference",
      "group": "Control and status",
      "area": "holding",
      "address": 5,
      "type": "int16",
      "access": "R",
      "description": "-32768 (Initialization value) 10..38ºC (ºC/x10ºC) 50..100ºF Degrees or tenths of a degree, °C or °F, as set with the DIP switches; -32768 means not initialised."
    },
    {
      "name": "Window Contact",
      "group": "Control and status",
      "area": "holding",
      "address": 6,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "Closed",
        "1": "Open"
      }
    },
    {
      "name": "Gateway Disablement",
      "group": "Control and status",
      "area": "holding",
      "address": 7,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "Gateway enabled",
        "1": "Gateway disabled"
      }
    },
    {
      "name": "AC Remote Control Disablement",
      "group": "Control and status",
      "area": "holding",
      "address": 8,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "Remote Controller enabled",
        "1": "Remote Controller disabled"
      }
    },
    {
      "name": "AC unit Operation Time",
      "group": "Control and status",
      "area": "holding",
      "address": 9,
      "type": "uint16",
      "access": "RW",
      "description": "0..65535 (hours). Counts the time the AC unit is in “On” state."
    },
    {
      "name": "AC unit Alarm Status",
      "group": "Control and status",
      "area": "holding",
      "address": 10,
      "type": "uint16",
      "access": "R",
      "enum": {
        "0": "No alarm condition",
        "1": "Alarm condition"
      }
    },
    {
      "name": "Error Code",
      "group": "Control and status",
      "area": "holding",
      "address": 11,
      "type": "uint16",
      "access": "R",
      "description": "0: No error present 65535(-1 if it is read as signed value): Error in the communication of Gateway or Remote Controller with the AC unit. If any error is present, see the table at the end of this document."
    },
    {
      "name": "Indoor unit´s ambient temperature from external sensor (at Modbus side)",
      "group": "Control and status",
      "area": "holding",
      "address": 22,
      "type": "int16",
      "access": "RW",
      "description": "-32768: (Initialization value). No temperature is being provided from an external sensor. Any from Manufacturer: (ºC/x10ºC/ºF) Degrees or tenths of a degree, °C or °F, as set with the DIP switches; -32768 means not initialised."
    },
    {
      "name": "AC Real setpoint temperature",
      "group": "Control and status",
      "area": "holding",
      "address": 23,
      "type": "int16",
      "access": "R",
      "description": "When no external temperature is provided, this read-only register will have the same value as register 5 (PLC addressing). In all cases, it will show the current setpoint in the indoor unit. Any from Manufacturer: (ºC/x10ºC/ºF) Degrees or tenths of a degree, °C or °F, as set with the DIP switches; -32768 means not initialised."
    },
    {
      "name": "Current AC max setpoint",
      "group": "Control and status",
      "area": "holding",
      "address": 24,
      "type": "int16",
      "access": "R",
      "description": "-32768 (Initialization value) Any from Manufacturer: (ºC/x10ºC/ºF) Degrees or tenths of a degree, °C or °F, as set with the DIP switches; -32768 means not initialised."
    },
    {
      "name": "Current AC min setpoint",
      "group": "Control and status",
      "area": "holding",
      "address": 25,
      "type": "int16",
      "access": "R",
      "description": "-32768 (Initialization value) Any from Manufacturer: (ºC/x10ºC/ºF) Degrees or tenths of a degree, °C or °F, as set with the DIP switches; -32768 means not initialised."
    },
    {
      "name": "AC unit Left/Right Vane Position",
      "group": "Control and status",
      "area": "holding",
      "address": 26,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "Auto",
        "10": "Swing"
      }
    },
