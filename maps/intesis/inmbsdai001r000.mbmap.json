      "group": "Configuration",
      "area": "holding",
      "address": 13,
      "type": "uint16",
      "access": "RW",
      "description": "0 .. 30 min Factory setting: 30 min"
    },
    {
      "name": "Modbus RTU Baud rate 2400bps 4800 bps 9600 bps (default) 19200 bps 38400 bps 57600 bps 76800 bps 115200 bps",
      "group": "Configuration",
      "area": "holding",
      "address": 14,
      "type": "uint16",
      "access": "R"
