{
  "$schema": "https://raw.githubusercontent.com/nobrega8/mbmap-library/main/schema/mbmap-2.schema.json",
  "mbmap": 2,
  "vendor": "Intesis",
  "model": "INMBSMIT001I000",
  "models": [
    "INMBSMIT001I000",
    "ME-AC-MBS-1"
  ],
  "vendor_website": "intesis.com",
  "description": "Modbus RTU gateway for Mitsubishi Electric domestic air conditioners: on/off, mode, fan speed, vanes, setpoint, temperatures, alarms, error codes and gateway settings",
  "revision": 1,
  "source": "HMS Networks / Intesis, INMBSMIT001I000 user manual",
  "sources": [
    {
      "title": "INMBSMIT001I000 – Modbus RTU interface – User manual",
      "url": "https://www.hms-networks.com/docs/default-source/products/intesis/manuals-and-guides---manuals/user-manual-inmbsmit001i000.pdf",
      "note": "Modbus register table",
      "accessed": "2026-11-14",
      "sha256": "d470aff492d28e0ba573c0fba62f9e3b2a2fb64e0f88f4013073ad28e5412da1"
    }
  ],
  "notes": [
    "Modbus RTU over EIA-485. Function 03 or 04 reads, 06 or 16 writes. The baud rate and slave address are set with the DIP switches (factory: 9600 baud, 8N1).",
    "Addresses are the protocol addresses of the manual (the PLC addresses less 1).",
    "Temperatures are in °C or °F and in degrees or tenths of a degree, as set with the DIP switches; their entries say so.",
    "Written from the manufacturer's manual; not tested on a device."
  ],
  "protocol": "rtu",
  "baudrate": 9600,
  "parity": "N",
  "databits": 8,
  "stopbits": 1,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
  "registers": [
    {
      "name": "AC unit On/Off",
      "group": "Control and status",
      "area": "holding",
      "address": 0,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "Off",
        "1": "On"
      }
    },
    {
      "name": "AC unit Mode",
      "group": "Control and status",
      "area": "holding",
      "address": 1,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "Auto",
        "1": "Heat",
        "2": "Dry",
        "3": "Fan",
        "4": "Cool"
      }
    },
    {
      "name": "AC unit Fan Speed",
      "group": "Control and status",
      "area": "holding",
      "address": 2,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "Auto",
        "1": "Low",
        "2": "Mid-1",
        "3": "Mid-2",
        "4": "High"
      }
    },
    {
      "name": "AC unit Vane Position",
      "group": "Control and status",
      "area": "holding",
      "address": 3,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "Auto",
        "1": "Horizontal",
        "2": "Position-2",
        "3": "Position-3",
        "4": "Position-4",
        "5": "Vertical",
        "10": "Swing"
      }
    },
    {
      "name": "AC unit Temperature Setpoint",
      "group": "Control and status",
      "area": "holding",
      "address": 4,
      "type": "int16",
      "access": "RW",
      "description": "-32678 (Initialization value) 16..32ºC (ºC/x10ºC) 61..90ºF Degrees or tenths of a degree, °C or °F, as set with the DIP switches; -32768 means not initialised."
    },
    {
      "name": "AC unit Temperature reference",
      "group": "Control and status",
      "area": "holding",
      "address": 5,
      "type": "int16",
      "access": "R",
      "description": "-32678 (Initialization value) 10..38ºC (ºC/x10ºC) 50..100ºF Degrees or tenths of a degree, °C or °F, as set with the DIP switches; -32768 means not initialised."
    },
    {
      "name": "Window Contact",
      "group": "Control and status",
      "area": "holding",
      "address": 6,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "Closed",
        "1": "Open"
      }
    },
    {
      "name": "Gateway Disablement",
      "group": "Control and status",
      "area": "holding",
      "address": 7,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "Gateway enabled",
        "1": "Gateway disabled"
      }
    },
    {
      "name": "AC Remote Control Disablement",
      "group": "Control and status",
      "area": "holding",
      "address": 8,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "Remote Control enabled",
        "1": "Remote Control disabled"
      }
    },
    {
      "name": "AC unit Operation Time",
      "group": "Control and status",
      "area": "holding",
      "address": 9,
      "type": "uint16",
      "access": "RW",
      "description": "0..65535 (hours). Counts the time the AC unit is in “On” state."
    },
    {
      "name": "AC unit Alarm Status",
      "group": "Control and status",
      "area": "holding",
      "address": 10,
      "type": "uint16",
      "access": "R",
      "enum": {
        "0": "No alarm condition",
        "1": "Alarm condition"
      }
    },
    {
      "name": "Error Code",
      "group": "Control and status",
      "area": "holding",
      "address": 11,
      "type": "uint16",
      "access": "R",
      "description": "0: No error present 65535 (-1 if it is read as signed value): Error in the communication of Gateway with the AC unit. Any other error present, see the table at the end of this document."
    },
    {
      "name": "Indoor unit’s ambient temperature from external sensor (at Modbus side)",
      "group": "Control and status",
      "area": "holding",
      "address": 22,
      "type": "int16",
      "access": "RW",
      "description": "-32768: (Initialization value). No temperature is being provided from an external sensor. Any other: (ºC/x10ºC/ºF) Degrees or tenths of a degree, °C or °F, as set with the DIP switches; -32768 means not initialised."
    },
    {
      "name": "AC Real setpoint temperature",
      "group": "Control and status",
      "area": "holding",
      "address": 23,
      "type": "int16",
      "access": "R",
      "description": "When no external temperature is provided, this read-only register will have the same value as register 5 (PLC address). In all cases, it will show the current setpoint in the indoor unit. 16..32ºC (ºC/x10ºC) 60..90ºF Degrees or tenths of a degree, °C or °F, as set with the DIP switches; -32768 means not initialised."
    },
    {
      "name": "Block Periodic Sendings",
      "group": "Control and status",
      "area": "holding",
      "address": 97,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "Non-blocked",
        "1": "Blocked"
      }
    },
    {
      "name": "“Open Window” switch-off timeout",
      "group": "Configuration",
      "area": "holding",
      "address": 13,
      "type": "uint16",
      "access": "RW",
      "description": "0..30 (minutes) Factory setting: 30 (minutes)"
    },
    {
      "name": "Modbus RTU baud-rate",
      "group": "Configuration",
      "area": "holding",
      "address": 14,
      "type": "uint16",
      "access": "R",
      "description": "2400bps 4800bps 9600bps (Default) 19200bps 38400bps 57600bps 76800bps 115200bps"
    },
    {
      "name": "Device's Modbus Slave address",
      "group": "Configuration",
      "area": "holding",
      "address": 15,
      "type": "uint16",
      "access": "R",
      "description": "1..63"
    },
    {
      "name": "Max number of fan speeds",
      "group": "Control and status",
      "area": "holding",
      "address": 21,
      "type": "uint16",
      "access": "R",
      "description": "Value depending on position of SW1-P4"
    },
    {
      "name": "Device ID",
      "group": "Configuration",
      "area": "holding",
      "address": 49,
      "type": "uint16",
      "access": "R",
      "description": "Reads 0x0500 for this gateway.",
      "enum": {
        "1280": "INMBSMIT001I000"
      }
    },
    {
      "name": "Software version",
      "group": "Configuration",
      "area": "holding",
      "address": 50,
      "type": "uint16",
      "access": "R",
      "role": "firmware"
    }
  ]
}
