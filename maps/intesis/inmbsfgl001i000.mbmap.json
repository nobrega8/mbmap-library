        "3": "Med",
        "4": "High"
      }
    },
    {
      "name": "AC unit Vane Position",
      "group": "Control and status",
      "area": "holding",
      "address": 3,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "1": "Position-1 (Horizontal)",
        "2": "Position-2 (Horizontal)",
        "3": "Position-3 (Medium)",
        "4": "Position-4 (Vertical)",
        "10": "Swing"
      }
    },
    {
      "name": "AC unit Temperature Setpoint",
      "group": "Control and status",
      "area": "holding",
      "address": 4,
      "type": "int16",
      "access": "RW",
      "description": "-32768 (Initialization value) 16..30 (ºC) (0 = undetermined) 61..86 (ºF) (0 = undetermined) Degrees or tenths of a degree, °C or °F, as set with the DIP switches; -32768 means not initialised."
    },
    {
      "name": "AC unit Temperature reference",
      "group": "Control and status",
      "area": "holding",
      "address": 5,
      "type": "int16",
      "access": "R",
      "description": "18..30 (ºC) (0 = undetermined) 64,4..86 (ºF) (0 = undetermined) 0x8000 There is no temperature sent from the Remote controller Degrees or tenths of a degree, °C or °F, as set with the DIP switches; -32768 means not initialised."
    },
    {
