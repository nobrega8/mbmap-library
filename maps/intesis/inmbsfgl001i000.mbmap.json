  "vendor_website": "intesis.com",
  "description": "Modbus RTU gateway for Fujitsu domestic air conditioners: on/off, mode, fan speed, vanes, setpoint, temperatures, alarms, error codes and gateway settings",
  "revision": 1,
  "source": "HMS Networks / Intesis, INMBSFGL001I000 user manual",
  "sources": [
    {
      "title": "INMBSFGL001I000 – Modbus RTU interface – User manual",
      "url": "https://www.hms-networks.com/docs/default-source/products/intesis/manuals-and-guides---manuals/user-manual-inmbsfgl001i000.pdf",
      "note": "Modbus register table",
      "accessed": "2026-11-14",
      "sha256": "d9f415d4b95362d15c1005cbb76d5bcd165761faccc2837ae36f6dec67638a2e"
    }
  ],
  "notes": [
    "Modbus RTU over EIA-485. Function 03 or 04 reads, 06 or 16 writes. The baud rate and slave address are set with the DIP switches (factory: 9600 baud, 8N1).",
    "Addresses are the protocol addresses of the manual (the PLC addresses less 1).",
    "Temperatures are in °C or °F and in degrees or tenths of a degree, as set with the DIP switches; their entries say so.",
    "Written from the manufacturer's manual; not tested on a device."
  ],
  "protocol": "rtu",
  "baudrate": 9600,
  "parity": "N",
  "databits": 8,
  "stopbits": 1,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
  "registers": [
    {
      "name": "AC unit On/Off",
      "group": "Control and status",
      "area": "holding",
      "address": 0,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "Off",
        "1": "On"
      }
    },
    {
      "name": "AC unit Mode",
      "group": "Control and status",
      "area": "holding",
      "address": 1,
      "type": "uint16",
      "access": "RW",
      "enum": {
        "0": "Auto",
        "1": "Heat",
        "2": "Dry",
        "3": "Fan",
        "4": "Cool"
      }
    },
    {
      "name": "AC unit Fan Speed",
      "group": "Control and status",
      "area": "holding",
