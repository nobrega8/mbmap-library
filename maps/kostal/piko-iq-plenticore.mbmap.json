  "source": "KOSTAL Solar Electric, \"PIKO IQ/PLENTICORE KOSTAL Interface description MODBUS (TCP) & SunSpec\", revision 2.7 (2025-11-20)",
  "sources": [{"title": "PIKO IQ/PLENTICORE KOSTAL Interface description MODBUS (TCP) & SunSpec", "version": "2.7", "date": "2025-11-20", "note": "chapter 3, the Modbus register tables (SunSpec models are not part of this map); valid from PIKO/PLENTICORE G1 UI 01.30.12092, G2 SW 02.15, G3 and MP G3 SW 3.06.00"}],
  "notes": ["Modbus TCP is off by default: enable it in the web interface under Settings > Modbus / SunSpec (TCP). The default TCP port is 1502 and the unit ID 71 (both can be changed).", "Function codes 03, 06 and 16. The byte order is set in the web interface: 'little-endian (CDAB) Standard Modbus' (the default, used here) or 'big-endian (ABCD) SunSpec'. Strings use two characters per register.", "Registers marked as scale factors hold a signed power of ten: value = register x 10^factor.", "The active power, reactive power and delta cos φ setpoints are not kept over a restart of the inverter.", "Not in this map: the SunSpec models (1, 103, 113, 120, 123, 160, 203, 802), which start at register 40003; see the SunSpec Alliance map."],
  "protocol": "tcp",
  "unit_id": 71,
  "port": 1502,
  "byte_order": "big",
  "word_order": "little",
  "address_base": 0,
  "x_status": "official",
  "enums": {
    "inverter_state": {"0": "Off", "1": "Init", "2": "IsoMeas", "3": "GridCheck", "4": "StartUp", "6": "FeedIn", "7": "Throttled", "8": "ExtSwitchOff", "9": "Update", "10": "Standby", "11": "GridSync", "12": "GridPreCheck", "13": "GridSwitchOff", "14": "Overheating", "15": "Shutdown", "16": "ImproperDcVoltage", "17": "ESB", "18": "Unknown"},
    "energy_manager_state": {"0": "Idle", "2": "Emergency battery charge", "8": "Winter mode step 1", "16": "Winter mode step 2"},
    "byte_order": {"0": "Little-endian (CDAB)", "1": "Big-endian (ABCD)"},
    "battery_type": {"0": "No battery (PV only)", "2": "PIKO Battery Li", "4": "BYD", "8": "BMZ", "16": "AXIstorage Li SH", "64": "LG", "512": "Pyontech Force H", "1024": "AXIstorage Li SV", "4096": "Dyness Tower / TowerPro", "8192": "VARTA.wall", "16384": "ZYC"},
    "battery_mode": {"0": "No external battery management", "1": "External battery management via digital I/O", "2": "External battery management via Modbus"},
    "sensor_type": {"0": "SDM 630 (B+G E-Tech)", "1": "B-Control EM-300 LR (TQ Systems)", "3": "KOSTAL Smart Energy Meter", "255": "No sensor"}
  },
