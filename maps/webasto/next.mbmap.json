{
  "$schema": "https://raw.githubusercontent.com/nobrega8/mbmap-library/main/schema/mbmap-2.schema.json",
  "mbmap": 2,
  "vendor": "Webasto",
  "model": "NEXT",
  "vendor_website": "webasto.com",
  "description": "EV charging station with a Modbus TCP server for energy management systems",
  "revision": 1,
  "revised": "2026-11-11",
  "source": "Webasto, Modbus Specification Webasto NEXT, register list revision 3.00 (2022-04-27)",
  "sources": [
    {
      "title": "Modbus Specification Webasto NEXT (Webasto_NEXT_Modbus_Register_1-00_external_V3)",
      "version": "3.00",
      "date": "2022-04-27",
      "note": "All registers in the document belong to the master device TQ-DM100"
    }
  ],
  "notes": [
    "Modbus TCP, port 502, unit ID 255. Each wallbox needs its own IP address on the subnet and the energy manager is the Modbus client. All registers are holding registers.",
    "Two-register values are listed in the document as address + address+1 (for example 1020+1021); the word order is not stated and big is assumed.",
    "The register list is under the master device 'TQ-DM100'. Webasto Live has a setting for its register address set (the TQ-DM100 set is one of the options); this document is only for the NEXT, so the Live is not covered by it.",
    "Write-only registers (5000 charge power, 5004 charge current, 5006 start or cancel) are marked W. Safe current and the communication timeout apply if the energy manager stops writing the life bit (6000).",
    "Webasto gives no support for this document; the manufacturer's notice says problems that arise from using it are the customer's responsibility."
  ],
  "protocol": "tcp",
  "port": 502,
  "unit_id": 255,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
  "enums": {
    "cp_state": {
      "0": "No vehicle attached",
      "1": "Vehicle attached, no permission (preparing)",
      "3": "Charging",
      "4": "Charging paused",
      "7": "Charging error",
      "8": "Charging station reserved"
    },
    "charge_state": {
      "0": "Idle",
      "1": "Charging"
    },
    "evse_state": {
      "0": "Starting",
      "1": "Running",
      "2": "Error"
    },
    "cable_state": {
      "0": "No cable attached",
      "1": "Cable attached (no car attached)",
      "2": "Cable attached (car attached)",
      "3": "Cable attached (car attached) and lock active"
    },
    "errors": {
      "0": "No error",
      "1": "Relay welded closed",
      "2": "Internal aux voltage",
      "3": "Control pilot communication",
      "4": "Grid over-voltage",
      "5": "Grid under-voltage",
      "6": "Over-current drawn by the car",
      "7": "VAC frequency",
      "8": "Ground missing or resistance too high",
      "9": "Residual current monitor self test",
      "10": "Over-temperature",
      "11": "Proximity pilot",
      "12": "Shutter",
      "13": "Three phase check",
      "14": "PWR internal error",
      "15": "Negative control pilot out of range",
      "16": "DC residual current"
    },
    "session_cmd": {
      "0": "No action",
      "1": "Start charging session",
      "2": "Cancel charging session"
    }
  },
