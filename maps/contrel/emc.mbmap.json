  "source": "Contrel EMC series communication protocol, instruction manual IM154-U v0.94",
  "sources": [
    {"title": "EMC series electrical multifunction meter communication protocol", "version": "IM154-U v0.94", "note": "register tables, pages 8-11"}
  ],
  "notes": [
    "Every value is a 32-bit integer in two registers, high word first.",
    "A value the meter cannot measure reads 0.",
    "The meter answers at most 32 registers (16 values) per read; a read must not split a value.",
    "Energy T1 is the total or time band 1 counter and T2 the partial or time band 2 counter, depending on the energy mode. Meters without these functions only have T1.",
    "The model and firmware are reported by Report Slave ID (FC17), not by a register: slave ID 0x50, firmware in data bytes 19-20, options in bytes 17-18.",
    "The manual does not give the scale of the power factor and cos phi registers."
  ],
  "protocol": "rtu",
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "max_read_registers": 32,
  "enums": {
    "do_mode_1": {"1": "Active energy pulses", "2": "Three-phase alarm", "3": "Max/min L1-L2-L3 alarm", "4": "Remote control"},
    "do_mode_2": {"1": "Reactive energy pulses", "2": "Three-phase alarm", "3": "Max/min L1-L2-L3 alarm", "4": "Remote control"},
    "do_control": {"0x000055AA": "Off", "0x010055AA": "On"}
  },
