{
  "$schema": "https://raw.githubusercontent.com/nobrega8/mbmap-library/main/schema/mbmap-2.schema.json",
  "mbmap": 2,
  "vendor": "Moxa",
  "model": "ioLogik E1241",
  "models": ["ioLogik E1241", "ioLogik E1241-T"],
  "vendor_website": "moxa.com",
  "description": "Remote Ethernet I/O with 4 analog outputs and a two-port Ethernet switch",
  "revision": 2,
  "revised": "2026-10-17",
  "source": "Moxa, \"ioLogik E1200 Series User Manual\", version 16.1 (April 2024), Appendix A",
  "sources": [{"title": "ioLogik E1200 Series User Manual", "version": "16.1", "date": "2024-04", "url": "https://moxa.ru/files/Manuals_IE/moxa-iologik-e1200-series-manual-v16_1.pdf", "note": "Appendix A, Modbus/TCP default address mappings"}],
  "notes": [
    "Default Modbus/TCP address map (Appendix A). The addresses can be changed in the web console under user-defined Modbus addressing; this map fits the defaults.",
    "32-bit values are high word first.",
    "Scaled values are float32."
  ],
  "protocol": "tcp",
  "unit_id": 1,
  "port": 502,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
  "registers": [
    {"name": "AO 0 scaled value", "group": "AO", "area": "holding", "address": 0, "type": "float32", "access": "RW"},
    {"name": "AO 1 scaled value", "group": "AO", "area": "holding", "address": 2, "type": "float32", "access": "RW"},
    {"name": "AO 2 scaled value", "group": "AO", "area": "holding", "address": 4, "type": "float32", "access": "RW"},
    {"name": "AO 3 scaled value", "group": "AO", "area": "holding", "address": 6, "type": "float32", "access": "RW"},
    {"name": "AO 0 raw value", "group": "AO", "area": "holding", "address": 1024, "type": "uint16", "access": "RW"},
    {"name": "AO 1 raw value", "group": "AO", "area": "holding", "address": 1025, "type": "uint16", "access": "RW"},
    {"name": "AO 2 raw value", "group": "AO", "area": "holding", "address": 1026, "type": "uint16", "access": "RW"},
    {"name": "AO 3 raw value", "group": "AO", "area": "holding", "address": 1027, "type": "uint16", "access": "RW"},
    {"name": "AO 0 peer-to-peer status", "group": "AO peer-to-peer", "area": "discrete", "address": 4096, "type": "bool", "access": "R", "enum": {"0": "Off", "1": "On"}},
    {"name": "AO 1 peer-to-peer status", "group": "AO peer-to-peer", "area": "discrete", "address": 4097, "type": "bool", "access": "R", "enum": {"0": "Off", "1": "On"}},
    {"name": "AO 2 peer-to-peer status", "group": "AO peer-to-peer", "area": "discrete", "address": 4098, "type": "bool", "access": "R", "enum": {"0": "Off", "1": "On"}},
    {"name": "AO 3 peer-to-peer status", "group": "AO peer-to-peer", "area": "discrete", "address": 4099, "type": "bool", "access": "R", "enum": {"0": "Off", "1": "On"}},
    {"name": "AO 0 peer-to-peer safe mode flag", "group": "AO peer-to-peer", "area": "discrete", "address": 4112, "type": "bool", "access": "R", "enum": {"0": "Off", "1": "On"}},
    {"name": "AO 1 peer-to-peer safe mode flag", "group": "AO peer-to-peer", "area": "discrete", "address": 4113, "type": "bool", "access": "R", "enum": {"0": "Off", "1": "On"}},
    {"name": "AO 2 peer-to-peer safe mode flag", "group": "AO peer-to-peer", "area": "discrete", "address": 4114, "type": "bool", "access": "R", "enum": {"0": "Off", "1": "On"}},
    {"name": "AO 3 peer-to-peer safe mode flag", "group": "AO peer-to-peer", "area": "discrete", "address": 4115, "type": "bool", "access": "R", "enum": {"0": "Off", "1": "On"}},
    {"name": "AO 0 peer-to-peer safe mode flag clear", "group": "AO peer-to-peer", "area": "coil", "address": 4128, "type": "bool", "access": "RW", "description": "Write 1 to clear the safe mode flag"},
    {"name": "AO 1 peer-to-peer safe mode flag clear", "group": "AO peer-to-peer", "area": "coil", "address": 4129, "type": "bool", "access": "RW", "description": "Write 1 to clear the safe mode flag"},
    {"name": "AO 2 peer-to-peer safe mode flag clear", "group": "AO peer-to-peer", "area": "coil", "address": 4130, "type": "bool", "access": "RW", "description": "Write 1 to clear the safe mode flag"},
    {"name": "AO 3 peer-to-peer safe mode flag clear", "group": "AO peer-to-peer", "area": "coil", "address": 4131, "type": "bool", "access": "RW", "description": "Write 1 to clear the safe mode flag"},
    {"name": "Watchdog alarm flag clear", "group": "System", "area": "coil", "address": 4144, "type": "bool", "access": "RW", "description": "Write 1 to clear the watchdog alarm"},
    {"name": "Model name", "group": "System", "area": "input", "address": 5000, "type": "string", "length": 10, "access": "R"},
    {"name": "Device up time", "group": "System", "area": "input", "address": 5020, "type": "uint32", "unit": "s", "access": "R"},
    {"name": "LAN MAC address bytes 1-2", "group": "System", "area": "input", "address": 5024, "type": "uint16", "access": "R", "description": "MAC address, two bytes per register, first byte high"},
    {"name": "LAN MAC address bytes 3-4", "group": "System", "area": "input", "address": 5025, "type": "uint16", "access": "R"},
    {"name": "LAN MAC address bytes 5-6", "group": "System", "area": "input", "address": 5026, "type": "uint16", "access": "R"},
    {"name": "LAN IP address", "group": "System", "area": "input", "address": 5027, "type": "uint32", "access": "R", "description": "One byte per octet, first octet in the high byte"},
    {"name": "Firmware version major", "group": "System", "area": "input", "address": 5029, "type": "uint16", "bit": 8, "bits": 8, "access": "R", "role": "firmware"},
    {"name": "Firmware version minor", "group": "System", "area": "input", "address": 5029, "type": "uint16", "bit": 0, "bits": 8, "access": "R", "role": "firmware"},
    {"name": "Firmware version patch", "group": "System", "area": "input", "address": 5030, "type": "uint16", "bit": 8, "bits": 8, "access": "R", "role": "firmware"},
    {"name": "Firmware build date", "group": "System", "area": "input", "address": 5031, "type": "uint32", "access": "R", "description": "e.g. Build16051718 reads as 16051718"},
    {"name": "Device name", "group": "System", "area": "input", "address": 5040, "type": "string", "length": 30, "access": "R"}
  ]
}
