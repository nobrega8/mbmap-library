  "sources": [{"title": "Bedienungsanleitung - Energy Meter - BasicLine (EM111-RTU-2P-MID, EM111-MBUS-2P-MID)", "version": "00", "date": "2025-06", "url": "https://assets.dam.weidmueller.com/assets/api/812dea46-e1c5-4f86-8714-dbf9b91c55aa/original/3149630000_00_06-2025_OPIN_EM_111_MID_de.pdf", "note": "chapter 6, Modbus-Register (document 3149630000)"}],
  "source": "Weidmüller, Bedienungsanleitung Energy Meter BasicLine, 3149630000, 00/06.2025",
  "notes": ["Addresses are the hexadecimal protocol start addresses of the manual (30001 is address 0). Measurements are read with function code 4 and the settings with function codes 3 and 16.", "The manual does not state the byte or word order; floats are read big-endian.", "Most settings are 32-bit floats holding a whole number. Parity and stop bits and baud rate need a restart to take effect.", "The display says the parity default is none, while the parity register says the default is 1 (even). The map follows the display.", "Meter is delivered with ID 1 and 2400 baud; the display allows 1200 to 9600 baud."],
  "protocol": "rtu",
  "unit_id": 1,
  "baudrate": 2400,
  "parity": "N",
  "databits": 8,
  "stopbits": 1,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 0,
  "x_status": "official",
