    {"name": "Maximum current demand", "group": "Demand", "area": "input", "address": 264, "type": "float32", "unit": "A"},
    {"name": "Total active energy", "group": "Energy", "area": "input", "address": 342, "type": "float32", "unit": "kWh"},
    {"name": "Total reactive energy", "group": "Energy", "area": "input", "address": 344, "type": "float32", "unit": "kvarh"},
    {"name": "Demand period", "group": "Settings", "area": "holding", "address": 2, "type": "float32", "access": "RW", "unit": "min", "description": "Allowed values 0, 5, 8, 10, 15, 20, 30 and 60 minutes (default 60). At 0 the demand shows the present value and the maximum demand the highest value since the last reset"},
    {"name": "Pulse 1 width", "group": "Settings", "area": "holding", "address": 12, "type": "float32", "access": "RW", "unit": "ms", "description": "Allowed values 60, 100 and 200 ms (default 60)"},
    {"name": "Parity and stop bits", "group": "Settings", "area": "holding", "address": 18, "type": "float32", "access": "RW", "description": "0 = one stop bit, no parity; 1 = one stop bit, even parity; 2 = one stop bit, odd parity; 3 = two stop bits, no parity. Needs a restart to take effect", "write_min": 0, "write_max": 3},
    {"name": "Meter ID", "group": "Settings", "area": "holding", "address": 20, "type": "float32", "access": "RW", "write_min": 1, "write_max": 247, "description": "Modbus address, 1 to 247"},
    {"name": "Baud rate", "group": "Settings", "area": "holding", "address": 28, "type": "float32", "access": "RW", "description": "0 = 2400 baud, 1 = 4800, 2 = 9600, 5 = 1200 (default 2400)"},
    {"name": "Pulse output 1 mode", "group": "Settings", "area": "holding", "address": 86, "type": "float32", "access": "RW", "description": "Energy that pulse output 1 counts: 1 = import active, 2 = total active, 4 = export active (default), 5 = import reactive, 6 = total reactive, 8 = export reactive"},
    {"name": "Reset demand data", "group": "Settings", "area": "holding", "address": 61456, "type": "uint16", "access": "W", "comment": "Write 0 to reset the demand information"},
    {"name": "Scroll time", "group": "Settings", "area": "holding", "address": 63744, "type": "uint16", "access": "RW", "comment": "BCD value, 0 to 30 s; 0 (default) means no screen change"},
    {"name": "Pulse output 1 constant", "group": "Settings", "area": "holding", "address": 63760, "type": "uint16", "access": "RW", "enum": {"0": "0.001 kWh/pulse", "1": "0.01 kWh/pulse", "2": "0.1 kWh/pulse", "3": "1 kWh/pulse"}},
    {"name": "Measurement mode", "group": "Settings", "area": "holding", "address": 63776, "type": "uint16", "access": "RW", "enum": {"1": "Mode 1 (total = import)", "2": "Mode 2 (total = import + export)", "3": "Mode 3 (total = import - export)"}},
    {"name": "Serial number", "group": "Identification", "area": "holding", "address": 64512, "type": "uint32", "role": "serial"},
    {"name": "Meter code", "group": "Identification", "area": "holding", "address": 64514, "type": "uint16", "reference": 32, "description": "Fixed code 0x0020"}
