    {"title": "PowerLogic EM3502, EM3550 Compact Power and Energy Meter Installation Guide", "version": "ZL0092-0A, 11/2011", "url": "https://download.se.com/files?p_Doc_Ref=ZL0092-0&p_enDocType=User+guide", "note": "Modbus Point Map, Table 10 (pages 21 to 27); Standard Modbus Default Settings", "accessed": "2026-11-15", "sha256": "9c7d8886208b60755de2e73e958ce86de9dfa4ad4a68cf03381b9ebf5497a016"}
