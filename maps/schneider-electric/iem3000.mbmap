# Schneider Electric Acti9 iEM3000 energy meters with Modbus RS-485 (iEM3150/3155, iEM3250/3255, iEM3350/3355).
# Addresses are the manual's register numbers (address on the wire = register - 1).
# The meter only supports FC03 (read) and FC16 (write). Settings marked WC in the manual are changed
# through the command interface (registers 5250+), so they are listed here as read-only.
# Rows marked "not on iEM3x50" only exist on the iEM3155 / iEM3255 / iEM3355.
@mbmap=1
@vendor=Schneider Electric
@model=Acti9 iEM3000 (iEM3150 / iEM3155 / iEM3250 / iEM3255 / iEM3350 / iEM3355)
@vendor_website=se.com
@description=DIN rail three-phase energy meters with Modbus RS-485: iEM3150/3155 (63 A direct), iEM3250/3255 (CT), iEM3350/3355 (125 A direct)
@source=Schneider Electric, "iEM3100 / iEM3200 / iEM3300 series User Manual", DOCA0005EN-16; https://www.productinfo.schneider-electric.com/iem3100_iem3200_iem3300/
@protocol=rtu
@unit_id=1
@baudrate=19200
@parity=E
@databits=8
@stopbits=1
@byte_order=ABCD
@address_base=1
@enum_power_system=0=1PH2W L-N|1=1PH2W L-L|2=1PH3W L-L with N|3=3PH3W|11=3PH4W|13=1PH4W multi L with N
@enum_baud=0=9600|1=19200|2=38400
@enum_parity=0=Even|1=Odd|2=None

