{
  "$schema": "https://raw.githubusercontent.com/nobrega8/mbmap-library/main/schema/mbmap-2.schema.json",
  "mbmap": 2,
  "vendor": "CTM Electrónica",
  "model": "OD-8",
  "models": [
    "OD-8"
  ],
  "vendor_website": "ctmelectronica.ar",
  "description": "8 digital output module, Modbus RTU: output state, power-up and watchdog safe values and serial settings",
  "revision": 1,
  "source": "CTM Electrónica, OD-8 Manual del usuario (Modbus V3), V3",
  "sources": [
    {
      "title": "OD-8 Manual del usuario (Modbus V3)",
      "version": "V3",
      "url": "https://ctmelectronica.ar/wp-content/uploads/2023/08/Manual-OD8Modbus-V3.pdf",
      "note": "Register, coil and function tables",
      "accessed": "2026-11-15",
      "sha256": "8a91921017f977fcd8045daf95e9816f365391093d49ea8aba8802cebda2e5db"
    }
  ],
  "notes": [
    "After a watchdog alarm sets the safe value, the outputs ignore write commands until Watchdog alarm event is cleared.",
    "Functions 1/2 (coils) and 3/4 (registers) are accepted, 0xxxx mirrors 1xxxx and 3xxxx mirrors 4xxxx; functions 5, 6, 15, 16 and 8 (diagnostics) also work.",
    "Register numbers are those of the manual (40001 is the first holding register), counted from 1 (address_base 1).",
    "Serial settings are configurable; the baudrate shown is the factory default. Modbus RTU speeds 1200 to 115200 bps.",
    "Written from the manufacturer's manual (in Spanish); not tested on a device."
  ],
  "protocol": "rtu",
  "unit_id": 2,
  "baudrate": 9600,
  "parity": "N",
  "databits": 8,
  "stopbits": 1,
  "byte_order": "big",
  "word_order": "big",
  "address_base": 1,
  "x_status": "official",
  "registers": [
    {
      "name": "Watchdog alarm enable",
      "group": "Coils",
      "area": "coil",
      "address": 1,
      "type": "bool",
      "access": "RW",
      "description": "1 enables the watchdog alarm"
    },
    {
      "name": "Watchdog alarm event",
      "group": "Coils",
      "area": "coil",
      "address": 2,
      "type": "bool",
      "access": "RW",
      "description": "1 = no message within the watchdog time; write 0 to clear"
    },
    {
      "name": "Power-up event",
      "group": "Coils",
      "area": "coil",
      "address": 3,
      "type": "bool",
      "access": "RW",
      "description": "1 = the device was powered up since the flag was cleared"
    },
    {
      "name": "Output #7",
      "group": "Coils",
      "area": "coil",
      "address": 17,
      "type": "bool",
      "access": "RW",
      "description": "1 = output ON"
    },
    {
      "name": "Output #6",
      "group": "Coils",
      "area": "coil",
      "address": 18,
      "type": "bool",
      "access": "RW",
      "description": "1 = output ON"
    },
    {
      "name": "Output #5",
      "group": "Coils",
      "area": "coil",
      "address": 19,
      "type": "bool",
      "access": "RW",
      "description": "1 = output ON"
    },
    {
