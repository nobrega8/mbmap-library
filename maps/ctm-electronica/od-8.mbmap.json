      "group": "Coils",
      "area": "coil",
      "address": 20,
      "type": "bool",
      "access": "RW",
      "description": "1 = output ON"
    },
    {
      "name": "Output #3",
      "group": "Coils",
      "area": "coil",
      "address": 21,
      "type": "bool",
      "access": "RW",
      "description": "1 = output ON"
    },
    {
      "name": "Output #2",
      "group": "Coils",
      "area": "coil",
      "address": 22,
      "type": "bool",
      "access": "RW",
      "description": "1 = output ON"
    },
    {
      "name": "Output #1",
      "group": "Coils",
      "area": "coil",
      "address": 23,
      "type": "bool",
      "access": "RW",
      "description": "1 = output ON"
    },
    {
      "name": "Output #0",
      "group": "Coils",
      "area": "coil",
      "address": 24,
      "type": "bool",
      "access": "RW",
      "description": "1 = output ON"
    },
    {
      "name": "Firmware version (high)",
      "group": "Identification",
      "area": "holding",
      "address": 2,
      "type": "uint16",
      "access": "R",
      "description": "Hexadecimal; factory value 12",
      "role": "firmware"
    },
    {
      "name": "Firmware version (low)",
      "group": "Identification",
      "area": "holding",
      "address": 3,
      "type": "uint16",
      "access": "R",
      "description": "Hexadecimal; factory value 34",
      "role": "firmware"
    },
    {
      "name": "Device name",
      "group": "Identification",
      "area": "holding",
      "address": 4,
      "type": "string",
      "access": "RW",
      "description": "4 ASCII characters, user-editable; factory \"CTM1\"",
      "length": 2
    },
    {
      "name": "Communication",
      "group": "Configuration",
      "area": "holding",
      "address": 6,
      "type": "uint16",
      "access": "RW",
      "description": "Serial speed (bits B2..B0); factory value 2",
      "enum": {
        "0": "1200 bps",
        "1": "2400 bps",
        "2": "9600 bps",
        "3": "19200 bps",
        "4": "115200 bps"
      }
    },
    {
      "name": "Address",
      "group": "Configuration",
      "area": "holding",
      "address": 7,
      "type": "uint16",
      "access": "RW",
      "description": "Modbus address, 1 to 254 (255 is broadcast)"
    },
    {
      "name": "Watchdog timer",
      "group": "Configuration",
      "area": "holding",
      "address": 9,
      "type": "uint16",
      "access": "RW",
      "description": "In 0.1 s steps; 100 = 10 s",
      "unit": "0.1 s"
    },
    {
      "name": "Coils (mirror)",
      "group": "Outputs",
      "area": "holding",
      "address": 10,
      "type": "uint16",
      "access": "R",
      "description": "Mirror of the coil table, one bit per coil (bit layout in the manual)"
    },
    {
      "name": "Digital outputs",
      "group": "Outputs",
      "area": "holding",
      "address": 11,
      "type": "uint16",
      "access": "RW",
      "description": "Bits 8-15 = output #0 to #7"
    },
    {
      "name": "Power-up / safe value",
      "group": "Outputs",
      "area": "holding",
      "address": 12,
      "type": "uint16",
      "access": "RW",
      "description": "Bits 8-15 = state of outputs #0-#7 at power-up; bits 0-7 = state taken on a watchdog alarm"
    }
  ]
}
