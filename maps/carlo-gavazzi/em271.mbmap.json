  "unit_id": 1,
  "baudrate": 9600,
  "parity": "N",
  "byte_order": "big",
  "word_order": "little",
  "address_base": 0,
  "max_read_registers": 18,
  "sentinels": {
    "int32": {"0x7FFFFFFF": "Overflow (EEE)", "0x7FFEFFFF": "Current sensor missing", "0x7FFDFFFF": "Not in this measuring system"}
  },
