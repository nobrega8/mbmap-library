    "baud": {"0": "9600 bit/s", "1": "19200 bit/s", "2": "38400 bit/s"},
    "bytes": {"0": "8 data bits, no parity, 1 stop bit", "1": "8 data bits, even parity, 1 stop bit", "2": "8 data bits, odd parity, 1 stop bit", "3": "8 data bits, no parity, 2 stop bits", "4": "8 data bits, even parity, 2 stop bits", "5": "8 data bits, odd parity, 2 stop bits"},
    "protocol": {"0": "HMI", "1": "Reserved", "2": "Modbus RTU", "6": "HMI and Modbus RTU"},
    "comm_error": {"0": "Inactive", "1": "Disable via Run/Stop", "2": "Disable via General Enable", "3": "Change to local", "4": "Change to local, keeping commands and reference", "5": "Cause a fault"},
    "serial_status": {"0": "Inactive", "1": "Active", "2": "Watchdog error"}
