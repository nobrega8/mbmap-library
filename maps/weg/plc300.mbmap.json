    "baud": {"0": "1200 bit/s", "1": "2400 bit/s", "2": "4800 bit/s", "3": "9600 bit/s", "4": "19200 bit/s", "5": "38400 bit/s", "6": "57600 bit/s"},
    "rs485_mode": {"0": "Modbus RTU slave", "1": "Modbus RTU master"},
