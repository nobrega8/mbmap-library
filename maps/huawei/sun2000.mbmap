# Huawei SUN2000 grid-tied solar inverters (residential L0/L1/M0/M1 and commercial M2/M3/H/KTL ranges).
# Core read-only registers from the "Solar Inverter Modbus Interface Definitions (V3.0)" list.
# RTU over RS485/MBUS, or TCP (port 502) through the WLAN/FE/4G interface or a dongle. Registers are read with FC03.
# The document gives no factory serial settings or default unit id; check them on the inverter or app.
# Registers a model does not have return an exception or 0.
@mbmap=1
@vendor=Huawei
@model=SUN2000
@vendor_website=solar.huawei.com
@description=Grid-tied PV inverters (SUN2000-xKTL-L0/M0/M1/M2/M3/H series): nameplate, PV strings, grid, power, energy and alarms
@source=Huawei, "Solar Inverter Modbus Interface Definitions (V3.0)", Issue 01 (2023-01-17)
@protocol=tcp+rtu
@port=502
@unit_id=1
@byte_order=ABCD
@address_base=0

name,group,area,address,type,length,scale,unit,access,description
